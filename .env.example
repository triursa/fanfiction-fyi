# =============================================================================
# fanfiction.fyi — Environment Variables
# =============================================================================
# Copy this to .env and fill in real values. Never commit secrets.
# For local dev with Wrangler, set secrets via:
#   npx wrangler pages secret put GOOGLE_CLIENT_SECRET
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication — Google OAuth
# These are required for login/signup to work.
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Redirect URI must be set to: https://your-domain/api/auth/google/callback
# -----------------------------------------------------------------------------

# Google OAuth client ID (found in Google Cloud Console → Credentials)
GOOGLE_CLIENT_ID=your-google-client-id-here

# Google OAuth client secret (set via `wrangler pages secret put` in production)
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# -----------------------------------------------------------------------------
# Founder / Admin
# The email address that receives the 'founder' role on first signup.
# Optional — if unset, no user gets 'founder' role automatically.
# -----------------------------------------------------------------------------

FOUNDER_EMAIL=founder@example.com

# -----------------------------------------------------------------------------
# GitHub Integration (optional)
# Used by the bug-report API to create GitHub issues automatically.
# If unset, bug reports are logged but no GitHub issue is created.
# Generate at: https://github.com/settings/tokens (needs `repo` scope)
# -----------------------------------------------------------------------------

GITHUB_TOKEN=your-github-personal-access-token-here

# -----------------------------------------------------------------------------
# API CORS (optional)
# Sets the Access-Control-Allow-Origin header for the read-only API.
# If unset, the request's Origin header is mirrored (safe for same-origin
# but not for credentialed cross-origin requests in production).
# -----------------------------------------------------------------------------

API_ALLOWED_ORIGIN=https://fanfiction.fyi

# =============================================================================
# Cloudflare Bindings (configured in wrangler.toml, NOT .env)
# =============================================================================
# The following are Cloudflare Worker bindings — they are accessed via
# `locals.runtime.env.BINDING_NAME` at runtime, not through process.env.
# Configure them in wrangler.toml or the Cloudflare dashboard.
# =============================================================================

# D1 Database binding — primary database
# Binding name: DB
# wrangler.toml: [[d1_databases]] binding = "DB"
# Local dev: npx wrangler pages dev --d1=DB=./local.db
# Production: create via Cloudflare dashboard and reference in wrangler.toml
#
# DB=...  (set via wrangler.toml, not here)

# R2 Bucket binding — media/file storage
# Binding name: MEDIA
# wrangler.toml: [[r2_buckets]] binding = "MEDIA"
# Local dev: npx wrangler pages dev --r2=MEDIA
# Production: create via Cloudflare dashboard and reference in wrangler.toml
#
# MEDIA=...  (set via wrangler.toml, not here)