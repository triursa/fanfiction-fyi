---
export const prerender = false;
import Base from '@/layouts/Base.astro';
import { getDrizzle } from '@/lib/db';
import { UserRole, ROLE_LEVEL } from '@/lib/types';
import { users, sessions, works, comments, tags } from '@/lib/schema';
import { eq, and, gt, sql, count } from 'drizzle-orm';

// Auth gate: admin+ required
const cookie = Astro.request.headers.get('cookie') ?? '';
const sessionMatch = cookie.match(/session=([a-f0-9]+)/);
if (!sessionMatch) return Astro.redirect('/login');

const d1 = Astro.locals.runtime.env.DB as D1Database;
const db = getDrizzle(d1);
const session = await db.select({ userId: sessions.userId }).from(sessions).where(and(eq(sessions.token, sessionMatch[1]), gt(sessions.expiresAt, sql`datetime('now')`))).get();
if (!session) return Astro.redirect('/login');

const user = await db.select({ id: users.id, email: users.email, role: users.role }).from(users).where(eq(users.id, session.userId)).get();
if (!user) return Astro.redirect('/login');

const userLevel = ROLE_LEVEL[user.role as UserRole] ?? 0;
if (userLevel < ROLE_LEVEL[UserRole.Admin]) return Astro.redirect('/');

// Stats
const [userCountRow] = await db.select({ cnt: count() }).from(users);
const [workCountRow] = await db.select({ cnt: count() }).from(works);
const [commentCountRow] = await db.select({ cnt: count() }).from(comments);
const [tagCountRow] = await db.select({ cnt: count() }).from(tags);
const userCount = userCountRow?.cnt ?? 0;
const workCount = workCountRow?.cnt ?? 0;
const commentCount = commentCountRow?.cnt ?? 0;
const tagCount = tagCountRow?.cnt ?? 0;
---

<Base title="Admin Dashboard">
  <h1 class="admin-heading">Admin Dashboard</h1>

  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-number">{userCount}</span>
      <span class="stat-label">Users</span>
      <a href="/admin/users" class="stat-link">Manage users &rarr;</a>
    </div>
    <div class="stat-card">
      <span class="stat-number">{workCount}</span>
      <span class="stat-label">Works</span>
      <a href="/admin/content" class="stat-link">Moderate content &rarr;</a>
    </div>
    <div class="stat-card">
      <span class="stat-number">{commentCount}</span>
      <span class="stat-label">Comments</span>
      <a href="/admin/content" class="stat-link">Moderate content &rarr;</a>
    </div>
    <div class="stat-card">
      <span class="stat-number">{tagCount}</span>
      <span class="stat-label">Tags</span>
      <a href="/admin/tags" class="stat-link">Manage tags &rarr;</a>
    </div>
  </div>

  <div class="admin-links">
    <a href="/admin/users" class="admin-link-card">
      <h2>User Management</h2>
      <p>View all users, change roles, ban/activate/suspend accounts.</p>
    </a>
    <a href="/admin/content" class="admin-link-card">
      <h2>Content Moderation</h2>
      <p>Review recent comments and works. Delete inappropriate comments.</p>
    </a>
    <a href="/admin/reports" class="admin-link-card">
      <h2>Reports</h2>
      <p>Review content reports from users. Resolve or dismiss reports.</p>
    </a>
    <a href="/admin/tags" class="admin-link-card">
      <h2>Tag Management</h2>
      <p>View all tags, see usage counts, merge duplicate tags.</p>
    </a>
    <a href="/admin/audit" class="admin-link-card">
      <h2>Audit Log</h2>
      <p>Review all admin actions: bans, suspensions, deletions, role changes.</p>
    </a>
  </div>
</Base>

<style>
  .admin-heading {
    font: var(--md-sys-typescale-headline-large);
    color: var(--md-sys-color-on-surface);
    margin-bottom: var(--space-6);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .stat-card {
    background: var(--md-sys-color-surface-container-high);
    border-radius: var(--md-sys-shape-corner-medium);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .stat-number {
    font: var(--md-sys-typescale-headline-large);
    color: var(--md-sys-color-primary);
  }

  .stat-label {
    font: var(--md-sys-typescale-title-medium);
    color: var(--md-sys-color-on-surface);
  }

  .stat-link {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-primary);
    margin-top: var(--space-1);
  }

  .admin-links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .admin-link-card {
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    padding: var(--space-5);
    text-decoration: none;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .admin-link-card:hover {
    background: var(--md-sys-color-surface-container-high);
    text-decoration: none;
  }

  .admin-link-card h2 {
    font: var(--md-sys-typescale-title-large);
    color: var(--md-sys-color-primary);
    margin: 0 0 var(--space-2) 0;
  }

  .admin-link-card p {
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
    margin: 0;
  }
</style>