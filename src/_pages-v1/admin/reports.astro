---
export const prerender = false;
import Base from '@/layouts/Base.astro';
import { getDrizzle } from '@/lib/db';
import { UserRole, ROLE_LEVEL } from '@/lib/types';
import { users, sessions } from '@/lib/schema';
import { eq, and, gt, sql } from 'drizzle-orm';

// Auth gate: mod+ required
const cookie = Astro.request.headers.get('cookie') ?? '';
const sessionMatch = cookie.match(/session=([a-f0-9]+)/);
if (!sessionMatch) return Astro.redirect('/login');

const d1 = Astro.locals.runtime.env.DB as D1Database;
const db = getDrizzle(d1);
const session = await db.select({ userId: sessions.userId }).from(sessions).where(and(eq(sessions.token, sessionMatch[1]), gt(sessions.expiresAt, sql`datetime('now')`))).get();
if (!session) return Astro.redirect('/login');

const currentUser = await db.select({ id: users.id, role: users.role }).from(users).where(eq(users.id, session.userId)).get();
if (!currentUser) return Astro.redirect('/login');

const userLevel = ROLE_LEVEL[currentUser.role as UserRole] ?? 0;
if (userLevel < ROLE_LEVEL[UserRole.Mod]) return Astro.redirect('/');

// Fetch reports via raw D1 for multi-table joins
const { results: reportRows } = await d1.prepare(`
  SELECT cr.id, cr.target_type, cr.target_id, cr.reason, cr.details, cr.status, cr.created_at, cr.resolved_at, cr.resolution,
    u.email as reporter_email, r.email as resolver_email
  FROM content_reports cr
  JOIN users u ON u.id = cr.reporter_id
  LEFT JOIN users r ON r.id = cr.resolver_id
  ORDER BY cr.created_at DESC
  LIMIT 200
`).all<{
  id: number; target_type: string; target_id: number; reason: string; details: string | null;
  status: string; created_at: string; resolved_at: string | null; resolution: string | null;
  reporter_email: string; resolver_email: string | null;
}>();

const allReports = (reportRows ?? []).map(r => ({
  id: r.id,
  targetType: r.target_type,
  targetId: r.target_id,
  reason: r.reason,
  details: r.details,
  status: r.status,
  createdAt: r.created_at,
  resolvedAt: r.resolved_at,
  resolution: r.resolution,
  reporterEmail: r.reporter_email,
  resolverEmail: r.resolver_email,
}));

const statusFilter = Astro.url.searchParams.get('status') || 'open';
const filteredReports = statusFilter === 'all'
  ? allReports
  : allReports.filter(r => r.status === statusFilter);

const reasonLabels: Record<string, string> = {
  harassment: 'Harassment',
  spam: 'Spam',
  copyright: 'Copyright',
  graphic: 'Graphic Content',
  other: 'Other',
};

const statusColors: Record<string, string> = {
  open: '#f59e0b',
  resolved: '#10b981',
  dismissed: '#6b7280',
};
---

<Base title="Reports — Admin">
  <h1 class="admin-heading">Content Reports</h1>

  <nav class="admin-tabs">
    <a href="/admin/reports?status=open" class:active={statusFilter === 'open'}>Open ({allReports.filter(r => r.status === 'open').length})</a>
    <a href="/admin/reports?status=resolved" class:active={statusFilter === 'resolved'}>Resolved ({allReports.filter(r => r.status === 'resolved').length})</a>
    <a href="/admin/reports?status=dismissed" class:active={statusFilter === 'dismissed'}>Dismissed ({allReports.filter(r => r.status === 'dismissed').length})</a>
    <a href="/admin/reports?status=all" class:active={statusFilter === 'all'}>All ({allReports.length})</a>
  </nav>

  <div class="table-wrap">
    {filteredReports.length === 0 ? (
      <p class="empty-state">No {statusFilter === 'all' ? '' : statusFilter} reports.</p>
    ) : (
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Type</th>
            <th>Target</th>
            <th>Reason</th>
            <th>Reporter</th>
            <th>Date</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {filteredReports.map(r => (
            <tr>
              <td>{r.id}</td>
              <td><span class="badge badge-type">{r.targetType}</span></td>
              <td>
                {r.targetType === 'work' ? (
                  <a href={`/works/${r.targetId}`}>Work #{r.targetId}</a>
                ) : (
                  <span>Comment #{r.targetId}</span>
                )}
              </td>
              <td>{reasonLabels[r.reason] ?? r.reason}{r.details ? ` — ${r.details.slice(0, 80)}${r.details.length > 80 ? '…' : ''}` : ''}</td>
              <td class="email-cell">{r.reporterEmail}</td>
              <td class="date-cell">{new Date(r.createdAt.replace(' ', 'T') + 'Z').toLocaleDateString()}</td>
              <td>
                <span class="status-dot" style={`background:${statusColors[r.status] ?? '#6b7280'}`}></span>
                {r.status}
              </td>
              <td>
                {r.status === 'open' && (
                  <div class="action-group">
                    <button
                      class="btn-sm btn-resolve"
                      data-report-id={r.id}
                      data-action="resolve"
                    >Resolve</button>
                    <button
                      class="btn-sm btn-dismiss"
                      data-report-id={r.id}
                      data-action="dismiss"
                    >Dismiss</button>
                  </div>
                )}
                {r.resolverEmail && (
                  <span class="resolver-info">by {r.resolverEmail}</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</Base>

<style is:global>
  .admin-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .admin-tabs a {
    padding: 0.5rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--md-sys-color-on-surface-variant);
    background: var(--md-sys-color-surface-container);
    font-size: 0.875rem;
  }
  .admin-tabs a.active,
  .admin-tabs a:hover {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }
  .badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    text-transform: capitalize;
  }
  .badge-type {
    background: rgba(123, 143, 168, 0.15);
    color: var(--md-sys-color-on-surface);
  }
  .status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 4px;
    vertical-align: middle;
  }
  .action-group {
    display: flex;
    gap: 0.25rem;
  }
  .btn-sm {
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--md-sys-color-outline);
    background: transparent;
    color: var(--md-sys-color-on-surface);
    cursor: pointer;
    font-size: 0.75rem;
  }
  .btn-resolve:hover { background: #10b98120; border-color: #10b981; color: #10b981; }
  .btn-dismiss:hover { background: #f59e0b20; border-color: #f59e0b; color: #f59e0b; }
  .resolver-info { font-size: 0.7rem; color: var(--md-sys-color-on-surface-variant); }
  .email-cell { font-size: 0.8rem; }
  .date-cell { font-size: 0.8rem; white-space: nowrap; }
  .empty-state { color: var(--md-sys-color-on-surface-variant); text-align: center; padding: 2rem; }
</style>

<script>
  document.querySelectorAll('.btn-resolve, .btn-dismiss').forEach(btn => {
    btn.addEventListener('click', async () => {
      const reportId = btn.dataset.reportId;
      const action = btn.dataset.action;
      try {
        const res = await fetch(`/api/admin/reports/${reportId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          const data = await res.json().catch(() => ({}));
          alert(data.error || 'Failed to update report');
        }
      } catch {
        alert('Network error');
      }
    });
  });
</script>