---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { getDrizzle } from '../../lib/db';
import { users, sessions, pseuds as pseudsTable, bookmarks, works } from '../../lib/schema';
import { eq, and, gt, desc, sql } from 'drizzle-orm';

const d1 = Astro.locals.runtime.env.DB as D1Database;
const db = getDrizzle(d1);

// Auth check
const cookie = Astro.request.headers.get('cookie') ?? '';
const sessionMatch = cookie.match(/session=([a-f0-9]+)/);
if (!sessionMatch) return Astro.redirect('/login');

const session = await db.select({ userId: sessions.userId })
  .from(sessions)
  .where(and(eq(sessions.token, sessionMatch[1]), gt(sessions.expiresAt, sql`(datetime('now'))`)))
  .get();
if (!session) return Astro.redirect('/login');

const user = await db.select().from(users).where(eq(users.id, session.userId)).get();
if (!user) return Astro.redirect('/login');

const userPseuds = await db.select({ id: pseudsTable.id, name: pseudsTable.name })
  .from(pseudsTable)
  .where(eq(pseudsTable.userId, user.id))
  .orderBy(pseudsTable.id)
  .all();
const pseudId = userPseuds[0]?.id;

if (!pseudId) {
  // No pseud — shouldn't happen but handle gracefully
  return Astro.redirect('/login');
}

const bookmarkRows = await db.select({
  id: bookmarks.id,
  pseudId: bookmarks.pseudId,
  workId: bookmarks.workId,
  notes: bookmarks.notes,
  private: bookmarks.private,
  createdAt: bookmarks.createdAt,
  title: works.title,
  summary: works.summary,
  wordCount: works.wordCount,
  complete: works.complete,
  workUpdatedAt: works.updatedAt,
})
  .from(bookmarks)
  .innerJoin(works, eq(bookmarks.workId, works.id))
  .where(eq(bookmarks.pseudId, pseudId))
  .orderBy(desc(bookmarks.createdAt))
  .all();

const bookmarks = bookmarkRows.map(b => ({
  ...b,
  // Map camelCase back to snake_case for template compatibility
  work_id: b.workId,
  word_count: b.wordCount,
  work_updated_at: b.workUpdatedAt,
  created_at: b.createdAt,
}));
---

<Base title="Bookmarks — fanfiction.fyi">
  <section class="bookmarks-page">
    <h1 class="page-title">Bookmarks</h1>

    {bookmarks.length === 0 ? (
      <p class="empty-message">You haven't bookmarked any works yet.</p>
    ) : (
      <ul class="bookmark-list">
        {bookmarks.map(bm => (
          <li class="bookmark-card">
            <div class="bookmark-header">
              <a href={`/works/${bm.work_id}`} class="bookmark-title">{bm.title}</a>
              {bm.private ? <span class="badge badge-private">Private</span> : <span class="badge badge-public">Public</span>}
            </div>
            {bm.summary && <p class="bookmark-summary">{bm.summary}</p>}
            {bm.notes && (
              <div class="bookmark-notes">
                <span class="notes-label">Your notes:</span>
                <span>{bm.notes}</span>
              </div>
            )}
            <div class="bookmark-meta">
              <span>{bm.word_count?.toLocaleString()} words</span>
              <span>·</span>
              <span>{bm.work_updated_at ? `Updated ${new Date(bm.work_updated_at).toLocaleDateString()}` : ''}</span>
              <span>·</span>
              <span>Bookmarked {new Date(bm.created_at).toLocaleDateString()}</span>
            </div>
            <div class="bookmark-actions">
              <button class="btn-remove-bookmark" data-work-id={bm.work_id}>Remove Bookmark</button>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style is:global>
  @import '../../styles/theme.css';

  .bookmarks-page {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-title {
    font: var(--md-sys-typescale-headline-large);
    color: var(--md-sys-color-on-surface);
    margin: 0 0 var(--space-6);
  }

  .empty-message {
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-outline);
    font-style: italic;
  }

  .bookmark-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .bookmark-card {
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    padding: var(--space-4);
  }

  .bookmark-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .bookmark-title {
    font: var(--md-sys-typescale-title-large);
    color: var(--md-sys-color-primary);
    text-decoration: none;
  }

  .bookmark-title:hover {
    text-decoration: underline;
  }

  .badge {
    font: var(--md-sys-typescale-label-small);
    padding: 2px var(--space-2);
    border-radius: var(--md-sys-shape-corner-full);
  }

  .badge-private {
    background: var(--md-sys-color-tertiary-container);
    color: var(--md-sys-color-on-tertiary-container);
  }

  .badge-public {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }

  .bookmark-summary {
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
    margin: var(--space-1) 0;
  }

  .bookmark-notes {
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface);
    background: var(--md-sys-color-surface-container-high);
    border-radius: var(--md-sys-shape-corner-small);
    padding: var(--space-2) var(--space-3);
    margin: var(--space-2) 0;
  }

  .notes-label {
    font: var(--md-sys-typescale-label-medium);
    color: var(--md-sys-color-outline);
    margin-right: var(--space-2);
  }

  .bookmark-meta {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-outline);
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-1);
  }

  .bookmark-actions {
    margin-top: var(--space-3);
  }

  .btn-remove-bookmark {
    font: var(--md-sys-typescale-label-medium);
    color: var(--md-sys-color-error);
    background: transparent;
    border: 1px solid var(--md-sys-color-error);
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-1) var(--space-4);
    cursor: pointer;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .btn-remove-bookmark:hover {
    background: var(--md-sys-color-error-container);
    color: var(--md-sys-color-on-error-container);
    border-color: var(--md-sys-color-error-container);
  }
</style>

<script>
  document.querySelectorAll('.btn-remove-bookmark').forEach(btn => {
    btn.addEventListener('click', async () => {
      const workId = (btn as HTMLElement).dataset.workId;
      if (!workId) return;
      try {
        const res = await fetch('/api/bookmarks', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ work_id: Number(workId) }),
        });
        if (res.ok) {
          const card = btn.closest('.bookmark-card');
          if (card) card.remove();
        }
      } catch { /* silently fail */ }
    });
  });
</script>