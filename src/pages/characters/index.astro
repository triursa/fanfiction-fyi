---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { queryAll } from '../../lib/db';

const db = Astro.locals.runtime.env.DB as D1Database;
const initialCharacters = await queryAll<{
  id: number;
  name: string;
  fandom: string | null;
  short_desc: string | null;
  avatar_key: string | null;
  group_id: number | null;
  group_name: string | null;
  work_count: number;
}>(db, `
  SELECT c.id, c.name, c.fandom, c.short_desc, c.avatar_key, c.group_id,
         cg.name as group_name,
         (SELECT COUNT(*) FROM character_appearances ca WHERE ca.character_id = c.id) as work_count
  FROM characters c
  LEFT JOIN character_groups cg ON c.group_id = cg.id
  ORDER BY c.name ASC
  LIMIT 100
`);

// Get unique fandoms for filter
const fandomRows = await queryAll<{ fandom: string }>(db, `
  SELECT DISTINCT fandom FROM characters WHERE fandom IS NOT NULL ORDER BY fandom
`);
const fandoms = fandomRows.map(r => r.fandom);
---

<Base title="Character Library — fanfiction.fyi">
  <div class="characters-page">
    <header class="characters-header">
      <div class="characters-header-row">
        <h1 class="characters-title">Character Library</h1>
        <a href="/characters/new" class="btn-create">+ New Character</a>
      </div>

      <!-- Fandom filter chips -->
      <div class="filter-chips" id="filter-chips" role="tablist" aria-label="Filter by fandom">
        <button class="chip active" data-fandom="" role="tab" aria-selected="true">All</button>
        {fandoms.map(f => (
          <button class="chip" data-fandom={f} role="tab" aria-selected="false">{f}</button>
        ))}
      </div>

      <!-- Search input -->
      <div class="search-bar">
        <label for="char-search" class="sr-only">Search characters</label>
        <input
          type="text"
          id="char-search"
          class="search-input"
          placeholder="Search characters by name…"
          autocomplete="off"
        />
      </div>
    </header>

    <!-- Character grid -->
    <div class="char-grid" id="char-grid">
      {initialCharacters.map(c => (
        <a href={`/characters/${c.id}`} class="char-card" data-fandom={c.fandom || ''}>
          <div class="char-card-avatar">
            {c.avatar_key
              ? <img src={`/storage/${c.avatar_key}`} alt={c.name} />
              : <div class="char-avatar-placeholder">{c.name.charAt(0).toUpperCase()}</div>
            }
          </div>
          <div class="char-card-body">
            <span class="char-card-name">{c.name}</span>
            {c.fandom && <span class="char-card-fandom">{c.fandom}</span>}
            {c.short_desc && <span class="char-card-desc">{c.short_desc}</span>}
            {c.group_name && <span class="char-card-group">↔ {c.group_name}</span>}
          </div>
          <span class="char-card-works">{c.work_count} {c.work_count === 1 ? 'work' : 'works'}</span>
        </a>
      ))}
    </div>

    <div class="char-empty" id="char-empty" style="display:none;">
      <p>No characters found matching your filters.</p>
    </div>
  </div>
</Base>

<style is:global>
  @import '../../styles/theme.css';

  .characters-page {
    padding: var(--space-4) 0;
  }

  .characters-header {
    margin-bottom: var(--space-6);
  }

  .characters-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .characters-title {
    font: var(--md-sys-typescale-headline-large);
    color: var(--md-sys-color-on-surface);
    margin: 0;
  }

  .btn-create {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-primary);
    background: var(--md-sys-color-primary);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--md-sys-shape-corner-full);
    text-decoration: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn-create:hover {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  /* ── Filter Chips ── */
  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .chip {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
    background: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
                color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
                border-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
    user-select: none;
  }

  .chip:hover {
    background: var(--md-sys-color-surface-container-high);
  }

  .chip.active {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    border-color: transparent;
  }

  /* ── Search ── */
  .search-bar {
    max-width: 480px;
  }

  .search-input {
    width: 100%;
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
    background: var(--md-sys-color-surface-container-high);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-medium);
    padding: var(--space-3) var(--space-4);
    outline: none;
    transition: border-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .search-input::placeholder {
    color: var(--md-sys-color-outline);
  }

  .search-input:focus {
    border-color: var(--md-sys-color-primary);
  }

  /* ── Character Grid ── */
  .char-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-3);
  }

  .char-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-medium);
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    color: var(--md-sys-color-on-surface);
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
                box-shadow var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .char-card:hover {
    background: var(--md-sys-color-surface-container-high);
    box-shadow: var(--md-sys-elevation-1);
    text-decoration: none;
  }

  .char-card-avatar {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: var(--md-sys-shape-corner-full);
    overflow: hidden;
  }

  .char-card-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .char-avatar-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    font: var(--md-sys-typescale-headline-small);
  }

  .char-card-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .char-card-name {
    font: var(--md-sys-typescale-body-large);
    font-weight: 600;
    color: var(--md-sys-color-on-surface);
    word-break: break-word;
  }

  .char-card-fandom {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-primary);
  }

  .char-card-desc {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-on-surface-variant);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .char-card-group {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-tertiary);
  }

  .char-card-works {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-outline);
    white-space: nowrap;
    align-self: center;
  }

  /* ── Empty state ── */
  .char-empty {
    text-align: center;
    padding: var(--space-10);
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-outline);
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .char-grid {
      grid-template-columns: 1fr;
    }
    .characters-header-row {
      flex-wrap: wrap;
      gap: var(--space-2);
    }
  }
</style>

<script define:vars={{ initialCharacters, fandoms }}>
  const charGrid = document.getElementById('char-grid');
  const charEmpty = document.getElementById('char-empty');
  const searchInput = document.getElementById('char-search');
  const chips = document.querySelectorAll('#filter-chips .chip');

  let currentFandom = '';
  let currentQ = '';
  let debounceTimer = null;

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function renderCharacters(chars) {
    if (chars.length === 0) {
      charGrid.innerHTML = '';
      charEmpty.style.display = '';
      return;
    }
    charEmpty.style.display = 'none';
    charGrid.innerHTML = chars.map(c => `
      <a href="/characters/${encodeURIComponent(c.id)}" class="char-card" data-fandom="${escapeHtml(c.fandom || '')}">
        <div class="char-card-avatar">
          ${c.avatar_key
            ? `<img src="/storage/${encodeURIComponent(c.avatar_key)}" alt="${escapeHtml(c.name)}" />`
            : `<div class="char-avatar-placeholder">${escapeHtml(c.name.charAt(0).toUpperCase())}</div>`
          }
        </div>
        <div class="char-card-body">
          <span class="char-card-name">${escapeHtml(c.name)}</span>
          ${c.fandom ? `<span class="char-card-fandom">${escapeHtml(c.fandom)}</span>` : ''}
          ${c.short_desc ? `<span class="char-card-desc">${escapeHtml(c.short_desc)}</span>` : ''}
          ${c.group_name ? `<span class="char-card-group">↔ ${escapeHtml(c.group_name)}</span>` : ''}
        </div>
        <span class="char-card-works">${c.work_count} ${c.work_count === 1 ? 'work' : 'works'}</span>
      </a>
    `).join('');
  }

  async function fetchCharacters() {
    const params = new URLSearchParams();
    if (currentFandom) params.set('fandom', currentFandom);
    if (currentQ) params.set('q', currentQ);
    try {
      const res = await fetch('/api/characters?' + params.toString());
      if (res.ok) {
        const data = await res.json();
        renderCharacters(data.characters);
      }
    } catch {
      // silently fail
    }
  }

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      chips.forEach(c => {
        c.classList.remove('active');
        c.setAttribute('aria-selected', 'false');
      });
      chip.classList.add('active');
      chip.setAttribute('aria-selected', 'true');
      currentFandom = chip.dataset.fandom;
      fetchCharacters();
    });
  });

  searchInput.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      currentQ = searchInput.value.trim();
      fetchCharacters();
    }, 300);
  });
</script>