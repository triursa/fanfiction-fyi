---
export const prerender = false;
import { queryFirst, queryAll } from '@/lib/db';
import { UserRole, ROLE_LEVEL } from '@/lib/types';

// Auth gate: admin+ required
const cookie = Astro.request.headers.get('cookie') ?? '';
const sessionMatch = cookie.match(/session=([a-f0-9]+)/);
if (!sessionMatch) return Astro.redirect('/login');

const db = Astro.locals.runtime.env.DB as D1Database;
const session = await queryFirst<{ user_id: number }>(db, `SELECT user_id FROM sessions WHERE token = ?1 AND expires_at > datetime('now')`, sessionMatch[1]);
if (!session) return Astro.redirect('/login');

const currentUser = await queryFirst<{ id: number; email: string; role: string }>(db, `SELECT id, email, role FROM users WHERE id = ?1`, session.user_id);
if (!currentUser) return Astro.redirect('/login');

const userLevel = ROLE_LEVEL[currentUser.role as UserRole] ?? 0;
if (userLevel < ROLE_LEVEL[UserRole.Admin]) return Astro.redirect('/');

const tags = await queryAll<{
  id: number; name: string; type: string; work_count: number;
}>(db, `
  SELECT t.id, t.name, t.type, COUNT(tg.id) as work_count
  FROM tags t
  LEFT JOIN taggings tg ON tg.tag_id = t.id
  GROUP BY t.id
  ORDER BY work_count DESC, t.name ASC
`);
---

<h1 class="admin-heading">Tag Management</h1>

<h2 class="section-heading">All Tags</h2>
<div class="table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Type</th>
        <th>Works</th>
      </tr>
    </thead>
    <tbody>
      {tags.map(t => (
        <tr>
          <td>{t.id}</td>
          <td>{t.name}</td>
          <td><span class={`tag-type tag-type-${t.type}`}>{t.type}</span></td>
          <td>{t.work_count}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<h2 class="section-heading">Merge Tags</h2>
<div class="merge-form">
  <p class="merge-hint">Select a source tag and a target tag. All works tagged with the source will be re-tagged with the target. The source tag will be deleted. Duplicate taggings are skipped.</p>
  <div class="merge-row">
    <div class="merge-field">
      <label for="source-tag">Source (will be deleted)</label>
      <select id="source-tag">
        <option value="">— Select source tag —</option>
        {tags.map(t => (
          <option value={t.id}>{t.name} ({t.type}, {t.work_count} works)</option>
        ))}
      </select>
    </div>
    <div class="merge-field">
      <label for="target-tag">Target (will remain)</label>
      <select id="target-tag">
        <option value="">— Select target tag —</option>
        {tags.map(t => (
          <option value={t.id}>{t.name} ({t.type}, {t.work_count} works)</option>
        ))}
      </select>
    </div>
    <button id="btn-merge" class="btn-merge">Merge</button>
  </div>
</div>

<div id="toast" class="toast hidden"></div>

<script>
  document.getElementById('btn-merge')!.addEventListener('click', async () => {
    const sourceId = (document.getElementById('source-tag') as HTMLSelectElement).value;
    const targetId = (document.getElementById('target-tag') as HTMLSelectElement).value;

    if (!sourceId || !targetId) {
      showToast('Please select both source and target tags', true);
      return;
    }
    if (sourceId === targetId) {
      showToast('Source and target must be different', true);
      return;
    }
    if (!confirm('Are you sure? The source tag will be deleted and all its works will be moved to the target tag.')) return;

    try {
      const res = await fetch('/api/admin/tags/merge', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ source_id: Number(sourceId), target_id: Number(targetId) }),
      });
      const data = await res.json();
      if (!res.ok) {
        showToast(data.error || 'Merge failed', true);
      } else {
        showToast(`Merged! ${data.moved || 0} taggings moved, ${data.deleted || 0} duplicates removed.`);
        setTimeout(() => location.reload(), 1500);
      }
    } catch {
      showToast('Network error', true);
    }
  });

  function showToast(msg: string, isError = false) {
    const toast = document.getElementById('toast')!;
    toast.textContent = msg;
    toast.className = 'toast' + (isError ? ' toast-error' : '') + ' toast-show';
    setTimeout(() => { toast.className = 'toast hidden'; }, 3500);
  }
</script>

<style>
  .admin-heading {
    font: var(--md-sys-typescale-headline-large);
    color: var(--md-sys-color-on-surface);
    margin-bottom: var(--space-6);
  }

  .section-heading {
    font: var(--md-sys-typescale-headline-medium);
    color: var(--md-sys-color-on-surface);
    margin: var(--space-8) 0 var(--space-4) 0;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface);
  }

  .admin-table th {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
    text-align: left;
    padding: var(--space-3) var(--space-4);
    border-bottom: 2px solid var(--md-sys-color-outline-variant);
    white-space: nowrap;
  }

  .admin-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    white-space: nowrap;
  }

  .tag-type {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--md-sys-shape-corner-small);
    font: var(--md-sys-typescale-label-large);
  }

  .tag-type-fandom { background: #2a3e52; color: #c2d6eb; }
  .tag-type-character { background: #354a5e; color: #b8d1e9; }
  .tag-type-relationship { background: #5c2a3e; color: #ebc2d6; }
  .tag-type-freeform { background: #3e522a; color: #d6ebc2; }
  .tag-type-rating { background: #52402a; color: #ebd6c2; }
  .tag-type-warning { background: #522a2a; color: #ebc2c2; }
  .tag-type-category { background: #2a4152; color: #c2d9eb; }

  .merge-form {
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    padding: var(--space-5);
  }

  .merge-hint {
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
    margin: 0 0 var(--space-4) 0;
  }

  .merge-row {
    display: flex;
    gap: var(--space-4);
    align-items: flex-end;
    flex-wrap: wrap;
  }

  .merge-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
    min-width: 200px;
  }

  .merge-field label {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
  }

  .merge-field select {
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface);
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-small);
    padding: var(--space-2) var(--space-3);
    font: var(--md-sys-typescale-body-medium);
  }

  .btn-merge {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    border: none;
    border-radius: var(--md-sys-shape-corner-small);
    padding: var(--space-2) var(--space-5);
    font: var(--md-sys-typescale-label-large);
    cursor: pointer;
    white-space: nowrap;
  }

  .btn-merge:hover {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  .toast {
    position: fixed;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--md-sys-shape-corner-medium);
    background: var(--md-sys-color-surface-container-highest);
    color: var(--md-sys-color-on-surface);
    font: var(--md-sys-typescale-body-medium);
    z-index: 1000;
    transition: opacity 0.3s;
  }

  .toast-error {
    background: var(--md-sys-color-error-container);
    color: var(--md-sys-color-on-error-container);
  }

  .toast-show {
    opacity: 1;
  }

  .hidden {
    opacity: 0;
    pointer-events: none;
  }
</style>