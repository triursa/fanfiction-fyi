---
/**
 * Location Detail Page — Public
 * Shows location name, description, type badge, parent location link, edit/delete for owner.
 */
export const prerender = false;
export const config = { auth: 'public' };
import Base from '@/v2/layouts/Base.astro';

const locationId = Number(Astro.params.id);
if (!locationId || isNaN(locationId)) {
  return Astro.redirect('/canon?tab=locations');
}

let location: any = null;
let errorMsg: string | null = null;

try {
  const res = await fetch(new URL(`/api/canon/locations/${locationId}`, Astro.url));
  if (res.ok) {
    const json = await res.json();
    location = json.data;
  } else if (res.status === 404) {
    return Astro.redirect('/canon?tab=locations');
  } else {
    errorMsg = 'Failed to load location.';
  }
} catch {
  errorMsg = 'Network error loading location.';
}

const user = Astro.locals.user;
const isOwner = user && location && user.id === location.ownerUserId;
---

<Base title={`${location?.name || 'Location'} — fanfiction.fyi`} description={location?.description?.slice(0, 160) || 'View location on fanfiction.fyi'}>
  <section class="location-detail-page">
    {errorMsg && <div class="error-banner" role="alert">{errorMsg}</div>}

    {location && (
      <>
        <a href="/canon?tab=locations" class="back-link">← Canon</a>

        <div class="location-header">
          <div class="location-title-row">
            <h1 class="location-title">{location.name}</h1>
            {location.type && <span class="type-badge">{location.type}</span>}
          </div>

          <div class="location-meta">
            {location.pseudName && (
              <a href={`/pseuds/${location.pseudId}`} class="location-owner">by {location.pseudName}</a>
            )}
            <span class="location-meta-item">
              Created {new Date(location.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </span>
            {location.updatedAt && location.updatedAt !== location.createdAt && (
              <span class="location-meta-item">
                Updated {new Date(location.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </span>
            )}
          </div>

          {location.parentId && (
            <div class="parent-link">
              <span class="meta-label">Parent Location:</span>
              <a href={`/canon/locations/${location.parentId}`} class="parent-link-anchor">
                ↑ {location.parentName || `Location #${location.parentId}`}
              </a>
            </div>
          )}

          {isOwner && (
            <div class="owner-actions">
              <a href={`/canon/locations/${locationId}/edit`} class="btn-outlined">Edit Location</a>
              <button type="button" class="btn-danger" id="delete-btn">Delete Location</button>
            </div>
          )}
        </div>

        <!-- ── Description ────────────────────────────────────────── -->
        {location.description && (
          <div class="location-description">
            <h2 class="section-heading">Description</h2>
            <div class="description-content">{location.description}</div>
          </div>
        )}

        <!-- ── Child Locations ─────────────────────────────────────── -->
        {location.children && location.children.length > 0 && (
          <div class="location-children">
            <h2 class="section-heading">Sub-Locations <span class="count-badge">{location.children.length}</span></h2>
            <div class="children-grid">
              {location.children.map((child: any) => (
                <a href={`/canon/locations/${child.id}`} class="child-card">
                  <span class="child-name">{child.name}</span>
                  {child.type && <span class="child-type">{child.type}</span>}
                </a>
              ))}
            </div>
          </div>
        )}
      </>
    )}
  </section>
</Base>

{isOwner && (
  <script define:vars={{ locationId }}>
    const deleteBtn = document.getElementById('delete-btn');
    if (deleteBtn) {
      deleteBtn.addEventListener('click', async () => {
        if (!confirm('Are you sure you want to delete this location? This cannot be undone.')) return;
        deleteBtn.disabled = true;
        deleteBtn.textContent = 'Deleting…';
        try {
          const res = await fetch(`/api/canon/locations/${locationId}`, { method: 'DELETE' });
          if (res.ok) {
            window.location.href = '/canon?tab=locations';
          } else {
            const data = await res.json();
            alert(data.error || 'Failed to delete location.');
            deleteBtn.disabled = false;
            deleteBtn.textContent = 'Delete Location';
          }
        } catch {
          alert('Network error. Please try again.');
          deleteBtn.disabled = false;
          deleteBtn.textContent = 'Delete Location';
        }
      });
    }
  </script>
)}

<style is:global>
  .location-detail-page {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .back-link {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-primary);
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--space-4);
    transition: opacity var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .back-link:hover { opacity: 0.8; }

  .error-banner {
    background: var(--md-sys-color-error);
    color: var(--md-sys-color-on-error);
    border-radius: var(--md-sys-shape-corner-small);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-6);
    font: var(--md-sys-typescale-body-medium);
  }

  .location-header {
    margin-bottom: var(--space-8);
  }

  .location-title-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .location-title {
    font: var(--md-sys-typescale-headline-medium);
    margin: 0;
  }

  .type-badge {
    font: var(--md-sys-typescale-body-small);
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    border-radius: var(--md-sys-shape-corner-full);
    padding: 2px 10px;
    text-transform: capitalize;
    flex-shrink: 0;
  }

  .location-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-2);
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
  }

  .location-owner {
    color: var(--md-sys-color-primary);
    text-decoration: none;
  }
  .location-owner:hover { text-decoration: underline; }

  .location-meta-item {
    color: var(--md-sys-color-on-surface-variant);
  }

  .parent-link {
    margin-top: var(--space-3);
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font: var(--md-sys-typescale-body-medium);
  }

  .meta-label {
    color: var(--md-sys-color-on-surface-variant);
  }

  .parent-link-anchor {
    color: var(--md-sys-color-primary);
    text-decoration: none;
  }
  .parent-link-anchor:hover { text-decoration: underline; }

  .owner-actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }

  .btn-outlined {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-primary);
    background: transparent;
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-8);
    text-decoration: none;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-outlined:hover { background: var(--md-sys-color-primary-container); }

  .btn-danger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-error);
    background: var(--md-sys-color-error);
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-8);
    cursor: pointer;
    transition: opacity var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-danger:hover { opacity: 0.88; }

  /* ── Description ────────────────────────────────────────── */
  .location-description {
    margin-bottom: var(--space-8);
  }

  .section-heading {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
    margin: 0 0 var(--space-4) 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .count-badge {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    border-radius: var(--md-sys-shape-corner-full);
    padding: 2px 8px;
    font-size: 0.75rem;
  }

  .description-content {
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
    line-height: 1.75;
    white-space: pre-wrap;
    max-width: 48rem;
  }

  /* ── Children ───────────────────────────────────────────── */
  .location-children {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  .children-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .children-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .children-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .child-card {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small);
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    transition: border-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .child-card:hover {
    border-color: var(--md-sys-color-outline);
  }

  .child-name {
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-primary);
  }

  .child-type {
    font: var(--md-sys-typescale-body-small);
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    border-radius: var(--md-sys-shape-corner-full);
    padding: 2px 8px;
    text-transform: capitalize;
    flex-shrink: 0;
  }
</style>