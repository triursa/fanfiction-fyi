---
/**
 * Lore Entry Detail Page — Public
 * Shows lore entry title, content (markdown), category badge, linked work, references.
 * Edit/delete for owner.
 */
export const prerender = false;
export const config = { auth: 'public' };
import Base from '@/v2/layouts/Base.astro';

const loreId = Number(Astro.params.id);
if (!loreId || isNaN(loreId)) {
  return Astro.redirect('/canon');
}

let lore: any = null;
let errorMsg: string | null = null;

try {
  const res = await fetch(new URL(`/api/canon/lore/${loreId}`, Astro.url));
  if (res.ok) {
    const json = await res.json();
    lore = json.data;
  } else if (res.status === 404) {
    return Astro.redirect('/canon');
  } else {
    errorMsg = 'Failed to load lore entry.';
  }
} catch {
  errorMsg = 'Network error loading lore entry.';
}

const user = Astro.locals.user;
const isOwner = user && lore && user.id === lore.ownerUserId;

// Render markdown-like content: convert markdown to basic HTML
// The API may return contentHtml or raw content (markdown)
const loreContent = lore
  ? lore.contentHtml ?? lore.content?.split('\n').map((p: string) => {
      if (!p.trim()) return '';
      // Simple markdown conversion: headers, bold, italic, links, lists
      let html = p
        .replace(/^### (.+)$/, '<h3>$1</h3>')
        .replace(/^## (.+)$/, '<h2>$1</h2>')
        .replace(/^# (.+)$/, '<h1>$1</h1>')
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/\[(.+?)\]\((.+?)\)/g, '<a href="$2">$1</a>')
        .replace(/^- (.+)$/, '<li>$1</li>');
      if (html.startsWith('<li>')) return '<ul>' + html + '</ul>';
      if (!html.startsWith('<h')) return '<p>' + html + '</p>';
      return html;
    }).join('\n') ?? '<p><em>No content.</em></p>'
  : '';
---

<Base title={`${lore?.title || 'Lore'} — fanfiction.fyi`} description={lore?.content?.slice(0, 160) || 'View lore entry on fanfiction.fyi'}>
  <section class="lore-detail-page">
    {errorMsg && <div class="error-banner" role="alert">{errorMsg}</div>}

    {lore && (
      <>
        <a href="/canon?tab=lore" class="back-link">← Canon</a>

        <div class="lore-header">
          <div class="lore-title-row">
            <h1 class="lore-title">{lore.title}</h1>
            {lore.category && <span class="category-badge">{lore.category}</span>}
          </div>

          <div class="lore-meta">
            {lore.pseudName && (
              <a href={`/pseuds/${lore.pseudId}`} class="lore-owner">by {lore.pseudName}</a>
            )}
            <span class="lore-meta-item">
              Created {new Date(lore.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </span>
            {lore.updatedAt && lore.updatedAt !== lore.createdAt && (
              <span class="lore-meta-item">
                Updated {new Date(lore.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </span>
            )}
          </div>

          {lore.workId && (
            <div class="lore-work-link">
              <span class="meta-label">Linked Work:</span>
              <a href={`/works/${lore.workId}`} class="work-link">{lore.workTitle || `Work #${lore.workId}`}</a>
            </div>
          )}

          {isOwner && (
            <div class="owner-actions">
              <a href={`/canon/lore/${loreId}/edit`} class="btn-outlined">Edit Entry</a>
              <button type="button" class="btn-danger" id="delete-btn">Delete Entry</button>
            </div>
          )}
        </div>

        <!-- ── Content ────────────────────────────────────────────── -->
        <article class="lore-content" set:html={loreContent} />

        <!-- ── References ──────────────────────────────────────────── -->
        {lore.references && lore.references.length > 0 && (
          <div class="lore-references">
            <h2 class="section-heading">References <span class="count-badge">{lore.references.length}</span></h2>
            <div class="references-list">
              {lore.references.map((ref: any) => (
                <div class="reference-item">
                  <a href={ref.url || '#'} class="reference-link">{ref.title || ref.url || 'Reference'}</a>
                  {ref.description && <p class="reference-desc">{ref.description}</p>}
                </div>
              ))}
            </div>
          </div>
        )}
      </>
    )}
  </section>
</Base>

{isOwner && (
  <script define:vars={{ loreId }}>
    const deleteBtn = document.getElementById('delete-btn');
    if (deleteBtn) {
      deleteBtn.addEventListener('click', async () => {
        if (!confirm('Are you sure you want to delete this lore entry? This cannot be undone.')) return;
        deleteBtn.disabled = true;
        deleteBtn.textContent = 'Deleting…';
        try {
          const res = await fetch(`/api/canon/lore/${loreId}`, { method: 'DELETE' });
          if (res.ok) {
            window.location.href = '/canon?tab=lore';
          } else {
            const data = await res.json();
            alert(data.error || 'Failed to delete lore entry.');
            deleteBtn.disabled = false;
            deleteBtn.textContent = 'Delete Entry';
          }
        } catch {
          alert('Network error. Please try again.');
          deleteBtn.disabled = false;
          deleteBtn.textContent = 'Delete Entry';
        }
      });
    }
  </script>
)}

<style is:global>
  .lore-detail-page {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .back-link {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-primary);
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--space-4);
    transition: opacity var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .back-link:hover { opacity: 0.8; }

  .error-banner {
    background: var(--md-sys-color-error);
    color: var(--md-sys-color-on-error);
    border-radius: var(--md-sys-shape-corner-small);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-6);
    font: var(--md-sys-typescale-body-medium);
  }

  .lore-header {
    margin-bottom: var(--space-8);
  }

  .lore-title-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .lore-title {
    font: var(--md-sys-typescale-headline-medium);
    margin: 0;
  }

  .category-badge {
    font: var(--md-sys-typescale-body-small);
    background: var(--md-sys-color-tertiary-container);
    color: var(--md-sys-color-on-tertiary-container);
    border-radius: var(--md-sys-shape-corner-full);
    padding: 2px 10px;
    text-transform: capitalize;
    flex-shrink: 0;
  }

  .lore-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-2);
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
  }

  .lore-owner {
    color: var(--md-sys-color-primary);
    text-decoration: none;
  }
  .lore-owner:hover { text-decoration: underline; }

  .lore-meta-item {
    color: var(--md-sys-color-on-surface-variant);
  }

  .lore-work-link {
    margin-top: var(--space-3);
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font: var(--md-sys-typescale-body-medium);
  }

  .meta-label {
    color: var(--md-sys-color-on-surface-variant);
  }

  .work-link {
    color: var(--md-sys-color-primary);
    text-decoration: none;
  }
  .work-link:hover { text-decoration: underline; }

  .owner-actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }

  .btn-outlined {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-primary);
    background: transparent;
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-8);
    text-decoration: none;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-outlined:hover { background: var(--md-sys-color-primary-container); }

  .btn-danger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-error);
    background: var(--md-sys-color-error);
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-8);
    cursor: pointer;
    transition: opacity var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-danger:hover { opacity: 0.88; }

  /* ── Content ────────────────────────────────────────────── */
  .lore-content {
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
    line-height: 1.75;
    max-width: 48rem;
  }

  .lore-content h1 {
    font: var(--md-sys-typescale-headline-small);
    margin: var(--space-6) 0 var(--space-3) 0;
  }
  .lore-content h2 {
    font: var(--md-sys-typescale-title-large);
    margin: var(--space-6) 0 var(--space-2) 0;
  }
  .lore-content h3 {
    font: var(--md-sys-typescale-title-medium);
    margin: var(--space-4) 0 var(--space-2) 0;
  }
  .lore-content p {
    margin: var(--space-2) 0;
  }
  .lore-content ul {
    margin: var(--space-2) 0 var(--space-2) var(--space-6);
    padding-left: var(--space-4);
  }
  .lore-content li {
    margin: var(--space-1) 0;
  }
  .lore-content a {
    color: var(--md-sys-color-primary);
  }
  .lore-content strong {
    font-weight: 600;
  }
  .lore-content em {
    font-style: italic;
  }

  /* ── References ──────────────────────────────────────────── */
  .lore-references {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  .section-heading {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
    margin: 0 0 var(--space-4) 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .count-badge {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    border-radius: var(--md-sys-shape-corner-full);
    padding: 2px 8px;
    font-size: 0.75rem;
  }

  .references-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .reference-item {
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small);
    padding: var(--space-3) var(--space-4);
  }

  .reference-link {
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-primary);
    text-decoration: none;
  }
  .reference-link:hover { text-decoration: underline; }

  .reference-desc {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-on-surface-variant);
    margin: var(--space-1) 0 0 0;
  }
</style>