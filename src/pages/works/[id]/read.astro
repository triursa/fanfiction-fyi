---
export const prerender = false;
import { queryFirst, queryAll } from '../../../lib/db';
import { markdownToHtml } from '../../../lib/markdown';
import { THEMES } from '../../../styles/themes';
import ReadingMode from '../../../components/ReadingMode';
import TagCluster from '../../../components/TagCluster.tsx';

const workId = Number(Astro.params.id);
if (!workId) return Astro.redirect('/works');

const chapterParam = Astro.url.searchParams.get('chapter');

const db = Astro.locals.runtime.env.DB as D1Database;

const work = await queryFirst<any>(db, `SELECT * FROM works WHERE id = ?1 AND draft = 0`, workId);
if (!work) return Astro.redirect('/works');

// Check auth for reading progress
let authUser = null;
let userPseudId: number | null = null;
let readingProgress: any = null;
const cookie = Astro.request.headers.get('cookie') ?? '';
const sessionMatch = cookie.match(/session=([a-f0-9]+)/);
if (sessionMatch) {
  const session = await queryFirst<any>(db, `SELECT user_id FROM sessions WHERE token = ?1 AND expires_at > datetime('now')`, sessionMatch[1]);
  if (session) {
    authUser = await queryFirst<any>(db, `SELECT id, theme, reading_font_size, mood_disabled FROM users WHERE id = ?1`, session.user_id);
    if (authUser) {
      const userPseud = await queryFirst<any>(db, `SELECT id FROM pseuds WHERE user_id = ?1 ORDER BY id LIMIT 1`, authUser.id);
      userPseudId = userPseud?.id ?? null;
    }
  }
}

if (userPseudId) {
  readingProgress = await queryFirst<any>(db, `SELECT * FROM readings WHERE pseud_id = ?1 AND work_id = ?2`, userPseudId, workId);
}

// Get all published chapters
const chapters = await queryAll<any>(db, `SELECT id, position, title, draft, word_count FROM chapters WHERE work_id = ?1 AND draft = 0 ORDER BY position`, workId);
if (!chapters.length) return Astro.redirect('/works');

// Current chapter
const chapterId = chapterParam ? Number(chapterParam) : (readingProgress?.last_chapter || chapters[0].id);
const currentChapter = chapters.find((c: any) => c.id === chapterId) || chapters[0];
const currentChapterData = await queryFirst<any>(db, `SELECT * FROM chapters WHERE id = ?1`, currentChapter.id);

// Previous/next chapters
const currentIndex = chapters.findIndex((c: any) => c.id === currentChapter.id);
const prevChapter = currentIndex > 0 ? chapters[currentIndex - 1] : null;
const nextChapter = currentIndex < chapters.length - 1 ? chapters[currentIndex + 1] : null;

// Total word count for reading time
const totalWords = chapters.reduce((sum: number, c: any) => sum + (c.word_count || 0), 0);
const readingTimeMinutes = Math.max(1, Math.ceil(totalWords / 230)); // 230 wpm average

// Tags for context
const tags = await queryAll<any>(db, `SELECT t.* FROM tags t JOIN taggings tg ON t.id = tg.tag_id WHERE tg.work_id = ?1`, workId);
const pseuds = await queryAll<any>(db, `SELECT p.name, p.icon_key FROM pseuds p JOIN creatorships c ON p.id = c.pseud_id WHERE c.work_id = ?1`, workId);

// Chapter reactions for current chapter
let reactionRows: any[] = [];
let myReactions: string[] = [];
if (currentChapter.id) {
  reactionRows = await queryAll<{ reaction: string; cnt: number }>(db, `SELECT reaction, COUNT(*) as cnt FROM chapter_reactions WHERE chapter_id = ?1 GROUP BY reaction`, currentChapter.id);
  if (userPseudId) {
    const myRows = await queryAll<{ reaction: string }>(db, `SELECT reaction FROM chapter_reactions WHERE chapter_id = ?1 AND pseud_id = ?2`, currentChapter.id, userPseudId);
    myReactions = myRows.map(r => r.reaction);
  }
}

const reactionCounts: Record<string, number> = {};
for (const row of reactionRows) {
  reactionCounts[row.reaction] = row.cnt;
}

// Author display
const authorNames = pseuds.map((p: any) => p.name).join(', ');

// User font size preference
const fontSizeClass = authUser?.reading_font_size || 'default';

// Mood engine — map chapter mood to CSS custom properties
const moodDisabled = authUser?.mood_disabled || false;
const currentMood = currentChapterData?.mood || null;

const MOOD_PALETTES: Record<string, Record<string, string>> = {
  cozy:       { '--mood-surface': '#1a1714', '--mood-accent': '#d4a574', '--mood-glow': 'rgba(212,165,116,0.06)' },
  tense:      { '--mood-surface': '#14161a', '--mood-accent': '#8fa8bf', '--mood-glow': 'rgba(143,168,191,0.05)' },
  melancholy:  { '--mood-surface': '#141417', '--mood-accent': '#8b7ea0', '--mood-glow': 'rgba(139,126,160,0.06)' },
  triumphant:  { '--mood-surface': '#181614', '--mood-accent': '#c9a84c', '--mood-glow': 'rgba(201,168,76,0.07)' },
  romantic:    { '--mood-surface': '#191416', '--mood-accent': '#c47a8a', '--mood-glow': 'rgba(196,122,138,0.06)' },
  horror:     { '--mood-surface': '#110e0e', '--mood-accent': '#8b3a3a', '--mood-glow': 'rgba(139,58,58,0.06)' },
  flashback:   { '--mood-surface': '#1a1814', '--mood-accent': '#a89570', '--mood-glow': 'rgba(168,149,112,0.06)' },
  action:      { '--mood-surface': '#161414', '--mood-accent': '#b87333', '--mood-glow': 'rgba(184,115,51,0.07)' },
};

const moodCSS = (!moodDisabled && currentMood && MOOD_PALETTES[currentMood])
  ? Object.entries(MOOD_PALETTES[currentMood]).map(([k, v]) => `${k}: ${v};`).join('\n  ')
  : '';
---

<!doctype html>
<html lang="en" data-reading-mode>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={`${work.title} by ${authorNames} — fanfiction.fyi`} />
  <meta property="og:title" content={work.title} />
  <meta property="og:description" content={work.summary || `${totalWords.toLocaleString()} words · ${chapters.length} chapter${chapters.length !== 1 ? 's' : ''}`} />
  <meta property="og:url" content={`https://fanfiction.fyi/works/${work.id}/read`} />
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="fanfiction.fyi" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Georgia&display=swap" rel="stylesheet" />
  <title>{work.title} — Reading Mode</title>

  <!-- Theme from localStorage for instant paint -->
  <script is:inline>
  (function() {
    try {
      var stored = localStorage.getItem('ff-theme');
      if (stored) document.documentElement.setAttribute('data-theme', stored);
    } catch(e) {}
  })();
  </script>

  <!-- Serialized theme colors for client-side -->
  <script type="application/json" id="ff-themes-data" set:html={JSON.stringify(Object.fromEntries(Object.entries(THEMES).map(([k, v]) => [k, v.colors])))} />

  <style is:global>
    @import '../../../styles/theme.css';
    @import '../../../styles/composer.css';

    /* ── Reading Mode Overrides ── */
    html[data-reading-mode] body {
      max-width: none;
      background: var(--md-sys-color-surface);
    }

    /* ── Top Progress Bar ── */
    .reading-progress-bar {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      background: var(--md-sys-color-primary);
      z-index: 1000;
      transition: width 0.1s linear;
      border-radius: 0 2px 2px 0;
    }

    /* ── Ambient Header ── */
    .reading-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 900;
      background: linear-gradient(to bottom, var(--md-sys-color-surface) 60%, transparent);
      transform: translateY(-100%);
      transition: transform 0.3s ease;
      padding: var(--space-3) var(--space-6);
      display: flex;
      align-items: center;
      gap: var(--space-4);
    }
    .reading-header.visible { transform: translateY(0); }
    .reading-header-title {
      font: var(--md-sys-typescale-title-medium);
      color: var(--md-sys-color-on-surface);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      flex: 1;
    }
    .reading-header-chapter {
      font: var(--md-sys-typescale-body-small);
      color: var(--md-sys-color-on-surface-variant);
      white-space: nowrap;
    }
    .reading-header-exit {
      font: var(--md-sys-typescale-label-large);
      color: var(--md-sys-color-primary);
      background: var(--md-sys-color-primary-container);
      border: none;
      border-radius: var(--md-sys-shape-corner-full);
      padding: var(--space-2) var(--space-4);
      cursor: pointer;
      white-space: nowrap;
    }

    /* ── Reading Container ── */
    .reading-container {
      max-width: 72ch;
      margin: 0 auto;
      padding: var(--space-16) var(--space-6) var(--space-10);
    }
    .reading-container[data-font-size="small"] { font-size: 0.9375rem; }
    .reading-container[data-font-size="default"] { font-size: 1rem; }
    .reading-container[data-font-size="large"] { font-size: 1.125rem; }
    .reading-container[data-font-size="x-large"] { font-size: 1.25rem; }

    /* ── Work Metadata (minimal, top) ── */
    .reading-work-meta {
      margin-bottom: var(--space-10);
      padding-bottom: var(--space-6);
      border-bottom: 1px solid var(--md-sys-color-outline-variant);
    }
    .reading-work-title {
      font: 500 2.25rem/2.75rem 'Lora', 'Georgia', serif;
      color: var(--md-sys-color-on-surface);
      margin: 0 0 var(--space-2);
      letter-spacing: -0.01em;
    }
    .reading-work-author {
      font: var(--md-sys-typescale-title-medium);
      color: var(--md-sys-color-on-surface-variant);
      margin: 0 0 var(--space-3);
    }
    .reading-work-author a { color: var(--md-sys-color-primary); text-decoration: none; }
    .reading-work-author a:hover { text-decoration: underline; }
    .reading-work-stats {
      font: var(--md-sys-typescale-body-small);
      color: var(--md-sys-color-outline);
      display: flex;
      gap: var(--space-2);
      flex-wrap: wrap;
    }
    .reading-time-badge {
      background: var(--md-sys-color-secondary-container);
      color: var(--md-sys-color-on-secondary-container);
      padding: 2px var(--space-3);
      border-radius: var(--md-sys-shape-corner-full);
      font: var(--md-sys-typescale-label-medium);
    }
    /* ── Tags (now handled by TagCluster + composer.css) ── */

    /* ── Chapter Content ── */
    .reading-chapter {
      margin-bottom: var(--space-12);
    }
    .reading-chapter-header {
      margin-bottom: var(--space-8);
    }
    .reading-chapter-number {
      font: var(--md-sys-typescale-label-large);
      color: var(--md-sys-color-primary);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin: 0 0 var(--space-1);
    }
    .reading-chapter-title {
      font: 500 1.75rem/2.25rem 'Lora', 'Georgia', serif;
      color: var(--md-sys-color-on-surface);
      margin: 0 0 var(--space-2);
    }
    .reading-chapter-meta {
      font: var(--md-sys-typescale-body-small);
      color: var(--md-sys-color-outline);
    }

    /* Mood badge in chapter header */
    .mood-badge {
      font: var(--md-sys-typescale-label-medium);
      background: var(--mood-accent, var(--md-sys-color-secondary-container));
      color: var(--md-sys-color-on-secondary-container);
      padding: 2px var(--space-3);
      border-radius: var(--md-sys-shape-corner-full);
      margin-left: var(--space-2);
      text-transform: capitalize;
    }

    /* ── Prose Content (reading-optimized) ── */
    .reading-prose {
      font-family: 'Lora', 'Georgia', serif;
      line-height: 1.85;
      color: var(--md-sys-color-on-surface);
      letter-spacing: 0.01em;
    }
    .reading-prose p {
      margin: 0 0 1.25em;
      text-indent: 0;
    }
    .reading-prose p + p {
      text-indent: 1.5em;
    }
    .reading-prose h2, .reading-prose h3 {
      font-family: 'Inter', sans-serif;
      font-weight: 500;
      color: var(--md-sys-color-on-surface);
      margin: 2em 0 0.75em;
      text-indent: 0;
    }
    .reading-prose hr {
      border: none;
      text-align: center;
      margin: 2em 0;
      overflow: visible;
      letter-spacing: 0.5em;
      color: var(--md-sys-color-outline-variant);
      font-size: 1.25rem;
    }
    .reading-prose hr::before { content: '✦ ✦ ✦'; }
    .reading-prose blockquote {
      border-left: 3px solid var(--md-sys-color-primary);
      padding-left: 1.25em;
      margin: 1.5em 0;
      color: var(--md-sys-color-on-surface-variant);
      font-style: italic;
      text-indent: 0;
    }
    .reading-prose em { font-style: italic; }
    .reading-prose strong { font-weight: 600; }
    .reading-prose a {
      color: var(--md-sys-color-primary);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .reading-prose a:hover { color: var(--md-sys-color-on-primary); background: var(--md-sys-color-primary); border-radius: 2px; }
    .reading-prose img.chapter-image, .reading-prose img {
      max-width: 100%;
      height: auto;
      border-radius: var(--md-sys-shape-corner-medium);
      margin: var(--space-4) auto;
      display: block;
    }
    .reading-prose figure { margin: var(--space-4) 0; text-align: center; text-indent: 0; }
    .reading-prose figcaption { font: var(--md-sys-typescale-body-small); color: var(--md-sys-color-on-surface-variant); margin-top: var(--space-1); }

    /* ── Chapter Reactions (ambient, inline) ── */
    .reading-reactions {
      margin: var(--space-8) 0;
      padding: var(--space-4) 0;
      border-top: 1px solid var(--md-sys-color-outline-variant);
      border-bottom: 1px solid var(--md-sys-color-outline-variant);
      display: flex;
      align-items: center;
      gap: var(--space-3);
      flex-wrap: wrap;
    }
    .reading-reactions-label {
      font: var(--md-sys-typescale-label-medium);
      color: var(--md-sys-color-on-surface-variant);
    }

    /* ── Chapter Navigation ── */
    .reading-chapter-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: var(--space-8) 0;
      border-bottom: 1px solid var(--md-sys-color-outline-variant);
    }
    .reading-nav-link {
      font: var(--md-sys-typescale-label-large);
      color: var(--md-sys-color-primary);
      background: var(--md-sys-color-primary-container);
      border: none;
      border-radius: var(--md-sys-shape-corner-full);
      padding: var(--space-3) var(--space-6);
      cursor: pointer;
      text-decoration: none;
      transition: opacity 0.2s;
    }
    .reading-nav-link:hover { opacity: 0.85; }
    .reading-nav-link.disabled {
      opacity: 0.4;
      pointer-events: none;
    }
    .reading-nav-center {
      font: var(--md-sys-typescale-body-small);
      color: var(--md-sys-color-outline);
    }

    /* ── Chapter List (collapsible) ── */
    .reading-chapters-drawer {
      position: fixed;
      right: 0;
      top: 0;
      bottom: 0;
      width: 320px;
      max-width: 85vw;
      background: var(--md-sys-color-surface-container);
      transform: translateX(100%);
      transition: transform 0.3s ease;
      z-index: 950;
      overflow-y: auto;
      padding: var(--space-6);
      box-shadow: -4px 0 24px rgba(0,0,0,0.3);
    }
    .reading-chapters-drawer.open { transform: translateX(0); }
    .reading-drawer-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 940;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
    }
    .reading-drawer-overlay.open { opacity: 1; pointer-events: auto; }
    .reading-drawer-title {
      font: var(--md-sys-typescale-title-medium);
      color: var(--md-sys-color-on-surface);
      margin: 0 0 var(--space-4);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .reading-drawer-close {
      background: none;
      border: none;
      color: var(--md-sys-color-on-surface-variant);
      cursor: pointer;
      font-size: 1.25rem;
      padding: var(--space-1);
      line-height: 1;
    }
    .reading-drawer-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .reading-drawer-item a {
      display: block;
      padding: var(--space-2) var(--space-3);
      color: var(--md-sys-color-on-surface-variant);
      text-decoration: none;
      border-radius: var(--md-sys-shape-corner-small);
      font: var(--md-sys-typescale-body-large);
      transition: background 0.15s;
    }
    .reading-drawer-item a:hover { background: var(--md-sys-color-surface-container-high); }
    .reading-drawer-item.current a {
      color: var(--md-sys-color-primary);
      background: var(--md-sys-color-primary-container);
      font-weight: 500;
    }
    .reading-drawer-item .chapter-words {
      font: var(--md-sys-typescale-body-small);
      color: var(--md-sys-color-outline);
    }

    /* ── Bottom Toolbar ── */
    .reading-toolbar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 900;
      background: linear-gradient(to top, var(--md-sys-color-surface) 70%, transparent);
      padding: var(--space-4) var(--space-6);
      display: flex;
      justify-content: center;
      gap: var(--space-3);
      transform: translateY(100%);
      transition: transform 0.3s ease;
    }
    .reading-toolbar.visible { transform: translateY(0); }
    .reading-toolbar-btn {
      font: var(--md-sys-typescale-label-large);
      color: var(--md-sys-color-on-surface);
      background: var(--md-sys-color-surface-container-high);
      border: 1px solid var(--md-sys-color-outline-variant);
      border-radius: var(--md-sys-shape-corner-full);
      padding: var(--space-2) var(--space-4);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: var(--space-2);
      text-decoration: none;
    }
    .reading-toolbar-btn:hover {
      background: var(--md-sys-color-surface-container-highest);
      border-color: var(--md-sys-color-outline);
    }

    /* ── Keyboard Shortcuts Hint ── */
    .reading-shortcuts {
      position: fixed;
      bottom: var(--space-16);
      right: var(--space-4);
      z-index: 800;
      font: var(--md-sys-typescale-body-small);
      color: var(--md-sys-color-outline);
      opacity: 0;
      transition: opacity 0.5s;
      pointer-events: none;
      text-align: right;
    }
    .reading-shortcuts.visible { opacity: 0.6; }
    kbd {
      background: var(--md-sys-color-surface-container-high);
      border: 1px solid var(--md-sys-color-outline-variant);
      border-radius: 3px;
      padding: 1px 5px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.8em;
    }

    /* ── End Notes ── */
    .reading-end-notes {
      background: var(--md-sys-color-surface-container);
      border-radius: var(--md-sys-shape-corner-medium);
      padding: var(--space-4) var(--space-6);
      margin: var(--space-8) 0;
      font-family: 'Inter', sans-serif;
    }
    .reading-end-notes h3 {
      font: var(--md-sys-typescale-title-medium);
      margin: 0 0 var(--space-2);
    }

    /* ── Footer ── */
    .reading-footer {
      margin-top: var(--space-12);
      padding-top: var(--space-6);
      border-top: 1px solid var(--md-sys-color-outline-variant);
      text-align: center;
    }
    .reading-footer-back {
      font: var(--md-sys-typescale-label-large);
      color: var(--md-sys-color-primary);
      background: var(--md-sys-color-primary-container);
      border: none;
      border-radius: var(--md-sys-shape-corner-full);
      padding: var(--space-3) var(--space-6);
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      margin-bottom: var(--space-4);
    }
    .reading-footer-meta {
      font: var(--md-sys-typescale-body-small);
      color: var(--md-sys-color-outline);
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      .reading-container { padding: var(--space-8) var(--space-4) var(--space-10); }
      .reading-work-title { font-size: 1.75rem; line-height: 2.125rem; }
      .reading-chapter-title { font-size: 1.5rem; line-height: 2rem; }
    }

    /* ── Reduced Motion ── */
    @media (prefers-reduced-motion: reduce) {
      .reading-progress-bar, .reading-header, .reading-toolbar, .reading-chapters-drawer {
        transition: none !important;
      }
    }

    /* ── Mood Engine — Ambient Atmosphere ── */
    /* Mood CSS vars are injected via <style> tag from server-side MOOD_PALETTES */
    /* This section wires those vars to the visual elements */

    .reading-container[data-mood]:not([data-mood="none"]):not([data-mood="off"]) {
      background: var(--mood-surface, var(--md-sys-color-surface));
      transition: background 2s ease, color 2s ease;
    }
    .reading-container[data-mood]:not([data-mood="none"]):not([data-mood="off"]) .reading-prose {
      transition: color 2s ease;
    }
    .reading-container[data-mood]:not([data-mood="none"]):not([data-mood="off"]) .reading-chapter-title {
      transition: color 2s ease;
    }
    .reading-container[data-mood]:not([data-mood="none"]):not([data-mood="off"]) .reading-chapter-number {
      color: var(--mood-accent, var(--md-sys-color-primary));
    }
    .reading-progress-bar[data-mood]:not([data-mood="none"]):not([data-mood="off"]) {
      background: var(--mood-accent, var(--md-sys-color-primary));
    }
    /* Subtle ambient glow overlay at the top of the chapter */
    .mood-glow {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 40vh;
      pointer-events: none;
      z-index: -1;
      background: var(--mood-glow, transparent);
      opacity: 0;
      transition: opacity 2s ease;
    }
    .mood-glow.active { opacity: 1; }
  </style>
</head>
<body data-theme={authUser?.theme || 'obsidian'} data-mood={moodDisabled ? 'off' : currentMood || 'none'}>
  {moodCSS && <style>{`:root { ${moodCSS} }`}</style>}

  <!-- Main Reading Area -->
  <main class="reading-container" data-font-size={fontSizeClass} data-mood={moodDisabled ? 'off' : currentMood || 'none'}>
    <!-- Work Metadata -->
    <div class="reading-work-meta">
      <h1 class="reading-work-title">{work.title}</h1>
      <p class="reading-work-author">
        By {pseuds.map((p: any, i: number) => (
          <Fragment>
            {i > 0 ? ', ' : ''}
            <a href={`/pseuds/${p.id}`}>{p.name}</a>
          </Fragment>
        ))}
      </p>
      <div class="reading-work-stats">
        <span>{totalWords.toLocaleString()} words</span>
        <span>·</span>
        <span>{chapters.length} chapter{chapters.length !== 1 ? 's' : ''}</span>
        <span>·</span>
        <span class="reading-time-badge">📖 ~{readingTimeMinutes} min read</span>
        <span>·</span>
        <span>{work.complete ? 'Complete' : 'In Progress'}</span>
      </div>
      {tags.length > 0 && (
        <TagCluster client:load tags={tags.map((t: any) => ({ id: t.id, name: t.name, type: t.type }))} heading="" compact={true} />
      )}
    </div>

    <!-- Notes (if first chapter) -->
    {work.notes && currentChapter.id === chapters[0].id && (
      <div class="reading-end-notes">
        <h3>Author's Notes</h3>
        <div set:html={markdownToHtml(work.notes)} />
      </div>
    )}

    <!-- Chapter Content -->
    <section class="reading-chapter">
      <div class="reading-chapter-header">
        {chapters.length > 1 && <div class="reading-chapter-number">Chapter {currentChapter.position}</div>}
        <h2 class="reading-chapter-title">{currentChapter.title}</h2>
        <div class="reading-chapter-meta">
          {currentChapter.word_count?.toLocaleString() || '?'} words · ~{Math.max(1, Math.ceil((currentChapter.word_count || 0) / 230))} min
          {currentMood && !moodDisabled && <span class="mood-badge" data-mood={currentMood}>{currentMood}</span>}
        </div>
      </div>

      <div class="reading-prose">
        {currentChapterData.content_html && <div set:html={currentChapterData.content_html} />}
        {!currentChapterData.content_html && currentChapterData.content_md && <div set:html={markdownToHtml(currentChapterData.content_md)} />}
        {!currentChapterData.content_html && !currentChapterData.content_md && <p>No content available for this chapter.</p>}
      </div>

      <!-- Chapter Reactions (handled by ReadingMode island below) -->
      <ReadingMode client:load
        workId={workId}
        chapters={chapters}
        currentChapterId={currentChapter.id}
        currentChapterPosition={currentChapter.position}
        authed={!!authUser}
        moodCSS={moodCSS}
        currentMood={currentMood || ''}
        moodDisabled={moodDisabled}
        reactionCounts={reactionCounts}
        myReactions={myReactions}
        fontSize={fontSizeClass}
        workTitle={work.title}
      />
    </section>

    <!-- End Notes (last chapter) -->
    {work.end_notes && currentChapter.id === chapters[chapters.length - 1].id && (
      <div class="reading-end-notes">
        <h3>End Notes</h3>
        <div set:html={markdownToHtml(work.end_notes)} />
      </div>
    )}

    <!-- Chapter Navigation -->
    <nav class="reading-chapter-nav">
      {prevChapter
        ? <a href={`/works/${work.id}/read?chapter=${prevChapter.id}`} class="reading-nav-link">← Previous</a>
        : <span></span>
      }
      <div class="reading-nav-center">{currentChapter.position} / {chapters.length}</div>
      {nextChapter
        ? <a href={`/works/${work.id}/read?chapter=${nextChapter.id}`} class="reading-nav-link">Next →</a>
        : <span></span>
      }
    </nav>

    <!-- Footer -->
    <div class="reading-footer">
      <a href={`/works/${work.id}`} class="reading-footer-back">← Back to Full Work Page</a>
      <div class="reading-footer-meta">
        {work.title} · {totalWords.toLocaleString()} words · {authorNames}
      </div>
    </div>
  </main>
</body>
</html>