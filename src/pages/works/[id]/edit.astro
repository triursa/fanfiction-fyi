---
export const prerender = false;
import Base from '../../../layouts/Base.astro';
import { queryFirst, queryAll } from '../../../lib/db';
import { getAuth } from '../../../lib/auth';

const workId = Number(Astro.params.id);
if (!workId) return Astro.redirect('/works');

const db = Astro.locals.runtime.env.DB as D1Database;

const work = await queryFirst<any>(db, `SELECT * FROM works WHERE id = ?1`, workId);
if (!work) return Astro.redirect('/works');

const chapters = await queryAll<any>(db, `SELECT * FROM chapters WHERE work_id = ?1 ORDER BY position`, workId);
const tags = await queryAll<any>(db, `SELECT t.id, t.name, t.type FROM tags t JOIN taggings tg ON t.id = tg.tag_id WHERE tg.work_id = ?1`, workId);
const pseuds = await queryAll<any>(db, `SELECT p.*, c.role FROM pseuds p JOIN creatorships c ON p.id = c.pseud_id WHERE c.work_id = ?1`, workId);

// Check auth status
let authUser = null;
let authPseuds: any[] = [];
const cookie = Astro.request.headers.get('cookie') ?? '';
const sessionMatch = cookie.match(/session=([a-f0-9]+)/);
if (sessionMatch) {
  const session = await queryFirst<any>(db, `SELECT user_id FROM sessions WHERE token = ?1 AND expires_at > datetime('now')`, sessionMatch[1]);
  if (session) {
    authUser = await queryFirst<any>(db, `SELECT * FROM users WHERE id = ?1`, session.user_id);
    if (authUser) {
      authPseuds = await queryAll<any>(db, `SELECT id, name FROM pseuds WHERE user_id = ?1 ORDER BY id`, authUser.id);
    }
  }
}

const isOwner = authUser && pseuds.some(p => p.user_id === authUser.id);
if (!isOwner) return Astro.redirect(`/works/${workId}`);

// Group tags by type for pre-filling
const tagsByType: Record<string, { id: number; name: string }[]> = {};
for (const t of tags) {
  if (!tagsByType[t.type]) tagsByType[t.type] = [];
  tagsByType[t.type].push({ id: t.id, name: t.name });
}

// Pre-build initial tag state for the client
const initialTagState: Record<string, { id: number; name: string }[]> = {
  fandom: tagsByType.fandom || [],
  character: tagsByType.character || [],
  relationship: tagsByType.relationship || [],
  freeform: tagsByType.freeform || [],
};

const ratingTag = tags.find(t => t.type === 'rating');
const categoryTag = tags.find(t => t.type === 'category');
const warningTag = tags.find(t => t.type === 'warning');

const workData = JSON.stringify({
  id: work.id,
  title: work.title,
  summary: work.summary || '',
  notes: work.notes || '',
  complete: work.complete ? true : false,
  rating: ratingTag?.name || '',
  category: categoryTag?.name || '',
  warning: warningTag?.name || '',
  chapters: chapters.map(c => ({
    id: c.id,
    position: c.position,
    title: c.title,
    content_md: c.content_md || '',
    draft: c.draft,
  })),
});

const initialTagsJson = JSON.stringify(initialTagState);
---

<Base title={`Edit: ${work.title} — fanfiction.fyi`}>
  <section class="edit-work">
    <h1 class="page-title">Edit Work</h1>

    <form id="edit-work-form" class="work-form">
      <div class="form-field">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" required placeholder="Work title" value={work.title} />
      </div>

      <div class="form-row">
        <div class="form-field flex-1">
          <label for="summary">Summary</label>
          <textarea id="summary" name="summary" rows="3" placeholder="A brief summary of your work">{work.summary || ''}</textarea>
        </div>
      </div>

      <div class="form-row">
        <div class="form-field flex-1">
          <label for="notes">Author's Notes</label>
          <textarea id="notes" name="notes" rows="3" placeholder="Notes displayed before chapter 1 (optional)">{work.notes || ''}</textarea>
        </div>
      </div>

      <fieldset class="tag-group">
        <legend>Tags</legend>

        <div class="form-field">
          <label for="fandom-tags">Fandom</label>
          <input type="text" id="fandom-tags" name="fandom" placeholder="e.g. Harry Potter, Marvel" data-tag-type="fandom" class="tag-input" />
          <div id="fandom-suggestions" class="tag-suggestions"></div>
          <div id="fandom-selected" class="tag-selected"></div>
        </div>

        <div class="form-field">
          <label for="character-tags">Characters</label>
          <input type="text" id="character-tags" name="characters" placeholder="e.g. Hermione Granger" data-tag-type="character" class="tag-input" />
          <div id="character-suggestions" class="tag-suggestions"></div>
          <div id="character-selected" class="tag-selected"></div>
        </div>

        <div class="form-field">
          <label for="relationship-tags">Relationships</label>
          <input type="text" id="relationship-tags" name="relationships" placeholder="e.g. Harry Potter/Ginny Weasley" data-tag-type="relationship" class="tag-input" />
          <div id="relationship-suggestions" class="tag-suggestions"></div>
          <div id="relationship-selected" class="tag-selected"></div>
        </div>

        <div class="form-field">
          <label for="freeform-tags">Additional Tags</label>
          <input type="text" id="freeform-tags" name="freeform" placeholder="e.g. Angst, Fluff, Slow Burn" data-tag-type="freeform" class="tag-input" />
          <div id="freeform-suggestions" class="tag-suggestions"></div>
          <div id="freeform-selected" class="tag-selected"></div>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label for="rating">Rating</label>
            <select id="rating" name="rating_tags">
              <option value="" selected={!ratingTag}>Not Rated</option>
              <option value="General Audiences" selected={ratingTag?.name === 'General Audiences'}>General Audiences</option>
              <option value="Teen And Up Audiences" selected={ratingTag?.name === 'Teen And Up Audiences'}>Teen And Up Audiences</option>
              <option value="Mature" selected={ratingTag?.name === 'Mature'}>Mature</option>
              <option value="Explicit" selected={ratingTag?.name === 'Explicit'}>Explicit</option>
            </select>
          </div>
          <div class="form-field">
            <label for="category">Category</label>
            <select id="category" name="category_tags">
              <option value="" selected={!categoryTag}>None</option>
              <option value="F/F" selected={categoryTag?.name === 'F/F'}>F/F</option>
              <option value="F/M" selected={categoryTag?.name === 'F/M'}>F/M</option>
              <option value="Gen" selected={categoryTag?.name === 'Gen'}>Gen</option>
              <option value="M/M" selected={categoryTag?.name === 'M/M'}>M/M</option>
              <option value="Multi" selected={categoryTag?.name === 'Multi'}>Multi</option>
              <option value="Other" selected={categoryTag?.name === 'Other'}>Other</option>
            </select>
          </div>
          <div class="form-field">
            <label for="warning">Warnings</label>
            <select id="warning" name="warning_tags">
              <option value="" selected={!warningTag}>No Archive Warnings Apply</option>
              <option value="Choose Not To Use Archive Warnings" selected={warningTag?.name === 'Choose Not To Use Archive Warnings'}>Choose Not To Use Archive Warnings</option>
              <option value="Graphic Depictions Of Violence" selected={warningTag?.name === 'Graphic Depictions Of Violence'}>Graphic Depictions Of Violence</option>
              <option value="Major Character Death" selected={warningTag?.name === 'Major Character Death'}>Major Character Death</option>
              <option value="Rape/Non-Con" selected={warningTag?.name === 'Rape/Non-Con'}>Rape/Non-Con</option>
              <option value="Underage" selected={warningTag?.name === 'Underage'}>Underage</option>
            </select>
          </div>
        </div>
      </fieldset>

      <div class="form-field">
        <label>
          <input type="checkbox" id="complete" name="complete" checked={!!work.complete} />
          Mark as Complete
        </label>
      </div>

      <!-- Chapter editing -->
      <fieldset class="chapter-group">
        <legend>Chapters</legend>
        <div id="chapter-list">
          {chapters.map(c => (
            <div class="chapter-item" data-chapter-id={c.id} data-position={c.position}>
              <div class="chapter-item-header">
                <span class="chapter-item-title">Ch. {c.position}: {c.title}</span>
                <span class="chapter-item-status">{c.draft ? 'Draft' : 'Published'}</span>
                <button type="button" class="btn-text btn-edit-chapter" data-chapter-id={c.id}>Edit</button>
              </div>
            </div>
          ))}
        </div>
      </fieldset>

      <!-- Chapter edit panel (hidden by default) -->
      <fieldset id="chapter-edit-panel" class="chapter-edit-panel" style="display:none;">
        <legend id="chapter-edit-legend">Edit Chapter</legend>
        <input type="hidden" id="editing-chapter-id" />
        <div class="form-field">
          <label for="chapter-title-edit">Chapter Title</label>
          <input type="text" id="chapter-title-edit" name="chapter_title_edit" placeholder="Chapter title" />
        </div>
        <div class="form-field">
          <label for="chapter-content-edit">Content (Markdown)</label>
          <textarea id="chapter-content-edit" name="chapter_content_edit" rows="12" placeholder="Chapter content in markdown..."></textarea>
        </div>
        <div class="form-actions">
          <button type="button" id="save-chapter-btn" class="btn-primary">Save Chapter</button>
          <button type="button" id="cancel-chapter-btn" class="btn-secondary">Cancel</button>
        </div>
        <div id="chapter-save-status" class="form-error"></div>
      </fieldset>

      <div class="form-actions">
        <button type="submit" class="btn-primary" name="action" value="save">Save Changes</button>
        <button type="submit" class="btn-secondary" name="action" value="publish">Save &amp; Publish</button>
        <button type="button" id="delete-work-btn" class="btn-danger">Delete Work</button>
      </div>

      <div id="form-error" class="form-error" role="alert"></div>
    </form>
  </section>
</Base>

<style is:global>
  @import '../../../styles/theme.css';

  .edit-work {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-title {
    font: var(--md-sys-typescale-headline-medium);
    color: var(--md-sys-color-on-surface);
    margin: 0 0 var(--space-6) 0;
  }

  .work-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .form-field label {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
  }

  .form-field input,
  .form-field textarea,
  .form-field select {
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small);
    padding: var(--space-3) var(--space-4);
    outline: none;
    transition: border-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .form-field input:focus,
  .form-field textarea:focus,
  .form-field select:focus {
    border-color: var(--md-sys-color-primary);
  }

  .form-field input[type="checkbox"] {
    width: auto;
    margin-right: var(--space-2);
    accent-color: var(--md-sys-color-primary);
  }

  .form-row {
    display: flex;
    gap: var(--space-4);
  }

  .flex-1 { flex: 1; }

  .form-error {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-error);
    min-height: 1.2em;
  }

  fieldset {
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-medium);
    padding: var(--space-4);
  }

  fieldset legend {
    font: var(--md-sys-typescale-title-medium);
    color: var(--md-sys-color-on-surface);
    padding: 0 var(--space-2);
  }

  .tag-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    min-height: 0;
  }

  .tag-selected {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    min-height: 0;
    margin-top: var(--space-1);
  }

  .tag-pill {
    font: var(--md-sys-typescale-label-large);
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--md-sys-shape-corner-full);
    cursor: pointer;
  }

  .tag-pill:hover {
    background: var(--md-sys-color-secondary);
    color: var(--md-sys-color-on-secondary);
  }

  .chapter-item {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
  }

  .chapter-item:last-child {
    border-bottom: none;
  }

  .chapter-item-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .chapter-item-title {
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
    flex: 1;
  }

  .chapter-item-status {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-outline);
    background: var(--md-sys-color-surface-container-high);
    padding: 2px var(--space-3);
    border-radius: var(--md-sys-shape-corner-full);
  }

  .btn-text {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-primary);
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--md-sys-shape-corner-full);
  }

  .btn-text:hover {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  .chapter-edit-panel {
    margin-top: var(--space-2);
  }

  .form-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .btn-primary {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-primary);
    background: var(--md-sys-color-primary);
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-6);
    cursor: pointer;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .btn-primary:hover { background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); }
  .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }

  .btn-secondary {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-primary);
    background: transparent;
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-6);
    cursor: pointer;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .btn-secondary:hover { background: var(--md-sys-color-surface-container-high); }
  .btn-secondary:disabled { opacity: 0.5; cursor: not-allowed; }

  .btn-danger {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-error);
    background: var(--md-sys-color-error);
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-6);
    cursor: pointer;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .btn-danger:hover { background: var(--md-sys-color-error-container); color: var(--md-sys-color-on-error-container); }
</style>

<script define:vars={{ workId, workData, initialTagsJson }}>
  const work = JSON.parse(workData);
  const initialTags = JSON.parse(initialTagsJson);

  // Tag autocomplete logic (same pattern as new.astro, but pre-filled)
  const tagInputFields = document.querySelectorAll('.tag-input');
  const selectedTags: Record<string, { id: number; name: string }[]> = {};
  let currentPseudId = null;

  // Initialize tag state from existing work data
  for (const [type, tags] of Object.entries(initialTags)) {
    selectedTags[type] = (tags as { id: number; name: string }[]).map(t => ({ id: t.id, name: t.name }));
  }

  // Render initial tag display
  for (const type of Object.keys(selectedTags)) {
    updateSelectedDisplay(type);
  }

  tagInputFields.forEach(input => {
    const el = input as HTMLInputElement;
    const type = el.dataset.tagType!;
    const suggestionsEl = document.getElementById(`${type}-suggestions`)!;

    let debounce: ReturnType<typeof setTimeout>;
    el.addEventListener('input', () => {
      clearTimeout(debounce);
      const q = el.value.trim();
      if (q.length < 2) { suggestionsEl.innerHTML = ''; return; }
      debounce = setTimeout(async () => {
        const res = await fetch(`/api/tags?type=${type}&name=${encodeURIComponent(q)}&limit=8`);
        const tags = await res.json();
        suggestionsEl.innerHTML = tags.map((t: any) =>
          `<span class="tag-pill" data-id="${t.id}" data-name="${t.name}">${t.name}</span>`
        ).join('');
        suggestionsEl.querySelectorAll('.tag-pill').forEach(pill => {
          pill.addEventListener('click', () => {
            const id = Number((pill as HTMLElement).dataset.id);
            const name = (pill as HTMLElement).dataset.name!;
            if (!selectedTags[type].some(t => t.id === id)) {
              selectedTags[type].push({ id, name });
              updateSelectedDisplay(type);
            }
            el.value = '';
            suggestionsEl.innerHTML = '';
          });
        });
      }, 300);
    });
  });

  function updateSelectedDisplay(type: string) {
    const container = document.getElementById(`${type}-selected`)!;
    container.innerHTML = selectedTags[type].map(t =>
      `<span class="tag-pill" data-id="${t.id}" title="Click to remove">${t.name} ✕</span>`
    ).join('');
    container.querySelectorAll('.tag-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        const id = Number((pill as HTMLElement).dataset.id);
        selectedTags[type] = selectedTags[type].filter(i => i.id !== id);
        updateSelectedDisplay(type);
      });
    });
  }

  // Chapter editing
  const chapterEditPanel = document.getElementById('chapter-edit-panel')!;
  const chapterEditLegend = document.getElementById('chapter-edit-legend')!;
  const editingChapterIdInput = document.getElementById('editing-chapter-id') as HTMLInputElement;
  const chapterTitleInput = document.getElementById('chapter-title-edit') as HTMLInputElement;
  const chapterContentInput = document.getElementById('chapter-content-edit') as HTMLTextAreaElement;
  const saveChapterBtn = document.getElementById('save-chapter-btn')!;
  const cancelChapterBtn = document.getElementById('cancel-chapter-btn')!;
  const chapterSaveStatus = document.getElementById('chapter-save-status')!;

  document.querySelectorAll('.btn-edit-chapter').forEach(btn => {
    btn.addEventListener('click', () => {
      const chapterId = Number((btn as HTMLElement).dataset.chapterId);
      const chapter = work.chapters.find((c: any) => c.id === chapterId);
      if (!chapter) return;

      editingChapterIdInput.value = String(chapterId);
      chapterTitleInput.value = chapter.title;
      chapterContentInput.value = chapter.content_md;
      chapterEditLegend.textContent = `Edit Chapter ${chapter.position}: ${chapter.title}`;
      chapterEditPanel.style.display = '';
      chapterSaveStatus.textContent = '';
      chapterEditPanel.scrollIntoView({ behavior: 'smooth' });
    });
  });

  cancelChapterBtn.addEventListener('click', () => {
    chapterEditPanel.style.display = 'none';
  });

  saveChapterBtn.addEventListener('click', async () => {
    const chapterId = Number(editingChapterIdInput.value);
    if (!chapterId) return;

    chapterSaveStatus.textContent = 'Saving…';
    try {
      const res = await fetch(`/api/works/${workId}/chapters/${chapterId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: chapterTitleInput.value,
          content_md: chapterContentInput.value,
        }),
      });
      if (res.ok) {
        const updated = await res.json();
        chapterSaveStatus.textContent = 'Chapter saved!';
        // Update local chapter data
        const ch = work.chapters.find((c: any) => c.id === chapterId);
        if (ch) {
          ch.title = chapterTitleInput.value;
          ch.content_md = chapterContentInput.value;
        }
        // Update chapter list display
        const chapterItem = document.querySelector(`.chapter-item[data-chapter-id="${chapterId}"] .chapter-item-title`);
        if (chapterItem) {
          const pos = ch?.position || '?';
          chapterItem.textContent = `Ch. ${pos}: ${chapterTitleInput.value}`;
        }
        chapterEditPanel.style.display = 'none';
      } else {
        const data = await res.json();
        chapterSaveStatus.textContent = data.error || 'Failed to save chapter';
      }
    } catch {
      chapterSaveStatus.textContent = 'Network error';
    }
  });

  // Work form submit
  const form = document.getElementById('edit-work-form') as HTMLFormElement;
  const errorEl = document.getElementById('form-error')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.textContent = '';

    const action = (document.activeElement as HTMLButtonElement)?.value || 'save';
    const title = (document.getElementById('title') as HTMLInputElement).value;
    const summary = (document.getElementById('summary') as HTMLTextAreaElement).value;
    const notes = (document.getElementById('notes') as HTMLTextAreaElement).value;
    const complete = (document.getElementById('complete') as HTMLInputElement).checked;
    const rating = (document.getElementById('rating') as HTMLSelectElement).value;
    const category = (document.getElementById('category') as HTMLSelectElement).value;
    const warning = (document.getElementById('warning') as HTMLSelectElement).value;

    const tagIds: number[] = [];
    Object.values(selectedTags).flat().forEach((t: any) => tagIds.push(t.id));

    try {
      const res = await fetch(`/api/works/${workId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title,
          summary: summary || null,
          notes: notes || null,
          complete,
          publish: action === 'publish',
          tag_ids: tagIds,
          rating: rating || null,
          category: category || null,
          warning: warning || null,
        }),
      });
      if (res.ok) {
        window.location.href = `/works/${workId}`;
      } else {
        const data = await res.json();
        errorEl.textContent = data.error || 'Failed to update work';
      }
    } catch {
      errorEl.textContent = 'Network error';
    }
  });

  // Delete work button
  const deleteBtn = document.getElementById('delete-work-btn')!;
  deleteBtn.addEventListener('click', async () => {
    if (!confirm('Are you sure you want to delete this work? This action cannot be undone.')) return;

    try {
      const res = await fetch(`/api/works/${workId}`, { method: 'DELETE' });
      if (res.ok) {
        window.location.href = '/works';
      } else {
        const data = await res.json();
        errorEl.textContent = data.error || 'Failed to delete work';
      }
    } catch {
      errorEl.textContent = 'Network error';
    }
  });
</script>