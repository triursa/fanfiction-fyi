---
export const prerender = false;
import Base from '../../../layouts/Base.astro';
import { queryFirst, queryAll } from '../../../lib/db';
import { markdownToHtml } from '../../../lib/markdown';

const workId = Number(Astro.params.id);
if (!workId) return Astro.redirect('/works');

const db = Astro.locals.runtime.env.DB as D1Database;

const work = await queryFirst<any>(db, `SELECT * FROM works WHERE id = ?1`, workId);
if (!work) return Astro.redirect('/works');

const chapters = await queryAll<any>(db, `SELECT id, position, title, draft, word_count, updated_at FROM chapters WHERE work_id = ?1 ORDER BY position`, workId);
const publishedChapters = chapters.filter(c => c.draft === 0);
const tags = await queryAll<any>(db, `SELECT t.* FROM tags t JOIN taggings tg ON t.id = tg.tag_id WHERE tg.work_id = ?1`, workId);
const pseuds = await queryAll<any>(db, `SELECT p.*, c.role FROM pseuds p JOIN creatorships c ON p.id = c.pseud_id WHERE c.work_id = ?1`, workId);

// Default chapter to display
const chapterId = Number(Astro.url.searchParams.get('chapter')) || (publishedChapters[0]?.id ?? chapters[0]?.id);
const chapter = chapterId ? await queryFirst<any>(db, `SELECT * FROM chapters WHERE id = ?1`, chapterId) : null;

// Check auth status
let authUser = null;
let userPseudId: number | null = null;
const cookie = Astro.request.headers.get('cookie') ?? '';
const sessionMatch = cookie.match(/session=([a-f0-9]+)/);
if (sessionMatch) {
  const session = await queryFirst<any>(db, `SELECT user_id FROM sessions WHERE token = ?1 AND expires_at > datetime('now')`, sessionMatch[1]);
  if (session) {
    authUser = await queryFirst<any>(db, `SELECT * FROM users WHERE id = ?1`, session.user_id);
    if (authUser) {
      const userPseud = await queryFirst<any>(db, `SELECT id FROM pseuds WHERE user_id = ?1 ORDER BY id LIMIT 1`, authUser.id);
      userPseudId = userPseud?.id ?? null;
    }
  }
}

const isOwner = authUser && pseuds.some(p => p.user_id === authUser.id);

// Group tags by type
const tagsByType: Record<string, string[]> = {};
for (const t of tags) {
  if (!tagsByType[t.type]) tagsByType[t.type] = [];
  tagsByType[t.type].push(t.name);
}

// Kudos count
const kudosCount = (await queryFirst<any>(db, `SELECT COUNT(*) as cnt FROM kudos WHERE work_id = ?1`, workId))?.cnt ?? 0;

// Bookmark & reading state for logged-in users
let existingBookmark: any = null;
let readingProgress: any = null;
if (userPseudId) {
  existingBookmark = await queryFirst<any>(db, `SELECT id, notes, private FROM bookmarks WHERE pseud_id = ?1 AND work_id = ?2`, userPseudId, workId);
  readingProgress = await queryFirst<any>(db, `SELECT * FROM readings WHERE pseud_id = ?1 AND work_id = ?2`, userPseudId, workId);
}

// Comments — fetch all top-level + replies in one query, build tree client-side
const allComments = await queryAll<any>(db, `SELECT c.*, p.name as pseud_name FROM comments c JOIN pseuds p ON c.pseud_id = p.id WHERE c.work_id = ?1 ORDER BY c.created_at ASC`, workId);
for (const c of allComments) {
  if (c.content) {
    c.content_html = markdownToHtml(c.content);
  }
}
const commentsJson = JSON.stringify(allComments);
---

<Base title={`${work.title} — fanfiction.fyi`}>
  <article class="work-display">
    <header class="work-header">
      <h1 class="work-title">{work.title}</h1>

      <div class="work-meta">
        <p class="work-authors">
          By {pseuds.map(p => `<a href="/pseuds/${p.id}" class="pseud-link">${p.name}</a>`).join(', ')}
        </p>
        {work.summary && <p class="work-summary">{work.summary}</p>}
        <div class="work-stats">
          <span>{work.word_count.toLocaleString()} words</span>
          <span>·</span>
          <span>{publishedChapters.length} chapter{publishedChapters.length !== 1 ? 's' : ''}</span>
          <span>·</span>
          <span>{work.complete ? 'Complete' : 'Work in Progress'}</span>
          {work.published_at && <><span>·</span><span>Published {new Date(work.published_at).toLocaleDateString()}</span></>}
        </div>
      </div>

      {tagsByType.rating && <div class="tag-group"><span class="tag-label">Rating:</span> {tagsByType.rating.map(t => <span class="tag-pill tag-rating">{t}</span>)}</div>}
      {tagsByType.warning && <div class="tag-group"><span class="tag-label">Warnings:</span> {tagsByType.warning.map(t => <span class="tag-pill tag-warning">{t}</span>)}</div>}
      {tagsByType.category && <div class="tag-group"><span class="tag-label">Category:</span> {tagsByType.category.map(t => <span class="tag-pill">{t}</span>)}</div>}
      {tagsByType.fandom && <div class="tag-group"><span class="tag-label">Fandom:</span> {tagsByType.fandom.map(t => <span class="tag-pill">{t}</span>)}</div>}
      {tagsByType.character && <div class="tag-group"><span class="tag-label">Characters:</span> {tagsByType.character.map(t => <span class="tag-pill">{t}</span>)}</div>}
      {tagsByType.relationship && <div class="tag-group"><span class="tag-label">Relationships:</span> {tagsByType.relationship.map(t => <span class="tag-pill">{t}</span>)}</div>}
      {tagsByType.freeform && <div class="tag-group"><span class="tag-label">Additional Tags:</span> {tagsByType.freeform.map(t => <span class="tag-pill">{t}</span>)}</div>}

      {isOwner && (
        <div class="work-owner-actions">
          <a href={`/works/${work.id}/edit`} class="btn-secondary">Edit Work</a>
          <a href={`/works/${work.id}/edit`} class="btn-secondary">Add Chapter</a>
        </div>
      )}
    </header>

    {work.notes && (
      <section class="work-notes">
        <h3>Author's Notes</h3>
        <div class="prose-content" set:html={work.notes} />
      </section>
    )}

    {publishedChapters.length > 1 && (
      <nav class="chapter-nav">
        <h3>Chapters</h3>
        <ol class="chapter-list">
          {publishedChapters.map(c => (
            <li class={c.id === chapterId ? 'current' : ''}>
              <a href={`/works/${work.id}?chapter=${c.id}`}>{c.title}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    {chapter && (
      <section class="chapter-content">
        <h2 class="chapter-title">{chapter.title}</h2>
        {chapter.content_html && <div class="prose-content" set:html={chapter.content_html} />}
        {!chapter.content_html && chapter.content_md && <div class="prose-content" set:html={markdownToHtml(chapter.content_md)} />}
        {!chapter.content_html && !chapter.content_md && <p class="placeholder-text">Content not available.</p>}
      </section>
    )}

    {work.end_notes && (
      <section class="work-notes">
        <h3>End Notes</h3>
        <div class="prose-content" set:html={work.end_notes} />
      </section>
    )}

    <div class="work-actions">
      <button id="kudos-btn" class="btn-primary" data-work-id={work.id}>❤️ Leave Kudos ({kudosCount})</button>

      {work.published_at && (
        <a href={`/api/works/${work.id}/export?format=epub`} class="btn-secondary" download>📥 Export EPUB</a>
      )}

      {authUser && (
        <div class="user-work-actions" data-authed="true">
          <button id="bookmark-btn" class="btn-secondary" data-bookmarked={existingBookmark ? 'true' : 'false'} data-work-id={work.id}>
            {existingBookmark ? '🔖 Bookmarked' : '🔖 Bookmark'}
          </button>
          <button id="mark-later-btn" class="btn-secondary" data-for-later={readingProgress?.for_later ? 'true' : 'false'} data-work-id={work.id}>
            {readingProgress?.for_later ? '📋 Marked for Later' : '📋 Mark for Later'}
          </button>
        </div>
      )}
    </div>

    {authUser && existingBookmark && (
      <div class="bookmark-info">
        <span class="bookmark-badge">🔖 Bookmarked</span>
        {existingBookmark.private && <span class="badge-private-inline">Private</span>}
        {existingBookmark.notes && <p class="bookmark-user-notes">"{existingBookmark.notes}"</p>}
      </div>
    )}

    <!-- Comments Section -->
    <section class="comments-section">
      <h3 class="comments-title">Comments ({allComments.length})</h3>

      {authUser ? (
        <form id="comment-form" class="comment-form">
          <input type="hidden" name="work_id" value={work.id} />
          <input type="hidden" name="chapter_id" value={chapter?.id ?? ''} />
          <input type="hidden" name="parent_id" id="reply-parent-id" value="" />
          <div class="comment-form-header">
            <span id="reply-indicator" class="reply-indicator" style="display:none;">
              Replying to <span id="reply-to-name"></span>
              <button type="button" id="cancel-reply" class="cancel-reply-btn">✕</button>
            </span>
          </div>
          <textarea id="comment-content" name="content" placeholder="Leave a comment…" rows="3" required class="comment-textarea"></textarea>
          <button type="submit" class="btn-primary">Post Comment</button>
        </form>
      ) : (
        <p class="login-prompt"><a href="/login">Sign in</a> to leave a comment.</p>
      )}

      <div id="comments-thread" class="comments-thread" data-comments={commentsJson}>
        {allComments.filter(c => !c.parent_id).map(comment => (
          <div class="comment-item" data-comment-id={comment.id}>
            <div class="comment-body">
              <span class="comment-author">{comment.pseud_name}</span>
              <span class="comment-date">{new Date(comment.created_at).toLocaleDateString()}</span>
              <div class="comment-content" set:html={comment.content_html || comment.content} />
              {authUser && (
                <button class="reply-btn" data-comment-id={comment.id} data-pseud-name={comment.pseud_name}>Reply</button>
              )}
            </div>
            <div class="comment-replies">
              {allComments.filter(r => r.parent_id === comment.id).map(reply => (
                <div class="comment-item comment-reply" data-comment-id={reply.id}>
                  <div class="comment-body">
                    <span class="comment-author">{reply.pseud_name}</span>
                    <span class="comment-date">{new Date(reply.created_at).toLocaleDateString()}</span>
                    <div class="comment-content" set:html={reply.content_html || reply.content} />
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </article>
</Base>

<style is:global>
  @import '../../../styles/theme.css';

  .work-display { max-width: var(--reading-width); margin: 0 auto; padding: var(--space-6) 0; }
  .work-title { font: var(--md-sys-typescale-headline-large); color: var(--md-sys-color-on-surface); margin: 0 0 var(--space-4); }

  .work-authors { font: var(--md-sys-typescale-title-medium); color: var(--md-sys-color-on-surface-variant); margin: 0 0 var(--space-2); }
  .work-authors a, .pseud-link { color: var(--md-sys-color-primary); }
  .work-summary { font: var(--md-sys-typescale-body-large); color: var(--md-sys-color-on-surface-variant); font-style: italic; margin: var(--space-2) 0; }
  .work-stats { font: var(--md-sys-typescale-body-medium); color: var(--md-sys-color-outline); display: flex; gap: var(--space-2); flex-wrap: wrap; }

  .tag-group { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; margin: var(--space-1) 0; }
  .tag-label { font: var(--md-sys-typescale-label-large); color: var(--md-sys-color-on-surface-variant); }
  .tag-pill { font: var(--md-sys-typescale-body-small); background: var(--md-sys-color-secondary-container); color: var(--md-sys-color-on-secondary-container); padding: 2px var(--space-3); border-radius: var(--md-sys-shape-corner-full); }
  .tag-rating { background: var(--md-sys-color-tertiary-container); color: var(--md-sys-color-on-tertiary-container); }
  .tag-warning { background: var(--md-sys-color-error-container); color: var(--md-sys-color-on-error-container); }

  .work-owner-actions { display: flex; gap: var(--space-3); margin-top: var(--space-4); }

  .work-notes { background: var(--md-sys-color-surface-container); border-radius: var(--md-sys-shape-corner-medium); padding: var(--space-4); margin: var(--space-6) 0; }
  .work-notes h3 { font: var(--md-sys-typescale-title-medium); margin: 0 0 var(--space-2); }

  .chapter-nav { margin: var(--space-6) 0; }
  .chapter-nav h3 { font: var(--md-sys-typescale-title-medium); margin: 0 0 var(--space-2); }
  .chapter-list { list-style: decimal; padding-left: var(--space-6); }
  .chapter-list li { padding: var(--space-1) 0; }
  .chapter-list li.current { font-weight: 600; }
  .chapter-list li a { color: var(--md-sys-color-primary); }

  .chapter-title { font: var(--md-sys-typescale-headline-medium); color: var(--md-sys-color-on-surface); margin: var(--space-6) 0 var(--space-4); }

  .prose-content { font: var(--md-sys-typescale-body-large); line-height: 1.8; color: var(--md-sys-color-on-surface); }
  .prose-content p { margin: var(--space-2) 0; }
  .prose-content h1, .prose-content h2, .prose-content h3 { margin: var(--space-6) 0 var(--space-2); color: var(--md-sys-color-on-surface); }

  .work-actions { margin-top: var(--space-8); display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap; }
  .user-work-actions { display: flex; gap: var(--space-3); }

  .bookmark-info { background: var(--md-sys-color-secondary-container); border-radius: var(--md-sys-shape-corner-medium); padding: var(--space-3) var(--space-4); margin-top: var(--space-3); display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
  .bookmark-badge { font: var(--md-sys-typescale-label-large); color: var(--md-sys-color-on-secondary-container); }
  .badge-private-inline { font: var(--md-sys-typescale-label-small); background: var(--md-sys-color-tertiary-container); color: var(--md-sys-color-on-tertiary-container); padding: 2px var(--space-2); border-radius: var(--md-sys-shape-corner-full); }
  .bookmark-user-notes { font: var(--md-sys-typescale-body-medium); color: var(--md-sys-color-on-secondary-container); margin: 0; font-style: italic; }

  .comments-section { margin-top: var(--space-10); border-top: 1px solid var(--md-sys-color-outline-variant); padding-top: var(--space-6); }
  .comments-title { font: var(--md-sys-typescale-headline-medium); color: var(--md-sys-color-on-surface); margin: 0 0 var(--space-4); }

  .comment-form { margin-bottom: var(--space-6); }
  .comment-form-header { margin-bottom: var(--space-2); }
  .reply-indicator { font: var(--md-sys-typescale-body-small); color: var(--md-sys-color-primary); background: var(--md-sys-color-primary-container); padding: var(--space-1) var(--space-2); border-radius: var(--md-sys-shape-corner-full); display: inline-flex; align-items: center; gap: var(--space-2); }
  .cancel-reply-btn { background: none; border: none; color: var(--md-sys-color-on-primary-container); cursor: pointer; font-size: 14px; padding: 0 var(--space-1); }
  .comment-textarea { width: 100%; font: var(--md-sys-typescale-body-large); background: var(--md-sys-color-surface-container); color: var(--md-sys-color-on-surface); border: 1px solid var(--md-sys-color-outline-variant); border-radius: var(--md-sys-shape-corner-medium); padding: var(--space-3); resize: vertical; }
  .comment-textarea:focus { outline: none; border-color: var(--md-sys-color-primary); }
  .login-prompt { font: var(--md-sys-typescale-body-large); color: var(--md-sys-color-outline); }
  .login-prompt a { color: var(--md-sys-color-primary); }

  .comments-thread { display: flex; flex-direction: column; gap: var(--space-4); }
  .comment-item { background: var(--md-sys-color-surface-container); border-radius: var(--md-sys-shape-corner-medium); padding: var(--space-4); }
  .comment-body { }
  .comment-author { font: var(--md-sys-typescale-label-large); color: var(--md-sys-color-primary); }
  .comment-date { font: var(--md-sys-typescale-body-small); color: var(--md-sys-color-outline); margin-left: var(--space-2); }
  .comment-content { font: var(--md-sys-typescale-body-large); color: var(--md-sys-color-on-surface); line-height: 1.7; margin-top: var(--space-2); }
  .comment-content p { margin: var(--space-1) 0; }
  .reply-btn { font: var(--md-sys-typescale-label-medium); color: var(--md-sys-color-primary); background: none; border: none; cursor: pointer; margin-top: var(--space-2); padding: 0; }
  .reply-btn:hover { text-decoration: underline; }
  .comment-replies { margin-left: var(--space-6); margin-top: var(--space-3); display: flex; flex-direction: column; gap: var(--space-2); }
  .comment-reply { background: var(--md-sys-color-surface-container-high); }

  .btn-primary { font: var(--md-sys-typescale-label-large); color: var(--md-sys-color-on-primary); background: var(--md-sys-color-primary); border: none; border-radius: var(--md-sys-shape-corner-full); padding: var(--space-3) var(--space-6); cursor: pointer; }
  .btn-secondary { font: var(--md-sys-typescale-label-large); color: var(--md-sys-color-primary); background: transparent; border: 1px solid var(--md-sys-color-outline); border-radius: var(--md-sys-shape-corner-full); padding: var(--space-3) var(--space-6); cursor: pointer; text-decoration: none; }
  .placeholder-text { font: var(--md-sys-typescale-body-large); color: var(--md-sys-color-outline); font-style: italic; }
</style>

<script define:vars={{ workId, chapterId, authed: !!authUser }}>
  // Kudos
  const kudosBtn = document.getElementById('kudos-btn');
  if (kudosBtn) {
    kudosBtn.addEventListener('click', async () => {
      try {
        const res = await fetch('/api/kudos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ work_id: workId }),
        });
        if (res.ok) {
          kudosBtn.textContent = '❤️ Kudos Left!';
          kudosBtn.disabled = true;
        } else if (res.status === 409) {
          kudosBtn.textContent = '❤️ Already Gave Kudos';
          kudosBtn.disabled = true;
        }
      } catch { /* silently fail */ }
    });
  }

  if (!authed) return; // everything below requires auth

  // Bookmark toggle
  const bookmarkBtn = document.getElementById('bookmark-btn');
  if (bookmarkBtn) {
    bookmarkBtn.addEventListener('click', async () => {
      const isBookmarked = bookmarkBtn.dataset.bookmarked === 'true';
      try {
        if (isBookmarked) {
          const res = await fetch('/api/bookmarks', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ work_id: workId }),
          });
          if (res.ok) {
            bookmarkBtn.textContent = '🔖 Bookmark';
            bookmarkBtn.dataset.bookmarked = 'false';
          }
        } else {
          const res = await fetch('/api/bookmarks', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ work_id: workId }),
          });
          if (res.ok || res.status === 409) {
            bookmarkBtn.textContent = '🔖 Bookmarked';
            bookmarkBtn.dataset.bookmarked = 'true';
          }
        }
      } catch { /* silently fail */ }
    });
  }

  // Mark for Later toggle
  const laterBtn = document.getElementById('mark-later-btn');
  if (laterBtn) {
    laterBtn.addEventListener('click', async () => {
      const isForLater = laterBtn.dataset.forLater === 'true';
      try {
        const res = await fetch(`/api/works/${workId}/progress`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ for_later: !isForLater }),
        });
        if (res.ok) {
          if (isForLater) {
            laterBtn.textContent = '📋 Mark for Later';
            laterBtn.dataset.forLater = 'false';
          } else {
            laterBtn.textContent = '📋 Marked for Later';
            laterBtn.dataset.forLater = 'true';
          }
        }
      } catch { /* silently fail */ }
    });
  }

  // Reading progress — auto-send on page load
  try {
    fetch(`/api/works/${workId}/progress`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ last_chapter: chapterId }),
    }).catch(() => {});
  } catch { /* silently fail */ }

  // Comment form
  const commentForm = document.getElementById('comment-form');
  if (commentForm) {
    commentForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const content = document.getElementById('comment-content').value.trim();
      const parentId = document.getElementById('reply-parent-id').value;
      if (!content) return;

      try {
        const body = { content, work_id: workId };
        if (parentId) body.parent_id = Number(parentId);
        if (chapterId) body.chapter_id = chapterId;

        const res = await fetch(`/api/works/${workId}/comments`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (res.ok) {
          window.location.reload();
        }
      } catch { /* silently fail */ }
    });
  }

  // Reply buttons
  document.querySelectorAll('.reply-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const commentId = btn.dataset.commentId;
      const pseudName = btn.dataset.pseudName;
      const parentInput = document.getElementById('reply-parent-id');
      const indicator = document.getElementById('reply-indicator');
      const replyName = document.getElementById('reply-to-name');
      if (parentInput && indicator && replyName) {
        parentInput.value = commentId;
        replyName.textContent = pseudName;
        indicator.style.display = 'inline-flex';
      }
      document.getElementById('comment-content')?.focus();
    });
  });

  // Cancel reply
  const cancelReply = document.getElementById('cancel-reply');
  if (cancelReply) {
    cancelReply.addEventListener('click', () => {
      const parentInput = document.getElementById('reply-parent-id');
      const indicator = document.getElementById('reply-indicator');
      if (parentInput) parentInput.value = '';
      if (indicator) indicator.style.display = 'none';
    });
  }
</script>