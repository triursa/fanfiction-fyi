---
export const prerender = false;
import Base from '../../../layouts/Base.astro';
import { getDrizzle } from '../../../lib/db';
import { getAuth, checkApproved } from '../../../lib/auth';
import { collections } from '../../../lib/schema';
import { eq } from 'drizzle-orm';

const d1 = Astro.locals.runtime.env.DB as D1Database;
const db = getDrizzle(d1);
const auth = await getAuth(db, Astro.request);
if (!auth) return Astro.redirect('/login');
const approval = checkApproved(auth);
if ('forbidden' in approval) return Astro.redirect('/login');

const collectionId = Number(Astro.params.id);
if (!collectionId) return Astro.redirect('/collections');

const collection = await db.select().from(collections).where(eq(collections.id, collectionId)).get();
if (!collection) return Astro.redirect('/collections');

// Verify ownership
const pseudIds = auth.pseuds.map(p => p.id);
if (!pseudIds.includes(collection.ownerPseudId)) return Astro.redirect('/collections');
---

<Base title={`Edit: ${collection.title} — fanfiction.fyi`}>
  <div class="collection-form-page">
    <div class="collection-form-card">
      <h1 class="collection-form-title">Edit Collection</h1>

      <form id="collection-form" class="collection-form">
        <div class="form-field">
          <label>URL Name</label>
          <input type="text" value={collection.name} disabled />
          <span class="field-helper">URL name cannot be changed after creation.</span>
        </div>

        <div class="form-field">
          <label for="coll-title">Title</label>
          <input type="text" id="coll-title" name="title" required value={collection.title} />
        </div>

        <div class="form-field">
          <label for="coll-description">Description <span class="optional-tag">(optional)</span></label>
          <textarea id="coll-description" name="description" rows="4">{collection.description || ''}</textarea>
        </div>

        <div class="form-field">
          <label for="coll-privacy">Privacy</label>
          <select id="coll-privacy" name="privacy">
            <option value="open" selected={collection.privacy === 'open'}>Open — Anyone can add works</option>
            <option value="moderated" selected={collection.privacy === 'moderated'}>Moderated — Submissions need approval</option>
            <option value="closed" selected={collection.privacy === 'closed'}>Closed — Only you can add works</option>
            <option value="public" selected={collection.privacy === 'public'}>Public — Visible to everyone</option>
            <option value="unrevealed" selected={collection.privacy === 'unrevealed'}>Unrevealed — Hidden until reveal</option>
            <option value="private" selected={collection.privacy === 'private'}>Private — Only visible to you</option>
          </select>
        </div>

        <div id="coll-error" class="form-error" role="alert"></div>

        <div class="form-actions">
          <button type="submit" class="btn-primary" id="submit-btn">Save Changes</button>
          <a href={`/collections/${collectionId}`} class="btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</Base>

<style is:global>
  .collection-form-page {
    max-width: 600px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .collection-form-card {
    padding: var(--space-8);
    border-radius: 28px;
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
  }

  .collection-form-title {
    font: var(--md-sys-typescale-headline-medium);
    color: var(--md-sys-color-on-surface);
    margin: 0 0 var(--space-6) 0;
  }

  .collection-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .form-field label {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
  }

  .form-field input,
  .form-field textarea,
  .form-field select {
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small);
    padding: var(--space-3) var(--space-4);
    outline: none;
    transition: border-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .form-field input:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .form-field input:focus,
  .form-field textarea:focus,
  .form-field select:focus {
    border-color: var(--md-sys-color-primary);
  }

  .field-helper {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-on-surface-variant);
  }

  .optional-tag {
    font: var(--md-sys-typescale-body-small);
    opacity: 0.7;
  }

  .form-error {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-error);
    min-height: 1.2em;
  }

  .form-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .btn-primary {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-primary);
    background: var(--md-sys-color-primary);
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-6);
    cursor: pointer;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .btn-primary:hover {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  .btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-secondary {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
    background: var(--md-sys-color-surface-container-high);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-6);
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .btn-secondary:hover {
    background: var(--md-sys-color-surface-container-highest);
  }
</style>

<script define:vars={{ collectionId }}>
  const form = document.getElementById('collection-form');
  const errorEl = document.getElementById('coll-error');
  const btn = document.getElementById('submit-btn');
  const btnText = btn.textContent;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.textContent = '';

    btn.disabled = true;
    btn.textContent = 'Saving…';

    try {
      const res = await fetch(`/api/collections/${collectionId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: collectionId,
          title: document.getElementById('coll-title').value.trim(),
          description: document.getElementById('coll-description').value.trim() || null,
          privacy: document.getElementById('coll-privacy').value,
        }),
      });

      if (res.ok) {
        window.location.href = `/collections/${collectionId}`;
      } else {
        const data = await res.json().catch(() => ({}));
        errorEl.textContent = data.error || 'Failed to save changes';
      }
    } catch {
      errorEl.textContent = 'Network error — please check your connection and try again';
    } finally {
      btn.disabled = false;
      btn.textContent = btnText;
    }
  });
</script>