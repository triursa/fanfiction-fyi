---
export const prerender = false;
export const config = { auth: 'public' };
import Base from '@/v2/layouts/Base.astro';

// Show helpful message based on context
const justRegistered = Astro.url.searchParams.get('registered') === '1';
---

<Base title="Pending Approval — fanfiction.fyi">
  <div class="pending-container">
    <div class="pending-card">
      <div class="pending-icon">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
      <h1 class="pending-title">Account Pending Approval</h1>
      {justRegistered ? (
        <p class="pending-message">Your account has been created and is awaiting administrator approval. You'll be able to access the site once approved.</p>
      ) : (
        <p class="pending-message">Your account is awaiting administrator approval. You'll be able to access the site once approved.</p>
      )}
      <p class="pending-detail">This usually happens within 24 hours. You'll be automatically redirected when approved.</p>
      <div id="approval-status" class="pending-status"></div>
      <form method="POST" action="/api/auth/logout" class="pending-form">
        <button type="submit" class="btn-secondary">Sign Out</button>
      </form>
    </div>
  </div>
</Base>

<script>
  // Poll for approval status every 30 seconds
  let pollInterval: ReturnType<typeof setInterval>;

  async function checkApproval() {
    try {
      const res = await fetch('/api/auth/me');
      if (res.ok) {
        const data = await res.json();
        if (data.data?.approved) {
          window.location.href = '/';
          clearInterval(pollInterval);
        }
      }
    } catch { /* ignore network errors during polling */ }
  }

  pollInterval = setInterval(checkApproval, 30000);
  // Also check immediately
  checkApproval();
</script>

<style is:global>
  .pending-container {
    max-width: 480px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-4);
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .pending-card {
    background: var(--md-sys-color-surface-container);
    border-radius: var(--md-sys-shape-corner-large);
    padding: var(--space-8) var(--space-6);
    text-align: center;
    border: 1px solid var(--md-sys-color-outline-variant);
  }

  .pending-icon { color: var(--md-sys-color-primary); margin-bottom: var(--space-4); }
  .pending-title { font: var(--md-sys-typescale-headline-medium); color: var(--md-sys-color-on-surface); margin: 0 0 var(--space-4); }
  .pending-message { font: var(--md-sys-typescale-body-large); color: var(--md-sys-color-on-surface); line-height: 1.6; margin: 0 0 var(--space-4); }
  .pending-detail { font: var(--md-sys-typescale-body-medium); color: var(--md-sys-color-on-surface-variant); line-height: 1.5; margin: 0 0 var(--space-6); }
  .pending-status { font: var(--md-sys-typescale-body-small); color: var(--md-sys-color-on-surface-variant); min-height: 1.2em; margin-bottom: var(--space-4); }
  .pending-form { display: flex; justify-content: center; }

  .btn-secondary {
    font: var(--md-sys-typescale-label-large); color: var(--md-sys-color-primary);
    background: transparent; border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-full); padding: var(--space-2) var(--space-6);
    cursor: pointer;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-secondary:hover { background: var(--md-sys-color-surface-container-high); }
</style>
