---
/**
 * Notifications Page — Full listing with read/unread filter, pagination, actions.
 * Auth: required
 */
export const prerender = false;
import Base from '@/v2/layouts/Base.astro';

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

const filter = Astro.url.searchParams.get('filter') || 'all';
const page = Math.max(Number(Astro.url.searchParams.get('page')) || 1, 1);
const limit = 20;
const offset = (page - 1) * limit;

// Fetch notifications via internal API
let notifications: any[] = [];
let total = 0;
let unreadCount = 0;
let error: string | null = null;

try {
  const filterParam = filter === 'unread' ? '&filter=unread' : filter === 'read' ? '&filter=read' : '';
  const res = await fetch(new URL(`/api/notifications?limit=${limit}&offset=${offset}${filterParam}`, Astro.url), {
    headers: { cookie: Astro.request.headers.get('cookie') || '' },
  });
  if (res.ok) {
    const json = await res.json();
    notifications = json.data;
    total = json.total;
    unreadCount = json.unreadCount;
  } else {
    error = 'Failed to load notifications.';
  }
} catch {
  error = 'Network error loading notifications.';
}

const totalPages = Math.ceil(total / limit);
---

<Base title="Notifications — fanfiction.fyi" description="Your notifications">
  <section class="notifications-page">
    <h1 class="page-title">Notifications</h1>

    {error && <div class="error-banner" role="alert">{error}</div>}

    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <!-- Filter tabs -->
    <div class="filter-tabs">
      <a href="/notifications?filter=all" class:list={['filter-tab', filter === 'all' && 'filter-tab--active']}>
        All
      </a>
      <a href="/notifications?filter=unread" class:list={['filter-tab', filter === 'unread' && 'filter-tab--active']}>
        Unread{unreadCount > 0 ? ` (${unreadCount})` : ''}
      </a>
      <a href="/notifications?filter=read" class:list={['filter-tab', filter === 'read' && 'filter-tab--active']}>
        Read
      </a>
    </div>

    <!-- Bulk actions -->
    <div class="bulk-actions">
      <button class="btn-text" id="mark-all-read-btn">Mark all as read</button>
      <button class="btn-text btn-text--danger" id="delete-read-btn">Delete read notifications</button>
      <a href="/notifications/preferences" class="btn-text">Preferences</a>
    </div>

    <!-- Notification list -->
    <div class="notification-list" id="notification-list">
      {notifications.length === 0 ? (
        <div class="empty-state">No notifications to show.</div>
      ) : (
        notifications.map((n: any) => (
          <div class:list={['notification-item', !n.read && 'notification-item--unread']} data-id={n.id}>
            <div class="notification-content">
              {n.link ? (
                <a href={n.link} class="notification-link">
                  <p class="notification-title">{n.title}</p>
                </a>
              ) : (
                <p class="notification-title">{n.title}</p>
              )}
              {n.body && <p class="notification-body">{n.body}</p>}
              <span class="notification-time">{n.createdAt}</span>
            </div>
            <div class="notification-actions">
              {!n.read ? (
                <button class="icon-btn" data-action="mark-read" data-id={n.id} title="Mark as read" aria-label="Mark as read">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                </button>
              ) : (
                <button class="icon-btn" data-action="mark-unread" data-id={n.id} title="Mark as unread" aria-label="Mark as unread">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
                </button>
              )}
              <button class="icon-btn icon-btn--danger" data-action="delete" data-id={n.id} title="Delete" aria-label="Delete notification">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              </button>
            </div>
          </div>
        ))
      )}
    </div>

    <!-- Pagination -->
    {totalPages > 1 && (
      <nav class="pagination" aria-label="Notification pagination">
        {page > 1 && (
          <a href={`/notifications?filter=${filter}&page=${page - 1}`} class="pagination-btn">← Previous</a>
        )}
        <span class="pagination-info">Page {page} of {totalPages}</span>
        {page < totalPages && (
          <a href={`/notifications?filter=${filter}&page=${page + 1}`} class="pagination-btn">Next →</a>
        )}
      </nav>
    )}
  </section>
</Base>

<script>
  // Toast helper
  function showToast(message: string, type: 'success' | 'error' = 'success') {
    const toast = document.getElementById('toast')!;
    toast.textContent = message;
    toast.className = `toast toast--${type} toast--show`;
    setTimeout(() => { toast.className = 'toast'; }, 3000);
  }

  // Relative time formatting
  document.querySelectorAll('.notification-time').forEach((el) => {
    const dateStr = el.textContent;
    if (dateStr) {
      el.textContent = relativeTime(dateStr);
    }
  });

  function relativeTime(dateStr: string): string {
    const now = Date.now();
    const then = new Date(dateStr).getTime();
    const diff = Math.max(0, now - then);
    const mins = Math.floor(diff / 60_000);
    if (mins < 1) return 'just now';
    if (mins < 60) return `${mins}m ago`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return `${hrs}h ago`;
    const days = Math.floor(hrs / 24);
    if (days < 30) return `${days}d ago`;
    return new Date(dateStr).toLocaleDateString();
  }

  // Mark all as read
  document.getElementById('mark-all-read-btn')?.addEventListener('click', async () => {
    try {
      // Fetch all unread to mark them
      const res = await fetch('/api/notifications?limit=100&markRead=true&filter=unread');
      if (res.ok) {
        showToast('All notifications marked as read.');
        setTimeout(() => location.reload(), 500);
      } else {
        showToast('Failed to mark as read.', 'error');
      }
    } catch {
      showToast('Network error.', 'error');
    }
  });

  // Delete read notifications
  document.getElementById('delete-read-btn')?.addEventListener('click', async () => {
    if (!confirm('Delete all read notifications?')) return;
    try {
      const res = await fetch('/api/notifications?readOnly=true', { method: 'DELETE' });
      if (res.ok) {
        showToast('Read notifications deleted.');
        setTimeout(() => location.reload(), 500);
      } else {
        showToast('Failed to delete.', 'error');
      }
    } catch {
      showToast('Network error.', 'error');
    }
  });

  // Individual notification actions (delegation)
  document.getElementById('notification-list')?.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('.icon-btn') as HTMLElement | null;
    if (!btn) return;

    const action = btn.dataset.action;
    const id = btn.dataset.id;
    if (!action || !id) return;

    try {
      if (action === 'mark-read') {
        const res = await fetch(`/api/notifications/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ read: true }),
        });
        if (res.ok) {
          const item = btn.closest('.notification-item') as HTMLElement;
          item.classList.remove('notification-item--unread');
          showToast('Marked as read.');
          // Swap button
          btn.dataset.action = 'mark-unread';
          btn.title = 'Mark as unread';
          btn.setAttribute('aria-label', 'Mark as unread');
          btn.innerHTML = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>';
        }
      } else if (action === 'mark-unread') {
        const res = await fetch(`/api/notifications/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ read: false }),
        });
        if (res.ok) {
          const item = btn.closest('.notification-item') as HTMLElement;
          item.classList.add('notification-item--unread');
          showToast('Marked as unread.');
          btn.dataset.action = 'mark-read';
          btn.title = 'Mark as read';
          btn.setAttribute('aria-label', 'Mark as read');
          btn.innerHTML = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>';
        }
      } else if (action === 'delete') {
        const res = await fetch(`/api/notifications/${id}`, { method: 'DELETE' });
        if (res.ok) {
          const item = btn.closest('.notification-item') as HTMLElement;
          item.style.opacity = '0';
          setTimeout(() => item.remove(), 200);
          showToast('Notification deleted.');
        }
      }
    } catch {
      showToast('Network error.', 'error');
    }
  });
</script>

<style is:global>
  .notifications-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .page-title {
    font: var(--md-sys-typescale-headline-medium);
    margin: 0 0 var(--space-6) 0;
  }

  .error-banner {
    background: var(--md-sys-color-error);
    color: var(--md-sys-color-on-error);
    border-radius: var(--md-sys-shape-corner-small);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-6);
    font: var(--md-sys-typescale-body-medium);
  }

  /* ── Toast ─────────────────────────────────────── */
  .toast {
    position: fixed;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    border-radius: var(--md-sys-shape-corner-small);
    padding: var(--space-3) var(--space-6);
    font: var(--md-sys-typescale-body-medium);
    z-index: 1000;
    opacity: 0;
    transition: transform 0.3s var(--md-sys-motion-easing-standard), opacity 0.3s var(--md-sys-motion-easing-standard);
    pointer-events: none;
  }
  .toast--show {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }
  .toast--success {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }
  .toast--error {
    background: var(--md-sys-color-error);
    color: var(--md-sys-color-on-error);
  }

  /* ── Filter tabs ──────────────────────────────── */
  .filter-tabs {
    display: flex;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
  }

  .filter-tab {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
    text-decoration: none;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--md-sys-shape-corner-full) var(--md-sys-shape-corner-full) 0 0;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .filter-tab:hover {
    background: var(--md-sys-color-surface-container);
  }
  .filter-tab--active {
    color: var(--md-sys-color-primary);
    border-bottom-color: var(--md-sys-color-primary);
  }

  /* ── Bulk actions ─────────────────────────────── */
  .bulk-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .btn-text {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-primary);
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--md-sys-shape-corner-full);
    text-decoration: none;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-text:hover {
    background: var(--md-sys-color-surface-container);
  }
  .btn-text--danger {
    color: var(--md-sys-color-error);
  }

  /* ── Notification list ────────────────────────── */
  .notification-list {
    display: flex;
    flex-direction: column;
  }

  .notification-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    border-left: 3px solid transparent;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
                opacity var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .notification-item:hover {
    background: var(--md-sys-color-surface-container);
  }
  .notification-item--unread {
    border-left-color: var(--md-sys-color-primary);
    background: var(--md-sys-color-surface-container-low);
  }

  .notification-content {
    flex: 1;
    min-width: 0;
  }

  .notification-link {
    text-decoration: none;
    color: inherit;
  }
  .notification-link:hover .notification-title {
    text-decoration: underline;
  }

  .notification-title {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface);
    margin: 0 0 2px;
  }

  .notification-body {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-on-surface-variant);
    margin: 0 0 4px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .notification-time {
    font: var(--md-sys-typescale-label-small);
    color: var(--md-sys-color-outline);
  }

  .notification-actions {
    display: flex;
    gap: var(--space-1);
    flex-shrink: 0;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    background: none;
    border-radius: var(--md-sys-shape-corner-full);
    cursor: pointer;
    color: var(--md-sys-color-on-surface-variant);
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .icon-btn:hover {
    background: var(--md-sys-color-surface-container-high);
  }
  .icon-btn--danger {
    color: var(--md-sys-color-error);
  }

  .empty-state {
    padding: var(--space-12) var(--space-4);
    text-align: center;
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface-variant);
  }

  /* ── Pagination ───────────────────────────────── */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-6) 0;
  }

  .pagination-btn {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-primary);
    text-decoration: none;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--md-sys-shape-corner-full);
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .pagination-btn:hover {
    background: var(--md-sys-color-surface-container);
  }

  .pagination-info {
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
  }
</style>