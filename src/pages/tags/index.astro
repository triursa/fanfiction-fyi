---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { getDrizzle } from '../../lib/db';
import { tags, taggings } from '../../lib/schema';
import { sql, eq, desc } from 'drizzle-orm';

// SSR: fetch initial data for first paint
const db = getDrizzle(Astro.locals.runtime.env.DB as D1Database);
const initialTags = await db
  .select({
    id: tags.id,
    name: tags.name,
    type: tags.type,
    work_count: sql<number>`COUNT(${taggings.workId})`,
  })
  .from(tags)
  .leftJoin(taggings, eq(tags.id, taggings.tagId))
  .groupBy(tags.id)
  .orderBy(desc(sql`work_count`))
  .limit(100);
---

<Base title="Browse Tags — fanfiction.fyi">
  <div class="tags-page">
    <header class="tags-header">
      <h1 class="tags-title">Browse Tags</h1>

      <!-- Type filter chips -->
      <div class="filter-chips" id="filter-chips" role="tablist" aria-label="Filter by tag type" aria-controls="tag-grid">
        <button class="chip active" data-type="" role="tab" aria-selected="true">All</button>
        <button class="chip" data-type="fandom" role="tab" aria-selected="false">Fandom</button>
        <button class="chip" data-type="character" role="tab" aria-selected="false">Character</button>
        <button class="chip" data-type="relationship" role="tab" aria-selected="false">Relationship</button>
        <button class="chip" data-type="freeform" role="tab" aria-selected="false">Freeform</button>
        <button class="chip" data-type="rating" role="tab" aria-selected="false">Rating</button>
        <button class="chip" data-type="warning" role="tab" aria-selected="false">Warning</button>
        <button class="chip" data-type="category" role="tab" aria-selected="false">Category</button>
      </div>

      <!-- Search input -->
      <div class="search-bar">
        <label for="tag-search" class="sr-only">Search tags</label>
        <input
          type="text"
          id="tag-search"
          class="search-input"
          placeholder="Search tags by name…"
          autocomplete="off"
        />
      </div>
    </header>

    <!-- Tag grid (server-rendered initial, then client-updated) -->
    <div class="tag-grid" id="tag-grid" role="tabpanel" aria-label="Tag results">
      {initialTags.map(tag => (
        <a href={`/works?tag_id=${tag.id}`} class="tag-card" data-type={tag.type}>
          <span class="tag-name">{tag.name}</span>
          <span class={`tag-badge badge-${tag.type}`}>{tag.type}</span>
          <span class="tag-count">{tag.work_count} {tag.work_count === 1 ? 'work' : 'works'}</span>
        </a>
      ))}
    </div>

    <div class="tag-empty" id="tag-empty" style="display:none;" role="status">
      <p>No tags found matching your filters.</p>
    </div>
  </div>
</Base>

<style is:global>
  @import '../../styles/theme.css';

  .tags-page {
    padding: var(--space-4) 0;
  }

  .tags-header {
    margin-bottom: var(--space-6);
  }

  .tags-title {
    font: var(--md-sys-typescale-headline-large);
    color: var(--md-sys-color-on-surface);
    margin: 0 0 var(--space-6);
  }

  /* ── Filter Chips ── */
  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .chip {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
    background: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
                color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
                border-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
    user-select: none;
  }

  .chip:hover {
    background: var(--md-sys-color-surface-container-high);
  }

  .chip.active {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    border-color: transparent;
  }

  /* ── Search ── */
  .search-bar {
    max-width: 480px;
  }

  .search-input {
    width: 100%;
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
    background: var(--md-sys-color-surface-container-high);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-medium);
    padding: var(--space-3) var(--space-4);
    outline: none;
    transition: border-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .search-input::placeholder {
    color: var(--md-sys-color-outline);
  }

  .search-input:focus {
    border-color: var(--md-sys-color-primary);
  }

  /* ── Tag Grid ── */
  .tag-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-3);
  }

  .tag-card {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-medium);
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    color: var(--md-sys-color-on-surface);
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
                box-shadow var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .tag-card:hover {
    background: var(--md-sys-color-surface-container-high);
    box-shadow: var(--md-sys-elevation-1);
    text-decoration: none;
  }

  .tag-name {
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
    word-break: break-word;
  }

  .tag-badge {
    font: var(--md-sys-typescale-body-small);
    padding: 1px var(--space-2);
    border-radius: var(--md-sys-shape-corner-full);
    text-transform: capitalize;
    line-height: 1.2;
  }

  .tag-count {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-outline);
    margin-left: auto;
    white-space: nowrap;
  }

  /* ── Type badge accent colors (within Obsidian palette) ── */
  .badge-fandom {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  .badge-character {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }

  .badge-relationship {
    background: var(--md-sys-color-tertiary-container);
    color: var(--md-sys-color-on-tertiary-container);
  }

  .badge-freeform {
    background: var(--md-sys-color-surface-container-highest);
    color: var(--md-sys-color-on-surface-variant);
  }

  .badge-rating {
    background: #3D2F1D;
    color: #E8C88A;
  }

  .badge-warning {
    background: var(--md-sys-color-error-container);
    color: var(--md-sys-color-on-error-container);
  }

  .badge-category {
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface-variant);
  }

  /* ── Empty state ── */
  .tag-empty {
    text-align: center;
    padding: var(--space-10);
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-outline);
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .tag-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script define:vars={{ initialTags }}>
  const tagGrid = document.getElementById('tag-grid');
  const tagEmpty = document.getElementById('tag-empty');
  const searchInput = document.getElementById('tag-search');
  const chips = document.querySelectorAll('#filter-chips .chip');

  let currentType = '';
  let currentQ = '';
  let debounceTimer = null;

  // Render tag cards into the grid
  function renderTags(tags) {
    if (tags.length === 0) {
      tagGrid.innerHTML = '';
      tagEmpty.style.display = '';
      return;
    }
    tagEmpty.style.display = 'none';
    tagGrid.innerHTML = tags.map(tag => `
      <a href="/works?tag_id=${encodeURIComponent(tag.id)}" class="tag-card" data-type="${escapeHtml(tag.type)}">
        <span class="tag-name">${escapeHtml(tag.name)}</span>
        <span class="tag-badge badge-${escapeHtml(tag.type)}">${escapeHtml(tag.type)}</span>
        <span class="tag-count">${tag.work_count} ${tag.work_count === 1 ? 'work' : 'works'}</span>
      </a>
    `).join('');
  }

  // Quick HTML escape
  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // Fetch from browse API
  async function fetchTags() {
    const params = new URLSearchParams();
    if (currentType) params.set('type', currentType);
    if (currentQ) params.set('q', currentQ);
    try {
      const res = await fetch('/api/tags/browse?' + params.toString());
      if (res.ok) {
        const tags = await res.json();
        renderTags(tags);
      }
    } catch {
      // silently fail — keep existing content
    }
  }

  // Chip click handler
  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      chips.forEach(c => {
        c.classList.remove('active');
        c.setAttribute('aria-selected', 'false');
      });
      chip.classList.add('active');
      chip.setAttribute('aria-selected', 'true');
      currentType = chip.dataset.type;
      fetchTags();
    });
  });

  // Search input handler with debounce
  searchInput.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      currentQ = searchInput.value.trim();
      fetchTags();
    }, 300);
  });
</script>