---
/**
 * Studio: Edit Chapter — Edit chapter title, content, mood, draft status.
 * Auth: required (enforced by middleware default).
 */
export const prerender = false;
import Base from '@/v2/layouts/Base.astro';

const workId = Number(Astro.params.id);
const chapterId = Number(Astro.params.chapterId);
if (!workId || Number.isNaN(workId) || !chapterId || Number.isNaN(chapterId)) {
  return Astro.redirect('/studio');
}

// Fetch work and chapter data
let work: any = null;
let chapter: any = null;
let errorMsg: string | null = null;

try {
  const [workRes, chapterRes] = await Promise.all([
    fetch(new URL(`/api/works/${workId}`, Astro.url), {
      headers: { cookie: Astro.request.headers.get('cookie') || '' },
    }),
    fetch(new URL(`/api/works/${workId}/chapters/${chapterId}`, Astro.url), {
      headers: { cookie: Astro.request.headers.get('cookie') || '' },
    }),
  ]);

  if (workRes.ok) {
    work = (await workRes.json()).data;
  } else {
    return Astro.redirect('/studio');
  }

  if (chapterRes.ok) {
    chapter = (await chapterRes.json()).data;
  } else {
    return Astro.redirect(`/studio/${workId}/edit`);
  }
} catch {
  errorMsg = 'Failed to load chapter data.';
}

if (!chapter && !errorMsg) {
  return Astro.redirect(`/studio/${workId}/edit`);
}
---

<Base title={`Edit: ${chapter?.title ?? 'Chapter'} — ${work?.title ?? 'Work'} — fanfiction.fyi`} description="Edit chapter">
  <section class="studio-page">
    <div class="studio-header">
      <a href={`/studio/${workId}/edit`} class="back-link">← Back to {work?.title ?? 'Work'}</a>
      <h1 class="studio-title">Edit Chapter</h1>
    </div>

    {errorMsg && <p class="error-msg">{errorMsg}</p>}

    {chapter && (
      <form id="edit-chapter-form" class="chapter-form">
        <div class="form-field">
          <label for="title">Chapter Title</label>
          <input type="text" id="title" name="title" required maxlength="500" value={chapter.title ?? ''} />
        </div>

        <div class="form-field">
          <label for="contentMd">Content <span class="field-hint-inline">(Markdown)</span></label>
          <textarea id="contentMd" name="contentMd" rows="20" class="content-editor">{chapter.contentMd ?? ''}</textarea>
          <div class="word-count-bar">
            <span id="word-count" class="word-count">{chapter.contentMd ? chapter.contentMd.split(/\s+/).filter(Boolean).length : 0} words</span>
            <span class="field-hint">Supports Markdown syntax</span>
          </div>
        </div>

        <div class="form-row">
          <div class="form-field form-field-half">
            <label for="mood">Mood <span class="field-hint-inline">(optional)</span></label>
            <input type="text" id="mood" name="mood" maxlength="100" value={chapter.mood ?? ''} placeholder="e.g. melancholic, joyful, tense" />
          </div>

          <div class="form-field form-field-half">
            <label for="position">Position</label>
            <input type="number" id="position" name="position" min="1" value={chapter.position ?? 1} />
          </div>
        </div>

        <label class="toggle-label">
          <input type="checkbox" id="draft-toggle" checked={!!chapter.draft} />
          <span>Keep as Draft</span>
        </label>

        <div class="form-actions">
          <button type="submit" class="btn-filled" id="submit-btn">
            <span class="btn-text">Save Chapter</span>
            <span class="btn-loading" style="display:none;">Saving...</span>
          </button>
          <a href={`/studio/${workId}/edit`} class="btn-outlined">Cancel</a>
          <button type="button" id="delete-btn" class="btn-danger-outline">Delete Chapter</button>
        </div>

        <div id="form-error" class="form-error" role="alert"></div>
      </form>
    )}

    <!-- Delete confirmation dialog -->
    <dialog id="delete-dialog" class="delete-dialog">
      <form method="dialog">
        <h3>Delete this chapter?</h3>
        <p>This action cannot be undone. The chapter content will be permanently removed.</p>
        <div class="dialog-actions">
          <button type="submit" class="btn-outlined" value="cancel">Cancel</button>
          <button type="submit" class="btn-danger-filled" id="confirm-delete-btn" value="confirm">Delete</button>
        </div>
      </form>
    </dialog>
  </section>
</Base>

<script define:vars={{ workId, chapterId }}>
  // ─── Word count ────────────────────────────────────────────────────
  const contentEditor = document.getElementById('contentMd') as HTMLTextAreaElement;
  const wordCountEl = document.getElementById('word-count') as HTMLSpanElement;

  function updateWordCount() {
    const text = contentEditor.value.trim();
    const count = text ? text.split(/\s+/).filter(Boolean).length : 0;
    wordCountEl.textContent = count + ' words';
  }

  contentEditor.addEventListener('input', updateWordCount);

  // ─── Form submission ──────────────────────────────────────────────
  const form = document.getElementById('edit-chapter-form') as HTMLFormElement;
  const errorEl = document.getElementById('form-error') as HTMLElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.textContent = '';
    submitBtn.disabled = true;
    (submitBtn.querySelector('.btn-text') as HTMLElement).style.display = 'none';
    (submitBtn.querySelector('.btn-loading') as HTMLElement).style.display = 'inline';

    const title = (document.getElementById('title') as HTMLInputElement).value;
    const contentMd = contentEditor.value || null;
    const mood = (document.getElementById('mood') as HTMLInputElement).value || null;
    const draft = (document.getElementById('draft-toggle') as HTMLInputElement).checked;

    const body: Record<string, any> = { title, contentMd, mood, draft: draft };

    // Handle position change via reorder API
    const position = parseInt((document.getElementById('position') as HTMLInputElement).value, 10);
    // Position is handled separately — we'll note it for future reorder

    try {
      const res = await fetch(`/api/works/${workId}/chapters/${chapterId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });

      const data = await res.json();
      if (!res.ok) {
        errorEl.textContent = data.error || data.fields?.map((f: any) => `${f.field}: ${f.message}`).join(', ') || 'Failed to save chapter.';
        submitBtn.disabled = false;
        (submitBtn.querySelector('.btn-text') as HTMLElement).style.display = 'inline';
        (submitBtn.querySelector('.btn-loading') as HTMLElement).style.display = 'none';
        return;
      }

      window.location.href = `/studio/${workId}/edit`;
    } catch {
      errorEl.textContent = 'Network error. Please try again.';
      submitBtn.disabled = false;
      (submitBtn.querySelector('.btn-text') as HTMLElement).style.display = 'inline';
      (submitBtn.querySelector('.btn-loading') as HTMLElement).style.display = 'none';
    }
  });

  // ─── Delete chapter ────────────────────────────────────────────────
  const deleteBtn = document.getElementById('delete-btn') as HTMLButtonElement;
  const deleteDialog = document.getElementById('delete-dialog') as HTMLDialogElement;
  const confirmDeleteBtn = document.getElementById('confirm-delete-btn') as HTMLButtonElement;

  deleteBtn.addEventListener('click', () => deleteDialog.showModal());
  confirmDeleteBtn.addEventListener('click', async () => {
    try {
      const res = await fetch(`/api/works/${workId}/chapters/${chapterId}`, { method: 'DELETE' });
      if (res.ok) {
        window.location.href = `/studio/${workId}/edit`;
      } else {
        errorEl.textContent = 'Failed to delete chapter.';
      }
    } catch {
      errorEl.textContent = 'Network error.';
    }
  });
</script>

<style is:global>
  .studio-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .studio-header {
    margin-bottom: var(--space-8);
  }

  .back-link {
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-primary);
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--space-2);
  }

  .studio-title {
    font: var(--md-sys-typescale-headline-medium);
    margin: 0;
  }

  .chapter-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .form-field label {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
  }
  .form-field input,
  .form-field select,
  .form-field textarea {
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small);
    padding: var(--space-3) var(--space-4);
    outline: none;
    transition: border-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    border-color: var(--md-sys-color-primary);
  }
  .form-field textarea {
    resize: vertical;
  }

  .form-field-half {
    flex: 1;
  }

  .content-editor {
    font-family: 'Merriweather', serif !important;
    font-size: 1rem !important;
    line-height: 1.75;
    min-height: 400px;
  }

  .word-count-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-1);
  }

  .word-count {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-on-surface-variant);
  }

  .field-hint-inline {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-on-surface-variant);
    font-weight: 400;
  }

  .field-hint {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-on-surface-variant);
  }

  .form-row {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .toggle-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
    cursor: pointer;
  }
  .toggle-label input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: var(--md-sys-color-primary);
  }

  .form-actions {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-filled {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-primary);
    background: var(--md-sys-color-primary);
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-8);
    cursor: pointer;
    transition: opacity var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-filled:hover { opacity: 0.88; }
  .btn-filled:disabled { opacity: 0.5; cursor: not-allowed; }

  .btn-outlined {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-primary);
    background: transparent;
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-8);
    text-decoration: none;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-outlined:hover { background: var(--md-sys-color-primary-container); }

  .btn-danger-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-error);
    background: transparent;
    border: 1px solid var(--md-sys-color-error);
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-8);
    cursor: pointer;
    margin-left: auto;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-danger-outline:hover { background: #fce4ec; }

  .btn-danger-filled {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-error);
    background: var(--md-sys-color-error);
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-6);
    cursor: pointer;
  }
  .btn-danger-filled:hover { opacity: 0.9; }

  .form-error {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-error);
    min-height: 1.2em;
  }

  .error-msg {
    color: var(--md-sys-color-error);
    font: var(--md-sys-typescale-body-large);
  }

  /* Delete dialog */
  .delete-dialog {
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    padding: var(--space-6);
    background: var(--md-sys-color-surface);
    max-width: 400px;
  }
  .delete-dialog h3 {
    font: var(--md-sys-typescale-title-large);
    margin: 0 0 var(--space-4) 0;
  }
  .delete-dialog p {
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
    margin: 0 0 var(--space-6) 0;
  }
  .dialog-actions {
    display: flex;
    gap: var(--space-4);
    justify-content: flex-end;
  }
</style>