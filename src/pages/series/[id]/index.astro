---
/**
 * Series Detail Page — Public
 * Shows series title, description, creator pseud, status badge, and ordered works.
 * Route: /series/[id]
 */
export const prerender = false;
export const config = { auth: 'public' };
import Base from '@/v2/layouts/Base.astro';
import WorkCard from '@/v2/components/WorkCard.astro';

const seriesId = Number(Astro.params.id);
if (!seriesId || isNaN(seriesId)) {
  return Astro.redirect('/series');
}

let seriesData: any = null;
let works: any[] = [];
let errorMsg: string | null = null;

try {
  const res = await fetch(new URL(`/api/series/${seriesId}`, Astro.url));
  if (res.ok) {
    const json = await res.json();
    seriesData = json.data;
    works = json.data?.works || [];
  } else if (res.status === 404) {
    return Astro.redirect('/series');
  } else {
    errorMsg = 'Failed to load series.';
  }
} catch {
  errorMsg = 'Network error loading series.';
}

const user = Astro.locals.user;
const isOwner = user && seriesData && user.pseudIds?.includes(seriesData.creatorPseudId);

// Calculate total word count across works
const totalWords = works.reduce((sum: number, w: any) => sum + (w.wordCount || 0), 0);
---

<Base title={`${seriesData?.title || 'Series'} — fanfiction.fyi`} description={seriesData?.description || 'View this series on fanfiction.fyi'}>
  <section class="series-detail-page">
    {errorMsg && <div class="error-banner" role="alert">{errorMsg}</div>}

    {seriesData && (
      <>
        <a href="/series" class="back-link">← All Series</a>

        <div class="series-header">
          <div class="series-title-row">
            <h1 class="series-title">{seriesData.title}</h1>
            <span class:list={['status-badge', seriesData.complete ? 'status-badge--complete' : 'status-badge--wip']}>
              {seriesData.complete ? 'Complete' : 'WIP'}
            </span>
          </div>

          <div class="series-meta">
            {seriesData.creatorName && (
              <a href={`/pseuds/${seriesData.creatorPseudId}`} class="series-creator">by {seriesData.creatorName}</a>
            )}
            <span class="series-meta-item">{works.length} work{works.length !== 1 ? 's' : ''}</span>
            {totalWords > 0 && <span class="series-meta-item">{totalWords.toLocaleString()} words</span>}
            <span class="series-meta-item">Updated {new Date(seriesData.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
          </div>

          {seriesData.description && (
            <p class="series-desc">{seriesData.description}</p>
          )}

          {isOwner && (
            <div class="owner-actions">
              <a href={`/series/${seriesId}/edit`} class="btn-outlined">Edit Series</a>
              <button type="button" class="btn-danger" id="delete-btn">Delete Series</button>
            </div>
          )}
        </div>

        <!-- ── Works ──────────────────────────────────────────────── -->
        <div class="series-works">
          <h2 class="section-heading">Works {works.length > 0 && <span class="count-badge">{works.length}</span>}</h2>

          {works.length === 0 ? (
            <p class="empty-msg">This series doesn't have any works yet.</p>
          ) : (
            <div class="works-list">
              {works.map((w: any, i: number) => (
                <a href={`/works/${w.id}`} class="series-work-item">
                  <span class="work-position">{w.position ?? i + 1}.</span>
                  <div class="work-item-content">
                    <span class="work-item-title">{w.title}</span>
                    {w.wordCount > 0 && <span class="work-item-words">{w.wordCount.toLocaleString()} words</span>}
                  </div>
                </a>
              ))}
            </div>
          )}
        </div>
      </>
    )}
  </section>
</Base>

{isOwner && (
  <script define:vars={{ seriesId }}>
    const deleteBtn = document.getElementById('delete-btn');
    if (deleteBtn) {
      deleteBtn.addEventListener('click', async () => {
        if (!confirm('Are you sure you want to delete this series? This cannot be undone.')) return;
        deleteBtn.disabled = true;
        deleteBtn.textContent = 'Deleting…';
        try {
          const res = await fetch(`/api/series/${seriesId}`, { method: 'DELETE' });
          if (res.ok) {
            window.location.href = '/series';
          } else {
            const data = await res.json();
            alert(data.error || 'Failed to delete series.');
            deleteBtn.disabled = false;
            deleteBtn.textContent = 'Delete Series';
          }
        } catch {
          alert('Network error. Please try again.');
          deleteBtn.disabled = false;
          deleteBtn.textContent = 'Delete Series';
        }
      });
    }
  </script>
)}

<style is:global>
  .series-detail-page {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .back-link {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-primary);
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--space-4);
    transition: opacity var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .back-link:hover { opacity: 0.8; }

  .error-banner {
    background: var(--md-sys-color-error);
    color: var(--md-sys-color-on-error);
    border-radius: var(--md-sys-shape-corner-small);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-6);
    font: var(--md-sys-typescale-body-medium);
  }

  .series-header {
    margin-bottom: var(--space-8);
  }

  .series-title-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .series-title {
    font: var(--md-sys-typescale-headline-medium);
    margin: 0;
  }

  .status-badge {
    font: var(--md-sys-typescale-body-small);
    border-radius: var(--md-sys-shape-corner-full);
    padding: 2px 10px;
    flex-shrink: 0;
  }
  .status-badge--complete {
    color: #2e7d32;
    background: #e8f5e9;
  }
  .status-badge--wip {
    color: var(--md-sys-color-on-surface-variant);
    background: var(--md-sys-color-surface-container-highest);
  }

  .series-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-2);
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
  }

  .series-creator {
    color: var(--md-sys-color-primary);
    text-decoration: none;
  }
  .series-creator:hover { text-decoration: underline; }

  .series-meta-item {
    color: var(--md-sys-color-on-surface-variant);
  }

  .series-desc {
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface-variant);
    margin: var(--space-4) 0 0 0;
    line-height: 1.6;
    white-space: pre-wrap;
  }

  .owner-actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }

  .btn-outlined {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-primary);
    background: transparent;
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-8);
    text-decoration: none;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-outlined:hover { background: var(--md-sys-color-primary-container); }

  .btn-danger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-error);
    background: var(--md-sys-color-error);
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-8);
    cursor: pointer;
    transition: opacity var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-danger:hover { opacity: 0.88; }

  /* ── Works Section ─────────────────────────────────────────── */
  .series-works {
    padding-top: var(--space-4);
  }

  .section-heading {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
    margin: 0 0 var(--space-4) 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .count-badge {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    border-radius: var(--md-sys-shape-corner-full);
    padding: 2px 8px;
    font-size: 0.75rem;
  }

  .works-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .series-work-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small);
    text-decoration: none;
    color: var(--md-sys-color-on-surface);
    transition: border-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
                background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .series-work-item:hover {
    border-color: var(--md-sys-color-outline);
    background: var(--md-sys-color-surface-container-high);
  }

  .work-position {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
    min-width: 2ch;
    text-align: right;
  }

  .work-item-content {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex: 1;
    flex-wrap: wrap;
  }

  .work-item-title {
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-primary);
  }

  .work-item-words {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-on-surface-variant);
  }

  .empty-msg {
    color: var(--md-sys-color-on-surface-variant);
    font: var(--md-sys-typescale-body-large);
  }
</style>