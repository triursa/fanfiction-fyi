---
export const prerender = false;
import Base from '../../../layouts/Base.astro';
import { queryFirst, queryAll, run } from '../../../lib/db';
import { getAuth } from '../../../lib/auth';

const seriesId = Number(Astro.params.id);
if (!seriesId) return Astro.redirect('/series');

const db = Astro.locals.runtime.env.DB as D1Database;
const auth = await getAuth(db, Astro.request);
if (!auth) return Astro.redirect('/login');

const series = await queryFirst<any>(
  db,
  `SELECT s.*, p.name as creator_name FROM series s JOIN pseuds p ON s.creator_pseud_id = p.id WHERE s.id = ?1`,
  seriesId
);
if (!series) return Astro.redirect('/series');

// Check ownership
const isOwner = auth.pseuds.some((p: any) => p.id === series.creator_pseud_id);
if (!isOwner) return Astro.redirect(`/series/${seriesId}`);

// Get works in series
const seriesWorks = await queryAll<any>(
  db,
  `SELECT w.id, w.title, w.published_at, sw.position
   FROM serial_works sw JOIN works w ON w.id = sw.work_id
   WHERE sw.series_id = ?1 ORDER BY sw.position`,
  seriesId
);

// Get user's works NOT yet in this series (for adding)
const pseudIds = auth.pseuds.map((p: any) => p.id);
const availableWorks = await queryAll<any>(
  db,
  `SELECT w.id, w.title, w.published_at FROM works w
   JOIN creatorships c ON c.work_id = w.id
   WHERE c.pseud_id IN (${pseudIds.map(() => '?').join(',')})
   AND w.id NOT IN (SELECT work_id FROM serial_works WHERE series_id = ?)
   ORDER BY w.title`,
  ...pseudIds,
  seriesId
);

const pseuds = auth.pseuds;
const defaultPseud = pseuds[0]?.id ?? null;
---

<Base title={`Edit: ${series.title} — fanfiction.fyi`}>
  <section class="edit-series-page">
    <h1>Edit Series</h1>

    <!-- Metadata Section -->
    <form id="series-meta-form" class="series-form">
      <h2 class="section-subtitle">Details</h2>
      <div class="form-group">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" required value={series.title} class="input-field" />
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="4" class="input-field">{series.description || ''}</textarea>
      </div>

      <div class="form-group">
        <label for="complete">Status</label>
        <select id="complete" name="complete" class="input-field">
          <option value="0" selected={series.complete === 0}>Work in Progress</option>
          <option value="1" selected={series.complete === 1}>Complete</option>
        </select>
      </div>

      <div id="meta-error" class="form-error" style="display:none;"></div>

      <div class="form-actions">
        <button type="submit" class="btn-primary">Save Changes</button>
        <a href={`/series/${series.id}`} class="btn-secondary">Cancel</a>
      </div>
    </form>

    <!-- Works Section -->
    <div class="series-works-section">
      <h2 class="section-subtitle">Works in Series <span class="count-badge">{seriesWorks.length}</span></h2>

      {seriesWorks.length === 0 ? (
        <p class="placeholder-text">No works yet. Add some below.</p>
      ) : (
        <ol id="series-works-list" class="works-list" data-series-id={seriesId}>
          {seriesWorks.map((w: any) => (
            <li class="work-list-item" data-work-id={w.id} data-position={w.position}>
              <span class="work-position">{w.position}</span>
              <span class="work-title">{w.title}</span>
              {w.published_at === null && <span class="draft-badge">Draft</span>}
              <div class="work-item-actions">
                <button class="btn-icon move-up" title="Move up" aria-label="Move up" data-position={w.position} disabled={w.position === 1}>↑</button>
                <button class="btn-icon move-down" title="Move down" aria-label="Move down" data-position={w.position} disabled={w.position === seriesWorks.length}>↓</button>
                <button class="btn-icon remove-work" title="Remove from series" aria-label="Remove from series" data-work-id={w.id}>✕</button>
              </div>
            </li>
          ))}
        </ol>
      )}

      <!-- Add Work -->
      {availableWorks.length > 0 && (
        <div class="add-work-section">
          <h3 class="add-work-title">Add a Work</h3>
          <div class="add-work-row">
            <select id="add-work-select" class="input-field">
              {availableWorks.map((w: any) => <option value={w.id}>{w.title}{w.published_at === null ? ' (Draft)' : ''}</option>)}
            </select>
            <button id="add-work-btn" class="btn-primary" type="button">Add</button>
          </div>
        </div>
      )}

      {availableWorks.length === 0 && seriesWorks.length > 0 && (
        <p class="hint-text">All your published works are already in this series, or you have no more works to add.</p>
      )}
    </div>

    <!-- Danger Zone -->
    <div class="danger-zone">
      <h2 class="section-subtitle danger-title">Danger Zone</h2>
      <button id="delete-series-btn" class="btn-danger">Delete Series</button>
      <p class="danger-hint">Works will NOT be deleted — only the series grouping.</p>
    </div>
  </section>
</Base>

<style is:global>
  @import '../../../styles/theme.css';

  .edit-series-page { max-width: 720px; margin: 0 auto; padding: var(--space-6) 0; }
  .edit-series-page h1 { font: var(--md-sys-typescale-display-small); color: var(--md-sys-color-on-surface); margin: 0 0 var(--space-8); }
  .section-subtitle { font: var(--md-sys-typescale-title-large); color: var(--md-sys-color-on-surface); margin: 0 0 var(--space-4); display: flex; align-items: center; gap: var(--space-2); }
  .count-badge { font: var(--md-sys-typescale-label-small); background: var(--md-sys-color-secondary-container); color: var(--md-sys-color-on-secondary-container); padding: 2px var(--space-3); border-radius: var(--md-sys-shape-corner-full); }

  .series-form { display: flex; flex-direction: column; gap: var(--space-5); margin-bottom: var(--space-10); }
  .form-group { display: flex; flex-direction: column; gap: var(--space-2); }
  .form-group label { font: var(--md-sys-typescale-label-large); color: var(--md-sys-color-on-surface); }
  .input-field { font: var(--md-sys-typescale-body-large); color: var(--md-sys-color-on-surface); background: var(--md-sys-color-surface-container); border: 1px solid var(--md-sys-color-outline-variant); border-radius: var(--md-sys-shape-corner-medium); padding: var(--space-3) var(--space-4); }
  .input-field:focus { outline: none; border-color: var(--md-sys-color-primary); }
  textarea.input-field { resize: vertical; }

  .form-error { font: var(--md-sys-typescale-body-medium); color: var(--md-sys-color-error); background: var(--md-sys-color-error-container); border-radius: var(--md-sys-shape-corner-medium); padding: var(--space-3) var(--space-4); }
  .form-actions { display: flex; gap: var(--space-3); }

  .series-works-section { margin-bottom: var(--space-10); padding-top: var(--space-4); border-top: 1px solid var(--md-sys-color-outline-variant); }
  .placeholder-text { font: var(--md-sys-typescale-body-large); color: var(--md-sys-color-outline); font-style: italic; }
  .hint-text { font: var(--md-sys-typescale-body-medium); color: var(--md-sys-color-outline); }

  .works-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .work-list-item {
    display: flex; align-items: center; gap: var(--space-3);
    background: var(--md-sys-color-surface-container); border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-medium); padding: var(--space-3) var(--space-4);
  }
  .work-position { font: var(--md-sys-typescale-label-large); color: var(--md-sys-color-on-secondary-container); background: var(--md-sys-color-secondary-container); padding: 2px var(--space-3); border-radius: var(--md-sys-shape-corner-full); min-width: 2ch; text-align: center; }
  .work-title { font: var(--md-sys-typescale-body-large); color: var(--md-sys-color-on-surface); flex: 1; }
  .draft-badge { font: var(--md-sys-typescale-label-small); color: var(--md-sys-color-on-error-container); background: var(--md-sys-color-error-container); padding: 2px var(--space-2); border-radius: var(--md-sys-shape-corner-full); }
  .work-item-actions { display: flex; gap: var(--space-1); }
  .btn-icon { background: transparent; border: 1px solid var(--md-sys-color-outline-variant); border-radius: var(--md-sys-shape-corner-full); color: var(--md-sys-color-on-surface-variant); cursor: pointer; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; font-size: 14px; }
  .btn-icon:disabled { opacity: 0.3; cursor: not-allowed; }
  .btn-icon:not(:disabled):hover { background: var(--md-sys-color-surface-container-high); }

  .add-work-section { margin-top: var(--space-6); padding: var(--space-4); background: var(--md-sys-color-surface-container); border-radius: var(--md-sys-shape-corner-medium); }
  .add-work-title { font: var(--md-sys-typescale-title-medium); margin: 0 0 var(--space-3); }
  .add-work-row { display: flex; gap: var(--space-3); }
  .add-work-row select { flex: 1; }

  .danger-zone { margin-top: var(--space-10); padding-top: var(--space-6); border-top: 1px solid var(--md-sys-color-error); }
  .danger-title { color: var(--md-sys-color-error); }
  .danger-hint { font: var(--md-sys-typescale-body-small); color: var(--md-sys-color-outline); margin-top: var(--space-2); }

  .btn-primary { font: var(--md-sys-typescale-label-large); color: var(--md-sys-color-on-primary); background: var(--md-sys-color-primary); border: none; border-radius: var(--md-sys-shape-corner-full); padding: var(--space-3) var(--space-6); cursor: pointer; }
  .btn-secondary { font: var(--md-sys-typescale-label-large); color: var(--md-sys-color-primary); background: transparent; border: 1px solid var(--md-sys-color-outline); border-radius: var(--md-sys-shape-corner-full); padding: var(--space-3) var(--space-6); cursor: pointer; text-decoration: none; display: inline-block; }
  .btn-danger { font: var(--md-sys-typescale-label-large); color: var(--md-sys-color-on-error); background: var(--md-sys-color-error); border: none; border-radius: var(--md-sys-shape-corner-full); padding: var(--space-3) var(--space-6); cursor: pointer; }
</style>

<script define:vars={{ seriesId }}>
  // ─── Save metadata ───
  const metaForm = document.getElementById('series-meta-form');
  const metaError = document.getElementById('meta-error');
  metaForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (metaError) metaError.style.display = 'none';

    const title = (document.getElementById('title')).value.trim();
    const description = (document.getElementById('description')).value.trim();
    const complete = (document.getElementById('complete')).value === '1';

    try {
      const res = await fetch(`/api/series/${seriesId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, description, complete }),
      });
      if (res.ok) {
        // Update page title subtly
        document.querySelector('.edit-series-page h1').textContent = 'Edit: ' + title;
        const savedEl = document.createElement('span');
        savedEl.textContent = ' ✓ Saved';
        savedEl.style.color = 'var(--md-sys-color-primary)';
        savedEl.style.fontWeight = '400';
        metaForm.querySelector('.form-actions').appendChild(savedEl);
        setTimeout(() => savedEl.remove(), 2000);
      } else {
        const data = await res.json();
        if (metaError) { metaError.textContent = data.error || 'Failed to save'; metaError.style.display = 'block'; }
      }
    } catch {
      if (metaError) { metaError.textContent = 'Network error'; metaError.style.display = 'block'; }
    }
  });

  // ─── Remove work from series ───
  document.querySelectorAll('.remove-work').forEach(btn => {
    btn.addEventListener('click', async () => {
      const workId = btn.dataset.workId;
      if (!confirm('Remove this work from the series?')) return;
      try {
        const res = await fetch(`/api/series/${seriesId}/works`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ work_id: Number(workId) }),
        });
        if (res.ok) window.location.reload();
      } catch { /* silently fail */ }
    });
  });

  // ─── Move work up/down ───
  async function swapPositions(posA, posB) {
    // We need to swap: set both positions then reload
    // Use a simple approach: PUT with reordered array
    // Actually, let's use position-based swaps via the add/remove approach
    // For simplicity, we'll just update position fields directly
    try {
      // Get current list
      const res = await fetch(`/api/series/${seriesId}`);
      const data = await res.json();
      const works = data.series.works;

      // Find and swap
      const workA = works.find(w => w.series_position === posA);
      const workB = works.find(w => w.series_position === posB);
      if (!workA || !workB) return;

      // Remove both, re-add in swapped order using position
      await fetch(`/api/series/${seriesId}/works`, {
        method: 'DELETE', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ work_id: workA.id }),
      });
      await fetch(`/api/series/${seriesId}/works`, {
        method: 'DELETE', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ work_id: workB.id }),
      });

      // Re-add in swapped positions
      await fetch(`/api/series/${seriesId}/works`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ work_id: workB.id, position: posA }),
      });
      await fetch(`/api/series/${seriesId}/works`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ work_id: workA.id, position: posB }),
      });

      window.location.reload();
    } catch { /* silently fail */ }
  }

  document.querySelectorAll('.move-up').forEach(btn => {
    btn.addEventListener('click', () => {
      const pos = Number(btn.dataset.position);
      if (pos > 1) swapPositions(pos, pos - 1);
    });
  });

  document.querySelectorAll('.move-down').forEach(btn => {
    btn.addEventListener('click', () => {
      const pos = Number(btn.dataset.position);
      const totalItems = document.querySelectorAll('.work-list-item').length;
      if (pos < totalItems) swapPositions(pos, pos + 1);
    });
  });

  // ─── Add work to series ───
  const addBtn = document.getElementById('add-work-btn');
  const addSelect = document.getElementById('add-work-select');
  addBtn?.addEventListener('click', async () => {
    const workId = Number(addSelect.value);
    if (!workId) return;
    try {
      const res = await fetch(`/api/series/${seriesId}/works`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ work_id: workId }),
      });
      if (res.ok || res.status === 201) {
        window.location.reload();
      } else {
        const data = await res.json();
        alert(data.error || 'Failed to add work');
      }
    } catch { alert('Failed to add work'); }
  });

  // ─── Delete series ───
  const deleteBtn = document.getElementById('delete-series-btn');
  deleteBtn?.addEventListener('click', async () => {
    if (!confirm('Delete this series? Works will NOT be deleted.')) return;
    try {
      const res = await fetch(`/api/series/${seriesId}`, { method: 'DELETE' });
      if (res.ok) window.location.href = '/series';
      else alert('Failed to delete series');
    } catch { alert('Failed to delete series'); }
  });
</script>