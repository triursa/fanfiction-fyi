---
/**
 * New Series Page — Auth Required
 * Form to create a series: title, description, pseud.
 */
export const prerender = false;
// Auth required — default middleware enforces login
import Base from '@/v2/layouts/Base.astro';

const user = Astro.locals.user;

// Fetch user's pseuds for the pseud selector
let pseuds: any[] = [];
try {
  const res = await fetch(new URL(`/api/pseuds?limit=100&userId=${user.id}`, Astro.url), {
    headers: { cookie: Astro.request.headers.get('cookie') || '' },
  });
  if (res.ok) {
    const json = await res.json();
    pseuds = json.data ?? [];
  }
} catch {
  // Non-fatal — form will still render without pseuds
}
---

<Base title="New Series — fanfiction.fyi" description="Create a new series on fanfiction.fyi">
  <section class="form-page">
    <div class="form-header">
      <a href="/series" class="back-link">← Back to Series</a>
      <h1 class="form-title">New Series</h1>
    </div>

    <form id="new-series-form" class="series-form">
      <div class="form-field">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" required maxlength="500" placeholder="My Series Title" />
      </div>

      <div class="form-field">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="5" maxlength="5000" placeholder="Describe what this series is about…"></textarea>
      </div>

      <div class="form-field">
        <label for="pseudId">Post As</label>
        <select id="pseudId" name="pseudId" required>
          {pseuds.length === 0 ? (
            <option value="">No pseuds available</option>
          ) : (
            pseuds.map((p: any) => (
              <option value={p.id} selected={p.isDefault}>{p.name}</option>
            ))
          )}
        </select>
        {pseuds.length === 0 && (
          <p class="field-hint">You need a pseud to create a series. <a href="/settings">Create one in settings</a>.</p>
        )}
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-filled" id="submit-btn">
          <span class="btn-text">Create Series</span>
          <span class="btn-loading" style="display:none;">Creating…</span>
        </button>
        <a href="/series" class="btn-outlined">Cancel</a>
      </div>

      <div id="form-error" class="form-error" role="alert"></div>
    </form>
  </section>
</Base>

<script>
  function initNewSeriesForm() {
    const form = document.getElementById('new-series-form') as HTMLFormElement | null;
    const errorEl = document.getElementById('form-error') as HTMLElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    if (!form || !errorEl || !submitBtn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.textContent = '';
      submitBtn.disabled = true;
      (submitBtn.querySelector('.btn-text') as HTMLElement).style.display = 'none';
      (submitBtn.querySelector('.btn-loading') as HTMLElement).style.display = 'inline';

      const title = (document.getElementById('title') as HTMLInputElement).value.trim();
      const description = (document.getElementById('description') as HTMLTextAreaElement).value || undefined;
      const pseudId = Number((document.getElementById('pseudId') as HTMLSelectElement).value);

      if (!pseudId) {
        errorEl.textContent = 'Please select a pseudonym.';
        submitBtn.disabled = false;
        (submitBtn.querySelector('.btn-text') as HTMLElement).style.display = 'inline';
        (submitBtn.querySelector('.btn-loading') as HTMLElement).style.display = 'none';
        return;
      }

      try {
        const res = await fetch('/api/series', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, description, pseudId }),
        });

        const data = await res.json();
        if (!res.ok) {
          errorEl.textContent = data.error || data.fields?.map((f: any) => `${f.field}: ${f.message}`).join(', ') || 'Failed to create series.';
          submitBtn.disabled = false;
          (submitBtn.querySelector('.btn-text') as HTMLElement).style.display = 'inline';
          (submitBtn.querySelector('.btn-loading') as HTMLElement).style.display = 'none';
          return;
        }

        window.location.href = `/series/${data.data.id}`;
      } catch {
        errorEl.textContent = 'Network error. Please try again.';
        submitBtn.disabled = false;
        (submitBtn.querySelector('.btn-text') as HTMLElement).style.display = 'inline';
        (submitBtn.querySelector('.btn-loading') as HTMLElement).style.display = 'none';
      }
    });
  }
  initNewSeriesForm();
  document.addEventListener('astro:after-swap', initNewSeriesForm);
</script>

<style is:global>
  .form-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .form-header {
    margin-bottom: var(--space-8);
  }

  .back-link {
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-primary);
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--space-2);
  }

  .form-title {
    font: var(--md-sys-typescale-headline-medium);
    margin: 0 0 var(--space-4) 0;
  }

  .series-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .form-field label {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
  }
  .form-field input,
  .form-field select,
  .form-field textarea {
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small);
    padding: var(--space-3) var(--space-4);
    outline: none;
    transition: border-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    border-color: var(--md-sys-color-primary);
  }
  .form-field textarea {
    resize: vertical;
    min-height: 100px;
  }

  .field-hint {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-on-surface-variant);
    margin: var(--space-1) 0 0 0;
  }
  .field-hint a { color: var(--md-sys-color-primary); }

  .form-actions {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-filled {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-primary);
    background: var(--md-sys-color-primary);
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-8);
    cursor: pointer;
    transition: opacity var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-filled:hover { opacity: 0.88; }
  .btn-filled:disabled { opacity: 0.5; cursor: not-allowed; }

  .btn-outlined {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-primary);
    background: transparent;
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-8);
    text-decoration: none;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-outlined:hover { background: var(--md-sys-color-primary-container); }

  .form-error {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-error);
    min-height: 1.2em;
  }
</style>