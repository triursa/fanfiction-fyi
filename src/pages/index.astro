---
export const prerender = false;
export const config = { auth: 'optional' };
import Base from '@/v2/layouts/Base.astro';
import WorkCard from '@/v2/components/WorkCard.astro';

const user = Astro.locals.user;

// SSR data fetch — recently updated works (always shown)
let recentWorks: any[] = [];
let recentError: string | null = null;
try {
  const recentRes = await fetch(new URL('/api/works?sort=updated&limit=10', Astro.url));
  if (recentRes.ok) {
    const recentJson = await recentRes.json();
    recentWorks = recentJson.data ?? [];
  } else {
    recentError = 'Failed to load recent works.';
  }
} catch {
  recentError = 'Network error loading recent works.';
}

// Authenticated: continue reading + marked for later
let continueReading: any[] = [];
let markedForLater: any[] = [];
if (user) {
  try {
    // Use the request cookie so the session is forwarded
    const readingsRes = await fetch(new URL('/api/readings', Astro.url), {
      headers: { cookie: Astro.request.headers.get('cookie') ?? '' },
    });
    if (readingsRes.ok) {
      const readingsJson = await readingsRes.json();
      const all = readingsJson.data ?? [];
      continueReading = all.filter((r: any) => r.lastChapter && !r.forLater);
      markedForLater = all.filter((r: any) => r.forLater);
    }
  } catch {
    // Non-fatal — continue without reading data
  }
}
---

<Base title="fanfiction.fyi — A home for transformative fiction" description="Read, write, and share transformative fiction. A modern archive built by fans, for fans.">
  <!-- ─── Hero ────────────────────────────────────────── -->
  <section class="hero">
    <h1 class="hero-title">A home for transformative fiction</h1>
    <p class="hero-subtitle">Read, write, and share stories. Built by fans, for fans.</p>
    <div class="hero-actions">
      <a href="/works" class="btn-filled">Browse Works</a>
      {user ? (
        <a href="/studio" class="btn-outlined">Post a Work</a>
      ) : (
        <a href="/signup" class="btn-outlined">Request Invite</a>
      )}
    </div>
  </section>

  <!-- ─── Navigation cards ────────────────────────────── -->
  <section class="nav-cards">
    <a href="/works" class="nav-card">
      <span class="nav-card-icon">📖</span>
      <span class="nav-card-label">Browse Works</span>
    </a>
    <a href="/studio" class="nav-card">
      <span class="nav-card-icon">✏️</span>
      <span class="nav-card-label">Post a Work</span>
    </a>
    <a href="/tags" class="nav-card">
      <span class="nav-card-icon">🏷️</span>
      <span class="nav-card-label">Tags</span>
    </a>
    <a href="/collections" class="nav-card">
      <span class="nav-card-icon">📁</span>
      <span class="nav-card-label">Collections</span>
    </a>
    <a href="/series" class="nav-card">
      <span class="nav-card-icon">📚</span>
      <span class="nav-card-label">Series</span>
    </a>
  </section>

  <!-- ─── Continue Reading (authenticated) ──────────── -->
  {user && continueReading.length > 0 && (
    <section class="section">
      <h2 class="section-title">Continue Reading</h2>
      <div class="works-grid">
        {continueReading.map((r: any) => r.work && (
          <WorkCard work={r.work} />
        ))}
      </div>
    </section>
  )}

  <!-- ─── Marked for Later (authenticated) ───────────── -->
  {user && markedForLater.length > 0 && (
    <section class="section">
      <h2 class="section-title">Marked for Later</h2>
      <div class="works-grid">
        {markedForLater.map((r: any) => r.work && (
          <WorkCard work={r.work} />
        ))}
      </div>
    </section>
  )}

  <!-- ─── Recently Updated ───────────────────────────── -->
  <section class="section">
    <h2 class="section-title">Recently Updated</h2>
    {recentError ? (
      <p class="error-msg">{recentError}</p>
    ) : recentWorks.length === 0 ? (
      <p class="empty-msg">No works yet. Be the first to post!</p>
    ) : (
      <div class="works-grid">
        {recentWorks.map((w: any) => (
          <WorkCard work={w} />
        ))}
      </div>
    )}
  </section>
</Base>

<style is:global>
  .hero {
    text-align: center;
    padding: var(--space-16) var(--space-4) var(--space-8);
    max-width: 48rem;
    margin: 0 auto;
  }

  .hero-title {
    font: var(--md-sys-typescale-headline-medium);
    margin: 0 0 var(--space-4) 0;
  }

  .hero-subtitle {
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface-variant);
    margin: 0 0 var(--space-6) 0;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .btn-filled {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-primary);
    background: var(--md-sys-color-primary);
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-6);
    text-decoration: none;
    transition: opacity var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-filled:hover { opacity: 0.88; }

  .btn-outlined {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-primary);
    background: transparent;
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-6);
    text-decoration: none;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-outlined:hover { background: var(--md-sys-color-primary-container); }

  /* ─── Nav Cards ──────────────────────────────────── */
  .nav-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-4);
    max-width: 48rem;
    margin: 0 auto var(--space-12);
    padding: 0 var(--space-4);
  }

  .nav-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    padding: var(--space-6) var(--space-4);
    text-decoration: none;
    color: var(--md-sys-color-on-surface);
    transition: border-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
                box-shadow var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .nav-card:hover {
    border-color: var(--md-sys-color-outline);
    box-shadow: 0 1px 3px 0 rgba(0,0,0,.1);
  }

  .nav-card-icon {
    font-size: 1.75rem;
  }

  .nav-card-label {
    font: var(--md-sys-typescale-label-large);
  }

  /* ─── Sections ─────────────────────────────────────── */
  .section {
    max-width: 72rem;
    margin: 0 auto var(--space-12);
    padding: 0 var(--space-4);
  }

  .section-title {
    font: var(--md-sys-typescale-title-large);
    margin: 0 0 var(--space-4) 0;
  }

  .works-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .works-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .error-msg {
    color: var(--md-sys-color-error);
    font: var(--md-sys-typescale-body-medium);
  }

  .empty-msg {
    color: var(--md-sys-color-on-surface-variant);
    font: var(--md-sys-typescale-body-medium);
  }
</style>