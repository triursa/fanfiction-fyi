---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { THEMES } from '../../styles/themes';

// Auth check via cookie (server-side redirect guard)
const cookie = Astro.request.headers.get('cookie') ?? '';
const sessionMatch = cookie.match(/session=([a-f0-9]+)/);
let currentTheme = 'obsidian';
let authed = false;

if (sessionMatch) {
  const db = Astro.locals.runtime.env.DB as D1Database;
  const session = await db.prepare('SELECT user_id FROM sessions WHERE token = ? AND expires_at > CURRENT_TIMESTAMP').bind(sessionMatch[1]).first();
  if (session) {
    const user = await db.prepare('SELECT theme FROM users WHERE id = ?').bind(session.user_id).first();
    if (user && user.theme) {
      currentTheme = user.theme as string;
    }
    authed = true;
  }
}

if (!authed) {
  return Astro.redirect('/login');
}

const themeList = Object.values(THEMES);

// Serialize theme colors for client-side use
const themesJSON = JSON.stringify(
  Object.fromEntries(
    Object.entries(THEMES).map(([key, val]) => [key, val.colors])
  )
);
---

<Base title="Settings — fanfiction.fyi">
  <article class="settings-page">
    <h1>Settings</h1>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--  SECTION 1: Profile                                -->
    <!-- ═══════════════════════════════════════════════════ -->
    <section class="settings-card" id="profile-section">
      <h2 class="card-title">Profile</h2>
      <p class="card-subtitle">Manage your public profile information.</p>

      <div class="form-group">
        <label for="display-name" class="form-label">Display Name</label>
        <input type="text" id="display-name" class="form-input" placeholder="Your display name" />
      </div>

      <div class="form-group">
        <label for="bio" class="form-label">Bio</label>
        <textarea id="bio" class="form-textarea" rows="3" maxlength="500" placeholder="Tell others about yourself..."></textarea>
        <span class="form-hint" id="bio-counter">0 / 500</span>
      </div>

      <div class="form-group">
        <label class="form-label">Avatar</label>
        <div class="avatar-upload-area">
          <div class="avatar-preview" id="avatar-preview">
            <img id="avatar-preview-img" src="" alt="Avatar preview" />
            <span id="avatar-preview-fallback" class="avatar-fallback">?</span>
          </div>
          <div class="avatar-upload-actions">
            <label for="avatar-file" class="btn-outlined avatar-upload-btn">Upload Image</label>
            <input type="file" id="avatar-file" accept="image/gif,image/png,image/jpeg,image/webp" style="display:none" />
            <button type="button" class="btn-text btn-text--danger" id="avatar-remove-btn" style="display:none">Remove</button>
            <span class="form-hint">GIF, PNG, JPG, or WebP. Max 5 MB.</span>
          </div>
        </div>
        <details class="avatar-url-details">
          <summary class="avatar-url-summary">Use a URL instead</summary>
          <div class="avatar-input-row">
            <input type="text" id="avatar-url" class="form-input" placeholder="https://example.com/avatar.png" />
          </div>
        </details>
      </div>

      <div class="form-group">
        <label class="form-label">Reading Font Size</label>
        <div class="segmented-control" id="font-size-group" role="radiogroup" aria-label="Reading font size">
          <button type="button" class="seg-btn" data-value="small" role="radio" aria-checked="false">Small</button>
          <button type="button" class="seg-btn" data-value="default" role="radio" aria-checked="true">Default</button>
          <button type="button" class="seg-btn" data-value="large" role="radio" aria-checked="false">Large</button>
          <button type="button" class="seg-btn" data-value="xlarge" role="radio" aria-checked="false">X-Large</button>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Email Visibility</label>
        <div class="radio-group" id="email-visibility-group" role="radiogroup" aria-label="Email visibility">
          <label class="radio-option">
            <input type="radio" name="email_visibility" value="public" />
            <span class="radio-label">
              <strong>Public</strong>
              <span class="radio-desc">Anyone can see your email address.</span>
            </span>
          </label>
          <label class="radio-option">
            <input type="radio" name="email_visibility" value="mutual" />
            <span class="radio-label">
              <strong>Mutual</strong>
              <span class="radio-desc">Only users you follow can see your email.</span>
            </span>
          </label>
          <label class="radio-option">
            <input type="radio" name="email_visibility" value="private" />
            <span class="radio-label">
              <strong>Private</strong>
              <span class="radio-desc">No one can see your email address.</span>
            </span>
          </label>
        </div>
      </div>

      <div class="form-actions">
        <button type="button" class="btn-filled" id="save-profile-btn">Save Profile</button>
        <span class="inline-feedback" id="profile-feedback"></span>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--  SECTION 2: Aliases (Pseuds)                       -->
    <!-- ═══════════════════════════════════════════════════ -->
    <section class="settings-card" id="aliases-section">
      <h2 class="card-title">Aliases</h2>
      <p class="card-subtitle">Pseuds are pen names you write under. You can have multiple — one for each fandom or persona.</p>

      <div id="pseuds-list" class="pseuds-list">
        <!-- Populated by JS -->
      </div>

      <div class="pseud-add-form" id="pseud-add-form">
        <h3 class="subsection-title" style="margin-top:0; border-top:none; padding-top:0;">Add Alias</h3>
        <div class="form-group">
          <label for="new-pseud-name" class="form-label">Name</label>
          <input type="text" id="new-pseud-name" class="form-input" placeholder="e.g. DarkElfWriter" maxlength="100" />
        </div>
        <div class="form-group">
          <label for="new-pseud-desc" class="form-label">Description <span class="form-hint" style="display:inline">(optional)</span></label>
          <input type="text" id="new-pseud-desc" class="form-input" placeholder="A short blurb about this pseud" maxlength="200" />
        </div>
        <div class="form-actions">
          <button type="button" class="btn-filled" id="add-pseud-btn">Add Alias</button>
          <span class="inline-feedback" id="add-pseud-feedback"></span>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--  SECTION 3: Account                                -->
    <!-- ═══════════════════════════════════════════════════ -->
    <section class="settings-card" id="account-section">
      <h2 class="card-title">Account</h2>
      <p class="card-subtitle">Manage your account security and linked services.</p>

      <!-- Email (display only) -->
      <div class="form-group">
        <label class="form-label">Email</label>
        <div class="static-field" id="account-email">
          <span id="email-value">—</span>
          <span class="form-hint" id="email-visibility-note"></span>
        </div>
      </div>

      <!-- Password -->
      <div class="form-group" id="password-section">
        <h3 class="subsection-title" id="password-title">Password</h3>

        <div id="current-password-row" class="form-group" style="display:none">
          <label for="current-password" class="form-label">Current Password</label>
          <input type="password" id="current-password" class="form-input" autocomplete="current-password" />
        </div>

        <div class="form-group">
          <label for="new-password" class="form-label">New Password</label>
          <input type="password" id="new-password" class="form-input" autocomplete="new-password" />
        </div>

        <div class="form-group">
          <label for="confirm-password" class="form-label">Confirm Password</label>
          <input type="password" id="confirm-password" class="form-input" autocomplete="new-password" />
        </div>

        <div class="form-actions">
          <button type="button" class="btn-filled" id="save-password-btn">Save Password</button>
          <span class="inline-feedback" id="password-feedback"></span>
        </div>
      </div>

      <!-- Google Account -->
      <div class="form-group" id="google-section">
        <h3 class="subsection-title">Google Account</h3>
        <div id="google-linked" style="display:none">
          <div class="google-status">
            <span class="google-badge google-badge--linked">Linked ✓</span>
            <img id="google-avatar" class="google-avatar" src="" alt="Google avatar" style="display:none" />
          </div>
          <p class="form-hint">Your account is linked to Google. You can sign in with Google or your password.</p>
          <div class="form-actions">
            <button type="button" class="btn-outlined btn-danger" id="unlink-google-btn">Unlink Google</button>
            <span class="inline-feedback" id="google-feedback"></span>
          </div>
          <p class="form-warning" id="unlink-warning" style="display:none">⚠️ You must set a password before unlinking Google.</p>
        </div>
        <div id="google-unlinked" style="display:none">
          <p class="form-hint">Link your Google account for easier sign-in.</p>
          <div class="form-actions">
            <button type="button" class="btn-filled" id="link-google-btn">Link Google Account</button>
            <span class="inline-feedback" id="google-feedback"></span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--  SECTION 4: Theme                                  -->
    <!-- ═══════════════════════════════════════════════════ -->
    <section class="settings-card">
      <h2 class="card-title">Theme</h2>
      <p class="card-subtitle">Choose a color palette for the site.</p>
      <p class="form-hint" style="margin-top:0">Font size also affects reading experience.</p>
      <div class="theme-grid">
        {themeList.map((theme) => (
          <button
            class={`theme-swatch ${theme.name === currentTheme ? 'theme-swatch--active' : ''}`}
            data-theme={theme.name}
            style={`--swatch-primary: ${theme.colors['--md-sys-color-primary']}; --swatch-surface: ${theme.colors['--md-sys-color-surface']}; --swatch-on-surface: ${theme.colors['--md-sys-color-on-surface']}; --swatch-surface-container: ${theme.colors['--md-sys-color-surface-container']};`}
          >
            <div class="swatch-preview"></div>
            <span class="swatch-label">{theme.label}</span>
            {theme.name === currentTheme && <span class="swatch-check">✓</span>}
          </button>
        ))}
      </div>
    </section>
  </article>
</Base>

<!-- Theme colors data injected via set:html (Astro doesn't interpolate inside <script> tags) -->
<div id="ff-themes-json" style="display:none" set:html={themesJSON} />

<!-- Toast notification container -->
<div id="toast-container"></div>

<!-- ═══════════════════════════════════════════════════════ -->
<!--  Edit Pseud Modal (hidden by default)                  -->
<!-- ═══════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="pseud-edit-modal" style="display:none" role="dialog" aria-modal="true" aria-label="Edit alias">
  <div class="modal-card">
    <h3 class="modal-title">Edit Alias</h3>
    <input type="hidden" id="edit-pseud-id" />
    <div class="form-group">
      <label class="form-label">Icon</label>
      <div class="pseud-icon-upload">
        <div class="pseud-icon-preview" id="edit-pseud-icon-preview">
          <img id="edit-pseud-icon-img" src="" alt="Pseud icon" />
          <span id="edit-pseud-icon-fallback" class="avatar-fallback">?</span>
        </div>
        <div class="pseud-icon-actions">
          <label for="edit-pseud-icon-file" class="btn-outlined pseud-icon-btn">Upload</label>
          <input type="file" id="edit-pseud-icon-file" accept="image/gif,image/png,image/jpeg,image/webp" style="display:none" />
          <button type="button" class="btn-text btn-text--danger" id="edit-pseud-icon-remove" style="display:none">Remove</button>
        </div>
      </div>
    </div>
    <div class="form-group">
      <label for="edit-pseud-name" class="form-label">Name</label>
      <input type="text" id="edit-pseud-name" class="form-input" maxlength="100" />
    </div>
    <div class="form-group">
      <label for="edit-pseud-desc" class="form-label">Description <span class="form-hint" style="display:inline">(optional)</span></label>
      <input type="text" id="edit-pseud-desc" class="form-input" maxlength="200" />
    </div>
    <div class="form-actions">
      <button type="button" class="btn-filled" id="save-pseud-btn">Save</button>
      <button type="button" class="btn-outlined" id="cancel-pseud-btn">Cancel</button>
      <span class="inline-feedback" id="edit-pseud-feedback"></span>
    </div>
  </div>
</div>

<script is:inline>
  // ─── User data state ────────────────────────────────────
  var userData = null;

  // ─── Toast system ───────────────────────────────────────
  function showToast(message, type) {
    type = type || 'success';
    var container = document.getElementById('toast-container');
    var toast = document.createElement('div');
    toast.className = 'toast toast--' + type;
    toast.textContent = message;
    container.appendChild(toast);
    // Trigger entrance
    requestAnimationFrame(function() {
      toast.classList.add('toast--visible');
    });
    // Auto-dismiss
    setTimeout(function() {
      toast.classList.remove('toast--visible');
      setTimeout(function() { toast.remove(); }, 300);
    }, 3000);
  }

  // ─── Inline feedback helper ──────────────────────────────
  function setFeedback(el, message, isError) {
    if (!el) return;
    el.textContent = message;
    el.className = 'inline-feedback ' + (isError ? 'feedback-error' : 'feedback-success');
    if (message) {
      setTimeout(function() { el.textContent = ''; el.className = 'inline-feedback'; }, 4000);
    }
  }

  // ─── Escape HTML for safe innerHTML insertion ─────────────
  function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  // ─── Read theme colors from hidden data element ─────────
  var themeColors = JSON.parse(document.getElementById('ff-themes-json').textContent || '{}');

  function applyThemeClientSide(themeName) {
    var colors = themeColors[themeName];
    if (!colors) return;
    var root = document.documentElement;
    for (var token in colors) {
      root.style.setProperty(token, colors[token]);
    }
    document.body.dataset.theme = themeName;
    try { localStorage.setItem('ff-theme', themeName); } catch (_) {}
  }

  // ─── Theme swatch click handlers ────────────────────────
  document.querySelectorAll('.theme-swatch').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var theme = btn.dataset.theme;
      if (!theme) return;
      fetch('/api/user/theme', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ theme: theme }),
      }).then(function(res) {
        if (res.ok) {
          applyThemeClientSide(theme);
          document.querySelectorAll('.theme-swatch').forEach(function(b) {
            b.classList.remove('theme-swatch--active');
          });
          btn.classList.add('theme-swatch--active');
          document.querySelectorAll('.swatch-check').forEach(function(c) { c.remove(); });
          var check = document.createElement('span');
          check.className = 'swatch-check';
          check.textContent = '\u2713';
          btn.appendChild(check);
          showToast('Theme updated!');
        }
      });
    });
  });

  // ─── Bio character counter ──────────────────────────────
  var bioTextarea = document.getElementById('bio');
  var bioCounter = document.getElementById('bio-counter');
  bioTextarea.addEventListener('input', function() {
    var len = bioTextarea.value.length;
    bioCounter.textContent = len + ' / 500';
    if (len > 480) {
      bioCounter.classList.add('counter-warning');
    } else {
      bioCounter.classList.remove('counter-warning');
    }
  });

  // ─── Avatar preview ─────────────────────────────────────
  var avatarInput = document.getElementById('avatar-url');
  var avatarPreviewImg = document.getElementById('avatar-preview-img');
  var avatarPreviewFallback = document.getElementById('avatar-preview-fallback');

  function updateAvatarPreview(url) {
    if (url) {
      avatarPreviewImg.src = url;
      avatarPreviewImg.style.display = 'block';
      avatarPreviewFallback.style.display = 'none';
      avatarPreviewImg.onerror = function() {
        avatarPreviewImg.style.display = 'none';
        avatarPreviewFallback.style.display = '';
      };
    } else {
      avatarPreviewImg.style.display = 'none';
      avatarPreviewFallback.style.display = '';
    }
  }

  avatarInput.addEventListener('input', function() {
    updateAvatarPreview(avatarInput.value.trim());
  });

  // ─── Avatar file upload ───────────────────────────────────
  var avatarFileInput = document.getElementById('avatar-file');
  var avatarRemoveBtn = document.getElementById('avatar-remove-btn');
  var currentAvatarKey = null; // tracks R2 key if uploaded

  function resolveAvatarUrl(user) {
    // R2-uploaded avatar takes precedence, then avatar_url (Google/manual), then fallback
    if (user.avatar_key) return '/api/storage/' + encodeURIComponent(user.avatar_key);
    if (user.avatar_url) return user.avatar_url;
    return null;
  }

  avatarFileInput.addEventListener('change', function() {
    var file = avatarFileInput.files[0];
    if (!file) return;

    // Validate type
    var allowedTypes = ['image/gif', 'image/png', 'image/jpeg', 'image/webp'];
    if (allowedTypes.indexOf(file.type) === -1) {
      showToast('Invalid file type. Use GIF, PNG, JPG, or WebP.', 'error');
      return;
    }
    // Validate size (5MB)
    if (file.size > 5 * 1024 * 1024) {
      showToast('File too large. Maximum 5 MB.', 'error');
      return;
    }

    var formData = new FormData();
    formData.append('file', file);
    formData.append('type', 'avatar');

    fetch('/api/upload', { method: 'POST', body: formData })
      .then(function(res) { return res.json().then(function(d) { return { ok: res.ok, data: d }; }); })
      .then(function(result) {
        if (result.ok) {
          currentAvatarKey = result.data.key;
          updateAvatarPreview(result.data.url);
          avatarRemoveBtn.style.display = '';
          showToast('Avatar uploaded!');
        } else {
          showToast(result.data.error || 'Upload failed.', 'error');
        }
      })
      .catch(function() { showToast('Network error during upload.', 'error'); });
  });

  avatarRemoveBtn.addEventListener('click', function() {
    fetch('/api/upload', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ type: 'avatar' }),
    })
    .then(function(res) { return res.json().then(function(d) { return { ok: res.ok, data: d }; }); })
    .then(function(result) {
      if (result.ok) {
        currentAvatarKey = null;
        updateAvatarPreview(null);
        avatarRemoveBtn.style.display = 'none';
        avatarFileInput.value = '';
        showToast('Avatar removed.');
      } else {
        showToast(result.data.error || 'Failed to remove avatar.', 'error');
      }
    })
    .catch(function() { showToast('Network error.', 'error'); });
  });

  // ─── Segmented button (font size) ───────────────────────
  var fontSizeGroup = document.getElementById('font-size-group');
  var currentFontSize = 'default';

  function setFontSize(value) {
    currentFontSize = value;
    fontSizeGroup.querySelectorAll('.seg-btn').forEach(function(b) {
      const isActive = b.dataset.value === value;
      b.classList.toggle('seg-btn--active', isActive);
      b.setAttribute('aria-checked', String(isActive));
    });
  }

  fontSizeGroup.querySelectorAll('.seg-btn').forEach(function(b) {
    b.addEventListener('click', function() {
      setFontSize(b.dataset.value);
    });
  });

  // ─── Save Profile ───────────────────────────────────────
  var saveProfileBtn = document.getElementById('save-profile-btn');
  var profileFeedback = document.getElementById('profile-feedback');

  saveProfileBtn.addEventListener('click', function() {
    var displayName = document.getElementById('display-name').value.trim();
    var bio = document.getElementById('bio').value;
    var avatarUrl = document.getElementById('avatar-url').value.trim();
    var emailVisEl = document.querySelector('input[name="email_visibility"]:checked');
    var emailVisibility = emailVisEl ? emailVisEl.value : 'private';

    saveProfileBtn.disabled = true;
    setFeedback(profileFeedback, 'Saving…', false);

    fetch('/api/user/profile', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        display_name: displayName || null,
        bio: bio,
        avatar_url: avatarUrl || null,
        avatar_key: currentAvatarKey || null,
        email_visibility: emailVisibility,
        reading_font_size: currentFontSize,
      }),
    })
    .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data }; }); })
    .then(function(result) {
      saveProfileBtn.disabled = false;
      if (result.ok) {
        setFeedback(profileFeedback, 'Profile saved!', false);
        showToast('Profile updated!');
      } else {
        setFeedback(profileFeedback, result.data.error || 'Failed to save profile.', true);
      }
    })
    .catch(function() {
      saveProfileBtn.disabled = false;
      setFeedback(profileFeedback, 'Network error. Please try again.', true);
    });
  });

  // ─── Save Password ──────────────────────────────────────
  var savePasswordBtn = document.getElementById('save-password-btn');
  var passwordFeedback = document.getElementById('password-feedback');

  savePasswordBtn.addEventListener('click', function() {
    var currentPassword = document.getElementById('current-password').value;
    var newPassword = document.getElementById('new-password').value;
    var confirmPassword = document.getElementById('confirm-password').value;

    if (!newPassword) {
      setFeedback(passwordFeedback, 'Please enter a new password.', true);
      return;
    }
    if (newPassword !== confirmPassword) {
      setFeedback(passwordFeedback, 'Passwords do not match.', true);
      return;
    }

    savePasswordBtn.disabled = true;
    setFeedback(passwordFeedback, 'Saving…', false);

    fetch('/api/user/password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        current_password: currentPassword,
        new_password: newPassword,
      }),
    })
    .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, status: res.status, data: data }; }); })
    .then(function(result) {
      savePasswordBtn.disabled = false;
      if (result.ok) {
        setFeedback(passwordFeedback, 'Password updated!', false);
        showToast('Password updated!');
        document.getElementById('current-password').value = '';
        document.getElementById('new-password').value = '';
        document.getElementById('confirm-password').value = '';
        // Update state: now has password
        if (userData) {
          userData.has_password = true;
          updatePasswordFieldVisibility();
          updateUnlinkWarning();
        }
      } else {
        setFeedback(passwordFeedback, result.data.error || 'Failed to update password.', true);
      }
    })
    .catch(function() {
      savePasswordBtn.disabled = false;
      setFeedback(passwordFeedback, 'Network error. Please try again.', true);
    });
  });

  // ─── Google linking ─────────────────────────────────────
  var linkGoogleBtn = document.getElementById('link-google-btn');
  var unlinkGoogleBtn = document.getElementById('unlink-google-btn');
  var googleFeedback = document.getElementById('google-feedback');

  linkGoogleBtn.addEventListener('click', function() {
    setFeedback(googleFeedback, 'Redirecting to Google…', false);
    fetch('/api/auth/google/link', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
    })
    .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, status: res.status, data: data }; }); })
    .then(function(result) {
      if (result.ok && result.data.url) {
        window.location.href = result.data.url;
      } else {
        setFeedback(googleFeedback, result.data.error || 'Failed to initiate Google linking.', true);
      }
    })
    .catch(function() {
      setFeedback(googleFeedback, 'Network error. Please try again.', true);
    });
  });

  unlinkGoogleBtn.addEventListener('click', function() {
    if (!confirm('Unlink your Google account? You will no longer be able to sign in with Google.')) return;
    setFeedback(googleFeedback, 'Unlinking…', false);
    fetch('/api/auth/google/link', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
    })
    .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, status: res.status, data: data }; }); })
    .then(function(result) {
      if (result.ok) {
        showToast('Google account unlinked.');
        document.getElementById('google-linked').style.display = 'none';
        document.getElementById('google-unlinked').style.display = '';
        if (userData) { userData.google_linked = false; }
      } else {
        if (result.status === 403) {
          document.getElementById('unlink-warning').style.display = '';
          setFeedback(googleFeedback, 'You must set a password first.', true);
        } else {
          setFeedback(googleFeedback, result.data.error || 'Failed to unlink Google.', true);
        }
      }
    })
    .catch(function() {
      setFeedback(googleFeedback, 'Network error. Please try again.', true);
    });
  });

  // ─── Password field visibility based on has_password ────
  function updatePasswordFieldVisibility() {
    if (!userData) return;
    var title = document.getElementById('password-title');
    var currentRow = document.getElementById('current-password-row');
    if (userData.has_password) {
      title.textContent = 'Change Password';
      currentRow.style.display = '';
    } else {
      title.textContent = 'Set Password';
      currentRow.style.display = 'none';
    }
  }

  function updateUnlinkWarning() {
    var warning = document.getElementById('unlink-warning');
    if (userData && !userData.has_password) {
      warning.style.display = '';
    } else {
      warning.style.display = 'none';
    }
  }

  // ─── Google section visibility ──────────────────────────
  function updateGoogleSection() {
    if (!userData) return;
    if (userData.google_linked) {
      document.getElementById('google-linked').style.display = '';
      document.getElementById('google-unlinked').style.display = 'none';
      if (userData.avatar_url) {
        var gAvatar = document.getElementById('google-avatar');
        gAvatar.src = userData.avatar_url;
        gAvatar.style.display = '';
      }
    } else {
      document.getElementById('google-linked').style.display = 'none';
      document.getElementById('google-unlinked').style.display = '';
    }
  }

  // ═════════════════════════════════════════════════════════
  //  PSEUDS / ALIASES MANAGEMENT
  // ═════════════════════════════════════════════════════════
  var pseudsList = document.getElementById('pseuds-list');
  var pseudsData = [];

  function renderPseuds() {
    if (!pseudsData || pseudsData.length === 0) {
      pseudsList.innerHTML = '<div class="pseuds-empty" role="status">No aliases yet. Add one below.</div>';
      return;
    }
    var html = '';
    pseudsData.forEach(function(p) {
      var iconUrl = p.icon_key ? '/api/storage/' + encodeURIComponent(p.icon_key) : null;
      html += '<div class="pseud-card" data-pseud-id="' + p.id + '">';
      html += '  <div class="pseud-info">';
      if (iconUrl) {
        html += '    <img class="pseud-icon" src="' + escapeHtml(iconUrl) + '" alt="" />';
      }
      html += '    <span class="pseud-name">' + escapeHtml(p.name) + '</span>';
      if (p.description) {
        html += '    <span class="pseud-desc">' + escapeHtml(p.description) + '</span>';
      }
      html += '  </div>';
      html += '  <div class="pseud-actions">';
      html += '    <button type="button" class="btn-icon pseud-edit-btn" data-pseud-id="' + p.id + '" title="Edit" aria-label="Edit ' + escapeHtml(p.name) + '">';
      html += '      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>';
      html += '    </button>';
      html += '    <button type="button" class="btn-icon btn-icon--danger pseud-delete-btn" data-pseud-id="' + p.id + '" data-pseud-name="' + escapeHtml(p.name) + '" title="Delete" aria-label="Delete ' + escapeHtml(p.name) + '">';
      html += '      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>';
      html += '    </button>';
      html += '  </div>';
      html += '</div>';
    });
    pseudsList.innerHTML = html;

    // Bind edit buttons
    pseudsList.querySelectorAll('.pseud-edit-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var pseudId = parseInt(btn.dataset.pseudId, 10);
        var pseud = pseudsData.find(function(p) { return p.id === pseudId; });
        if (!pseud) return;
        openEditModal(pseud);
      });
    });

    // Bind delete buttons
    pseudsList.querySelectorAll('.pseud-delete-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var pseudId = parseInt(btn.dataset.pseudId, 10);
        var pseudName = btn.dataset.pseudName;
        deletePseud(pseudId, pseudName);
      });
    });
  }

  function loadPseuds() {
    fetch('/api/pseuds')
      .then(function(res) { return res.json(); })
      .then(function(data) {
        pseudsData = Array.isArray(data) ? data : [];
        renderPseuds();
      })
      .catch(function(err) {
        console.error('Failed to load pseuds:', err);
      });
  }

  // ─── Add new pseud ────────────────────────────────────
  var addPseudBtn = document.getElementById('add-pseud-btn');
  var addPseudFeedback = document.getElementById('add-pseud-feedback');

  addPseudBtn.addEventListener('click', function() {
    var name = document.getElementById('new-pseud-name').value.trim();
    var desc = document.getElementById('new-pseud-desc').value.trim();

    if (!name) {
      setFeedback(addPseudFeedback, 'Name is required.', true);
      return;
    }

    addPseudBtn.disabled = true;
    setFeedback(addPseudFeedback, 'Adding…', false);

    fetch('/api/pseuds', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: name, description: desc || null }),
    })
    .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data }; }); })
    .then(function(result) {
      addPseudBtn.disabled = false;
      if (result.ok) {
        document.getElementById('new-pseud-name').value = '';
        document.getElementById('new-pseud-desc').value = '';
        setFeedback(addPseudFeedback, 'Alias added!', false);
        showToast('Alias created!');
        loadPseuds();
      } else {
        setFeedback(addPseudFeedback, result.data.error || 'Failed to add alias.', true);
      }
    })
    .catch(function() {
      addPseudBtn.disabled = false;
      setFeedback(addPseudFeedback, 'Network error.', true);
    });
  });

  // ─── Edit modal ───────────────────────────────────────
  var editModal = document.getElementById('pseud-edit-modal');
  var savePseudBtn = document.getElementById('save-pseud-btn');
  var cancelPseudBtn = document.getElementById('cancel-pseud-btn');
  var editPseudFeedback = document.getElementById('edit-pseud-feedback');

  var editingPseudIconKey = null; // tracks current R2 key for pseud icon being edited

  function openEditModal(pseud) {
    document.getElementById('edit-pseud-id').value = pseud.id;
    document.getElementById('edit-pseud-name').value = pseud.name || '';
    document.getElementById('edit-pseud-desc').value = pseud.description || '';
    editingPseudIconKey = pseud.icon_key || null;

    // Update icon preview
    var iconImg = document.getElementById('edit-pseud-icon-img');
    var iconFallback = document.getElementById('edit-pseud-icon-fallback');
    var iconRemoveBtn = document.getElementById('edit-pseud-icon-remove');
    if (pseud.icon_key) {
      iconImg.src = '/api/storage/' + encodeURIComponent(pseud.icon_key);
      iconImg.style.display = 'block';
      iconFallback.style.display = 'none';
      iconRemoveBtn.style.display = '';
    } else {
      iconImg.style.display = 'none';
      iconFallback.style.display = '';
      iconRemoveBtn.style.display = 'none';
    }

    editPseudFeedback.textContent = '';
    editPseudFeedback.className = 'inline-feedback';
    editModal.style.display = '';
    document.getElementById('edit-pseud-name').focus();
  }

  function closeEditModal() {
    editModal.style.display = 'none';
  }

  cancelPseudBtn.addEventListener('click', closeEditModal);

  // ─── Pseud icon upload ──────────────────────────────────────
  var pseudIconFileInput = document.getElementById('edit-pseud-icon-file');

  pseudIconFileInput.addEventListener('change', function() {
    var file = pseudIconFileInput.files[0];
    if (!file) return;

    var allowedTypes = ['image/gif', 'image/png', 'image/jpeg', 'image/webp'];
    if (allowedTypes.indexOf(file.type) === -1) {
      showToast('Invalid file type. Use GIF, PNG, JPG, or WebP.', 'error');
      return;
    }
    if (file.size > 5 * 1024 * 1024) {
      showToast('File too large. Maximum 5 MB.', 'error');
      return;
    }

    var pseudId = document.getElementById('edit-pseud-id').value;
    if (!pseudId) return;

    var formData = new FormData();
    formData.append('file', file);
    formData.append('type', 'pseud');
    formData.append('id', pseudId);

    fetch('/api/upload', { method: 'POST', body: formData })
      .then(function(res) { return res.json().then(function(d) { return { ok: res.ok, data: d }; }); })
      .then(function(result) {
        if (result.ok) {
          editingPseudIconKey = result.data.key;
          var iconImg = document.getElementById('edit-pseud-icon-img');
          var iconFallback = document.getElementById('edit-pseud-icon-fallback');
          var iconRemoveBtn = document.getElementById('edit-pseud-icon-remove');
          iconImg.src = result.data.url;
          iconImg.style.display = 'block';
          iconFallback.style.display = 'none';
          iconRemoveBtn.style.display = '';
          showToast('Icon uploaded!');
        } else {
          showToast(result.data.error || 'Upload failed.', 'error');
        }
      })
      .catch(function() { showToast('Network error during upload.', 'error'); });
  });

  document.getElementById('edit-pseud-icon-remove').addEventListener('click', function() {
    var pseudId = document.getElementById('edit-pseud-id').value;
    if (!pseudId) return;

    fetch('/api/upload', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ type: 'pseud', id: parseInt(pseudId, 10) }),
    })
    .then(function(res) { return res.json().then(function(d) { return { ok: res.ok, data: d }; }); })
    .then(function(result) {
      if (result.ok) {
        editingPseudIconKey = null;
        var iconImg = document.getElementById('edit-pseud-icon-img');
        var iconFallback = document.getElementById('edit-pseud-icon-fallback');
        var iconRemoveBtn = document.getElementById('edit-pseud-icon-remove');
        iconImg.style.display = 'none';
        iconFallback.style.display = '';
        iconRemoveBtn.style.display = 'none';
        pseudIconFileInput.value = '';
        showToast('Icon removed.');
      } else {
        showToast(result.data.error || 'Failed to remove icon.', 'error');
      }
    })
    .catch(function() { showToast('Network error.', 'error'); });
  });

  // Close modal on overlay click
  editModal.addEventListener('click', function(e) {
    if (e.target === editModal) closeEditModal();
  });

  // Close modal on Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && editModal.style.display !== 'none') closeEditModal();
  });

  savePseudBtn.addEventListener('click', function() {
    var pseudId = document.getElementById('edit-pseud-id').value;
    var name = document.getElementById('edit-pseud-name').value.trim();
    var desc = document.getElementById('edit-pseud-desc').value.trim();

    if (!name) {
      setFeedback(editPseudFeedback, 'Name is required.', true);
      return;
    }

    savePseudBtn.disabled = true;
    setFeedback(editPseudFeedback, 'Saving…', false);

    fetch('/api/pseuds/' + encodeURIComponent(pseudId), {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: name, description: desc || null }),
    })
    .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data }; }); })
    .then(function(result) {
      savePseudBtn.disabled = false;
      if (result.ok) {
        setFeedback(editPseudFeedback, 'Alias updated!', false);
        showToast('Alias updated!');
        closeEditModal();
        loadPseuds();
      } else {
        setFeedback(editPseudFeedback, result.data.error || 'Failed to update alias.', true);
      }
    })
    .catch(function() {
      savePseudBtn.disabled = false;
      setFeedback(editPseudFeedback, 'Network error.', true);
    });
  });

  // ─── Delete pseud ──────────────────────────────────────
  function deletePseud(pseudId, pseudName) {
    if (!confirm('Delete alias "' + pseudName + '"? Comments, kudos, bookmarks, and reading progress under this name will also be removed.')) return;

    fetch('/api/pseuds/' + encodeURIComponent(pseudId), {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
    })
    .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, status: res.status, data: data }; }); })
    .then(function(result) {
      if (result.ok) {
        showToast('Alias deleted.');
        loadPseuds();
      } else {
        showToast(result.data.error || 'Failed to delete alias.', 'error');
      }
    })
    .catch(function() {
      showToast('Network error.', 'error');
    });
  }

  // ─── Load user profile from /api/auth/me ────────────────
  fetch('/api/auth/me')
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (!data || !data.user) return;
      userData = data.user;

      // Profile fields
      document.getElementById('display-name').value = userData.display_name || '';
      document.getElementById('bio').value = userData.bio || '';
      // Trigger counter
      bioCounter.textContent = (userData.bio || '').length + ' / 500';
      document.getElementById('avatar-url').value = userData.avatar_url || '';
      var avatarUrl = resolveAvatarUrl(userData);
      updateAvatarPreview(avatarUrl);
      currentAvatarKey = userData.avatar_key || null;
      if (userData.avatar_key || userData.avatar_url) {
        avatarRemoveBtn.style.display = '';
      }

      // Font size
      setFontSize(userData.reading_font_size || 'default');

      // Email visibility
      var visValue = userData.email_visibility || 'private';
      var visRadio = document.querySelector('input[name="email_visibility"][value="' + visValue + '"]');
      if (visRadio) visRadio.checked = true;

      // Account section
      document.getElementById('email-value').textContent = userData.email || '—';
      var visNote = document.getElementById('email-visibility-note');
      var visLabels = { public: 'visible to everyone', mutual: 'visible to mutuals', private: 'hidden' };
      visNote.textContent = '(' + (visLabels[visValue] || 'hidden') + ')';

      // Password section
      updatePasswordFieldVisibility();

      // Google section
      updateGoogleSection();
      updateUnlinkWarning();
    })
    .catch(function(err) {
      console.error('Failed to load user profile:', err);
    });

  // ─── Load pseuds ─────────────────────────────────────
  loadPseuds();

  // ─── Check URL params for Google redirect feedback ──────
  (function() {
    var params = new URLSearchParams(window.location.search);
    if (params.get('linked') === 'true') {
      showToast('Google account linked successfully!');
      // Clean the URL
      window.history.replaceState({}, document.title, window.location.pathname);
    }
    if (params.get('error') === 'google_already_linked') {
      showToast('That Google account is already linked to another user.', 'error');
      window.history.replaceState({}, document.title, window.location.pathname);
    }
  })();
</script>

<style>
  /* ═══════════════════════════════════════════════════════ */
  /*  Layout & Card                                        */
  /* ═══════════════════════════════════════════════════════ */
  .settings-page {
    max-width: var(--reading-width, 65ch);
    margin: 0 auto;
    padding: var(--space-4, 16px);
  }

  .settings-page h1 {
    color: var(--md-sys-color-on-surface);
    font-size: var(--md-sys-typescale-headline-large-size, 32px);
    margin-bottom: var(--space-6, 24px);
  }

  .settings-card {
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large, 16px);
    padding: var(--space-6, 24px);
    margin-bottom: var(--space-6, 24px);
  }

  .card-title {
    color: var(--md-sys-color-on-surface);
    font-size: var(--md-sys-typescale-title-large-size, 22px);
    margin: 0 0 var(--space-1, 4px) 0;
  }

  .card-subtitle {
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-body-medium-size, 14px);
    margin: 0 0 var(--space-5, 20px) 0;
  }

  .subsection-title {
    color: var(--md-sys-color-on-surface);
    font-size: var(--md-sys-typescale-title-medium-size, 16px);
    font-weight: 600;
    margin: var(--space-4, 16px) 0 var(--space-2, 8px) 0;
    padding-top: var(--space-3, 12px);
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  .subsection-title:first-of-type {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }

  /* ═══════════════════════════════════════════════════════ */
  /*  Form elements                                       */
  /* ═══════════════════════════════════════════════════════ */
  .form-group {
    margin-bottom: var(--space-4, 16px);
  }

  .form-label {
    display: block;
    color: var(--md-sys-color-on-surface);
    font-size: var(--md-sys-typescale-label-large-size, 14px);
    font-weight: 500;
    margin-bottom: var(--space-1, 4px);
  }

  .form-input,
  .form-textarea {
    width: 100%;
    box-sizing: border-box;
    background: var(--md-sys-color-surface-container-high);
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-small, 8px);
    color: var(--md-sys-color-on-surface);
    font-family: 'Inter', sans-serif;
    font-size: var(--md-sys-typescale-body-large-size, 16px);
    padding: var(--space-3, 12px) var(--space-4, 16px);
    outline: none;
    transition: border-color 200ms;
  }

  .form-input:focus,
  .form-textarea:focus {
    border-color: var(--md-sys-color-primary);
  }

  .form-textarea {
    resize: vertical;
    min-height: 80px;
  }

  .form-hint {
    display: block;
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-body-small-size, 12px);
    margin-top: var(--space-1, 4px);
  }

  .form-warning {
    display: block;
    color: var(--md-sys-color-error);
    font-size: var(--md-sys-typescale-body-small-size, 12px);
    margin-top: var(--space-2, 8px);
  }

  .counter-warning {
    color: var(--md-sys-color-error);
  }

  .static-field {
    background: var(--md-sys-color-surface-container-high);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small, 8px);
    padding: var(--space-3, 12px) var(--space-4, 16px);
    color: var(--md-sys-color-on-surface);
    font-size: var(--md-sys-typescale-body-large-size, 16px);
  }

  .static-field .form-hint {
    margin-top: var(--space-1, 4px);
    font-size: var(--md-sys-typescale-body-small-size, 12px);
    color: var(--md-sys-color-on-surface-variant);
  }

  /* ═══════════════════════════════════════════════════════ */
  /*  Avatar input row                                    */
  /* ═══════════════════════════════════════════════════════ */
  .avatar-input-row {
    display: flex;
    gap: var(--space-3, 12px);
    align-items: flex-start;
  }

  .avatar-input-row .form-input {
    flex: 1;
  }

  .avatar-preview {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--md-sys-color-surface-container-highest);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar-fallback {
    color: var(--md-sys-color-on-surface-variant);
    font-size: 20px;
    font-weight: 600;
  }

  .avatar-upload-area {
    display: flex;
    gap: var(--space-3, 12px);
    align-items: flex-start;
  }

  .avatar-upload-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-1, 4px);
  }

  .avatar-upload-btn {
    cursor: pointer;
    font-size: var(--md-sys-typescale-label-medium-size, 12px);
  }

  .avatar-url-details {
    margin-top: var(--space-2, 8px);
  }

  .avatar-url-summary {
    color: var(--md-sys-color-primary);
    font-size: var(--md-sys-typescale-body-small-size, 12px);
    cursor: pointer;
    user-select: none;
  }

  .avatar-url-summary:hover {
    text-decoration: underline;
  }

  .pseud-icon-upload {
    display: flex;
    gap: var(--space-3, 12px);
    align-items: flex-start;
    margin-bottom: var(--space-2, 8px);
  }

  .pseud-icon-preview {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--md-sys-color-surface-container-highest);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pseud-icon-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pseud-icon-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
  }

  .pseud-icon-btn {
    cursor: pointer;
    font-size: var(--md-sys-typescale-label-medium-size, 12px);
  }

  .pseud-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    margin-right: var(--space-2, 8px);
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--md-sys-color-primary);
    font-size: var(--md-sys-typescale-label-medium-size, 12px);
    cursor: pointer;
    padding: 0;
    font-family: 'Inter', sans-serif;
  }

  .btn-text:hover {
    text-decoration: underline;
  }

  .btn-text--danger {
    color: var(--md-sys-color-error);
  }

  /* ═══════════════════════════════════════════════════════ */
  /*  Segmented control (font size)                       */
  /* ═══════════════════════════════════════════════════════ */
  .segmented-control {
    display: inline-flex;
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-full, 100px);
    overflow: hidden;
  }

  .seg-btn {
    background: transparent;
    border: none;
    color: var(--md-sys-color-on-surface);
    font-family: 'Inter', sans-serif;
    font-size: var(--md-sys-typescale-label-large-size, 14px);
    padding: var(--space-2, 8px) var(--space-4, 16px);
    cursor: pointer;
    transition: background 200ms, color 200ms;
    border-right: 1px solid var(--md-sys-color-outline);
  }

  .seg-btn:last-child {
    border-right: none;
  }

  .seg-btn:hover {
    background: var(--md-sys-color-surface-container-highest);
  }

  .seg-btn--active {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }

  .seg-btn--active:hover {
