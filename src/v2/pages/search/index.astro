---
export const prerender = false;
export const config = { auth: 'public' };
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

// SSR: read initial search params from URL
const initialQuery = Astro.url.searchParams.get('q') || '';
const initialFandom = Astro.url.searchParams.get('fandom') || '';
const initialCharacter = Astro.url.searchParams.get('character') || '';
const initialRelationship = Astro.url.searchParams.get('relationship') || '';
const initialRating = Astro.url.searchParams.get('rating') || '';
const initialWarning = Astro.url.searchParams.get('warning') || '';
const initialCategory = Astro.url.searchParams.get('category') || '';
const initialComplete = Astro.url.searchParams.get('complete') || '';
const initialSort = Astro.url.searchParams.get('sort') || 'updated';
const initialPage = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);

// SSR data fetch for initial page load
let initialWorks: any[] = [];
let initialTotal = 0;
let errorMsg: string | null = null;

if (initialQuery.trim().length > 0) {
  try {
    const params = new URLSearchParams({
      q: initialQuery,
      sort: initialSort,
      page: String(initialPage),
      limit: '20',
    });
    if (initialFandom) params.set('fandom', initialFandom);
    if (initialCharacter) params.set('character', initialCharacter);
    if (initialRelationship) params.set('relationship', initialRelationship);
    if (initialRating) params.set('rating', initialRating);
    if (initialWarning) params.set('warning', initialWarning);
    if (initialCategory) params.set('category', initialCategory);
    if (initialComplete) params.set('complete', initialComplete);

    const res = await fetch(new URL(`/api/search?${params.toString()}`, Astro.url));
    if (res.ok) {
      const json = await res.json();
      initialWorks = json.data ?? [];
      initialTotal = json.total ?? 0;
    } else {
      errorMsg = 'Search failed. Please try again.';
    }
  } catch {
    errorMsg = 'Network error. Please try again.';
  }
}

const totalPages = Math.max(1, Math.ceil(initialTotal / 20));

// Build a pagination URL preserving all current filter state
function pageUrl(p: number): string {
  const u = new URL(Astro.url);
  u.searchParams.set('page', String(p));
  u.searchParams.set('sort', initialSort);
  if (initialQuery) u.searchParams.set('q', initialQuery);
  if (initialFandom) u.searchParams.set('fandom', initialFandom);
  if (initialCharacter) u.searchParams.set('character', initialCharacter);
  if (initialRelationship) u.searchParams.set('relationship', initialRelationship);
  if (initialRating) u.searchParams.set('rating', initialRating);
  if (initialWarning) u.searchParams.set('warning', initialWarning);
  if (initialCategory) u.searchParams.set('category', initialCategory);
  if (initialComplete) u.searchParams.set('complete', initialComplete);
  return u.pathname + u.search;
}

const ratingOptions = ['General Audiences', 'Teen And Up Audiences', 'Mature', 'Explicit', 'Not Rated'];
const warningOptions = ['No Archive Warnings Apply', 'Graphic Depictions Of Violence', 'Major Character Death', 'Rape/Non-Con', 'Underage'];
const categoryOptions = ['F/F', 'F/M', 'Gen', 'M/M', 'Multi', 'Other'];
const sortOptions = [
  { value: 'updated', label: 'Recently Updated' },
  { value: 'published', label: 'Recently Published' },
  { value: 'words', label: 'Word Count' },
  { value: 'kudos', label: 'Most Kudos' },
];

// Serialize for client-side hydration
const ssrState = JSON.stringify({
  query: initialQuery,
  fandom: initialFandom,
  character: initialCharacter,
  relationship: initialRelationship,
  rating: initialRating,
  warning: initialWarning,
  category: initialCategory,
  complete: initialComplete,
  sort: initialSort,
  page: initialPage,
  total: initialTotal,
});
---

<Base title={initialQuery ? `Search: ${initialQuery} — fanfiction.fyi` : 'Search — fanfiction.fyi'}>
  <section class="search-page">
    <!-- ── Search Input ──────────────────────────────────── -->
    <div class="search-bar">
      <div class="search-input-wrapper" id="search-wrapper">
        <svg class="search-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input
          type="text"
          id="search-input"
          class="search-input"
          placeholder="Search works by title, summary…"
          value={initialQuery}
          autocomplete="off"
          aria-label="Search works"
        />
        <button type="button" id="clear-btn" class="clear-btn" aria-label="Clear search" style={initialQuery ? '' : 'display:none'}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>

    <!-- ── Filter Chips ──────────────────────────────────── -->
    <div class="filter-chips-container">
      <!-- Sort -->
      <div class="filter-row">
        <span class="filter-row__label">Sort</span>
        <div class="filter-row__chips" id="sort-chips">
          {sortOptions.map(opt => (
            <button
              type="button"
              class:list={['filter-chip', initialSort === opt.value ? 'filter-chip--active' : '']}
              data-filter="sort"
              data-value={opt.value}
            >
              {opt.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Rating -->
      <div class="filter-row">
        <span class="filter-row__label">Rating</span>
        <div class="filter-row__chips" id="rating-chips">
          {ratingOptions.map(opt => (
            <button
              type="button"
              class:list={['filter-chip', initialRating === opt ? 'filter-chip--active' : '']}
              data-filter="rating"
              data-value={opt}
            >
              {opt}
            </button>
          ))}
        </div>
      </div>

      <!-- Warnings -->
      <div class="filter-row">
        <span class="filter-row__label">Warnings</span>
        <div class="filter-row__chips" id="warning-chips">
          {warningOptions.map(opt => (
            <button
              type="button"
              class:list={['filter-chip', initialWarning === opt ? 'filter-chip--active' : '']}
              data-filter="warning"
              data-value={opt}
            >
              {opt === 'No Archive Warnings Apply' ? 'None' : opt}
            </button>
          ))}
        </div>
      </div>

      <!-- Category -->
      <div class="filter-row">
        <span class="filter-row__label">Category</span>
        <div class="filter-row__chips" id="category-chips">
          {categoryOptions.map(opt => (
            <button
              type="button"
              class:list={['filter-chip', initialCategory === opt ? 'filter-chip--active' : '']}
              data-filter="category"
              data-value={opt}
            >
              {opt}
            </button>
          ))}
        </div>
      </div>

      <!-- Complete toggle -->
      <div class="filter-row">
        <span class="filter-row__label">Status</span>
        <div class="filter-row__chips" id="complete-chips">
          <button
            type="button"
            class:list={['filter-chip', initialComplete === '' ? 'filter-chip--active' : '']}
            data-filter="complete"
            data-value=""
          >
            All
          </button>
          <button
            type="button"
            class:list={['filter-chip', initialComplete === 'true' ? 'filter-chip--active' : '']}
            data-filter="complete"
            data-value="true"
          >
            Complete Only
          </button>
          <button
            type="button"
            class:list={['filter-chip', initialComplete === 'false' ? 'filter-chip--active' : '']}
            data-filter="complete"
            data-value="false"
          >
            WIP Only
          </button>
        </div>
      </div>

      <!-- Fandom & Character typed filters -->
      <div class="filter-row">
        <span class="filter-row__label">Fandom</span>
        <div class="filter-row__chips">
          <input
            type="text"
            id="fandom-input"
            class="filter-input"
            placeholder="e.g. Harry Potter"
            value={initialFandom}
            aria-label="Filter by fandom"
          />
        </div>
      </div>

      <div class="filter-row">
        <span class="filter-row__label">Character</span>
        <div class="filter-row__chips">
          <input
            type="text"
            id="character-input"
            class="filter-input"
            placeholder="e.g. Hermione Granger"
            value={initialCharacter}
            aria-label="Filter by character"
          />
        </div>
      </div>

      <div class="filter-row">
        <span class="filter-row__label">Relationship</span>
        <div class="filter-row__chips">
          <input
            type="text"
            id="relationship-input"
            class="filter-input"
            placeholder="e.g. Draco Malfoy/Harry Potter"
            value={initialRelationship}
            aria-label="Filter by relationship"
          />
        </div>
      </div>
    </div>

    <!-- ── Results ─────────────────────────────────────────── -->
    <div id="results-area">
      {errorMsg && <p class="error-msg">{errorMsg}</p>}

      {!errorMsg && initialQuery.trim().length === 0 && (
        <p class="placeholder-text">Type a query to start searching.</p>
      )}

      {!errorMsg && initialQuery.trim().length > 0 && initialWorks.length === 0 && (
        <p class="no-results">No works found for "<span class="query-highlight">{initialQuery}</span>"</p>
      )}

      {!errorMsg && initialWorks.length > 0 && (
        <>
          <p class="results-meta" id="results-meta">
            {initialTotal} {initialTotal === 1 ? 'work' : 'works'} found
          </p>
          <div class="works-grid" id="works-grid">
            {initialWorks.map((w: any) => (
              <WorkCard work={w} />
            ))}
          </div>
        </>
      )}
    </div>

    <!-- ── Loading skeleton (hidden by default) ──────────── -->
    <div id="loading-skeleton" class="loading-skeleton" style="display:none">
      <div class="skeleton-card"></div>
      <div class="skeleton-card"></div>
      <div class="skeleton-card"></div>
      <div class="skeleton-card"></div>
      <div class="skeleton-card"></div>
      <div class="skeleton-card"></div>
    </div>

    <!-- ── Pagination ─────────────────────────────────────── -->
    {initialTotal > 0 && totalPages > 1 && (
      <nav class="pagination" id="pagination" aria-label="Search results pagination">
        {initialPage > 1 && (
          <a href={pageUrl(initialPage - 1)} class="page-link" rel="prev" id="prev-link">← Prev</a>
        )}
        <span class="page-info" id="page-info">Page {initialPage} of {totalPages}</span>
        {initialPage < totalPages && (
          <a href={pageUrl(initialPage + 1)} class="page-link" rel="next" id="next-link">Next →</a>
        )}
      </nav>
    )}
  </section>
</Base>

<script define:vars={{ ssrState, totalPages }}>
  // ─── State ─────────────────────────────────────────────────────
  const state = {
    query: ssrState.query,
    fandom: ssrState.fandom,
    character: ssrState.character,
    relationship: ssrState.relationship,
    rating: ssrState.rating,
    warning: ssrState.warning,
    category: ssrState.category,
    complete: ssrState.complete,
    sort: ssrState.sort,
    page: ssrState.page,
    total: ssrState.total,
    loading: false,
  };

  let debounceTimer = null;

  // ─── DOM refs ───────────────────────────────────────────────────
  const searchInput = document.getElementById('search-input');
  const clearBtn = document.getElementById('clear-btn');
  const resultsArea = document.getElementById('results-area');
  const loadingSkeleton = document.getElementById('loading-skeleton');
  const resultsMeta = document.getElementById('results-meta');
  const worksGrid = document.getElementById('works-grid');
  const pagination = document.getElementById('pagination');
  const pageInfo = document.getElementById('page-info');
  const prevLink = document.getElementById('prev-link');
  const nextLink = document.getElementById('next-link');
  const fandomInput = document.getElementById('fandom-input');
  const characterInput = document.getElementById('character-input');
  const relationshipInput = document.getElementById('relationship-input');

  // ─── Chip click handlers ────────────────────────────────────────
  document.querySelectorAll('.filter-chip[data-filter]').forEach(chip => {
    chip.addEventListener('click', () => {
      const filterType = chip.dataset.filter;
      const value = chip.dataset.value;

      // For chips in the same filter group, toggle: clicking active deactivates,
      // clicking inactive activates (and deactivates siblings)
      const siblings = chip.parentElement.querySelectorAll(`.filter-chip[data-filter="${filterType}"]`);
      const isActive = chip.classList.contains('filter-chip--active');

      if (filterType === 'complete') {
        // Complete is a single-select radio
        siblings.forEach(s => s.classList.remove('filter-chip--active'));
        chip.classList.add('filter-chip--active');
        state.complete = value;
      } else if (filterType === 'sort') {
        // Sort is single-select
        siblings.forEach(s => s.classList.remove('filter-chip--active'));
        chip.classList.add('filter-chip--active');
        state.sort = value;
      } else {
        // Rating, warning, category: toggleable single-select
        if (isActive) {
          chip.classList.remove('filter-chip--active');
          state[filterType] = '';
        } else {
          siblings.forEach(s => s.classList.remove('filter-chip--active'));
          chip.classList.add('filter-chip--active');
          state[filterType] = value;
        }
      }

      state.page = 1;
      fetchResults();
    });
  });

  // ─── Text filter inputs ─────────────────────────────────────────
  function setupTextFilter(input, field) {
    if (!input) return;
    input.addEventListener('input', () => {
      state[field] = input.value.trim();
      state.page = 1;
      debouncedFetch();
    });
  }
  setupTextFilter(fandomInput, 'fandom');
  setupTextFilter(characterInput, 'character');
  setupTextFilter(relationshipInput, 'relationship');

  // ─── Search input ───────────────────────────────────────────────
  searchInput.addEventListener('input', () => {
    state.query = searchInput.value;
    state.page = 1;
    clearBtn.style.display = state.query ? '' : 'none';
    debouncedFetch();
  });

  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    state.query = '';
    state.page = 1;
    clearBtn.style.display = 'none';
    fetchResults();
  });

  // ─── Debounce ───────────────────────────────────────────────────
  function debouncedFetch() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(fetchResults, 350);
  }

  // ─── Fetch results ──────────────────────────────────────────────
  async function fetchResults() {
    if (state.query.trim().length === 0) {
      resultsArea.innerHTML = '<p class="placeholder-text">Type a query to start searching.</p>';
      if (loadingSkeleton) loadingSkeleton.style.display = 'none';
      if (pagination) pagination.style.display = 'none';
      updateURL();
      return;
    }

    // Show skeleton
    if (loadingSkeleton) loadingSkeleton.style.display = '';
    resultsArea.innerHTML = '';
    state.loading = true;

    const params = new URLSearchParams({
      q: state.query,
      sort: state.sort,
      page: String(state.page),
      limit: '20',
    });
    if (state.fandom) params.set('fandom', state.fandom);
    if (state.character) params.set('character', state.character);
    if (state.relationship) params.set('relationship', state.relationship);
    if (state.rating) params.set('rating', state.rating);
    if (state.warning) params.set('warning', state.warning);
    if (state.category) params.set('category', state.category);
    if (state.complete) params.set('complete', state.complete);

    try {
      const res = await fetch(`/api/search?${params.toString()}`);
      if (!res.ok) throw new Error('Search failed');
      const json = await res.json();

      state.total = json.total ?? 0;
      const tp = Math.max(1, Math.ceil(state.total / 20));
      const works = json.data ?? [];

      if (loadingSkeleton) loadingSkeleton.style.display = 'none';
      state.loading = false;

      if (works.length === 0) {
        resultsArea.innerHTML = `<p class="no-results">No works found for "<span class="query-highlight">${escapeHTML(state.query)}</span>"</p>`;
        if (pagination) pagination.style.display = 'none';
      } else {
        resultsArea.innerHTML = `
          <p class="results-meta" id="results-meta">${state.total} ${state.total === 1 ? 'work' : 'works'} found</p>
          <div class="works-grid" id="works-grid">
            ${works.map(w => renderWorkCard(w)).join('')}
          </div>
        `;

        if (pagination) {
          pagination.style.display = '';
          if (pageInfo) pageInfo.textContent = `Page ${state.page} of ${tp}`;
          if (prevLink) { prevLink.href = pageUrlJS(state.page - 1); prevLink.style.display = state.page > 1 ? '' : 'none'; }
          if (nextLink) { nextLink.href = pageUrlJS(state.page + 1); nextLink.style.display = state.page < tp ? '' : 'none'; }
        }
      }

      updateURL();
    } catch (err) {
      if (loadingSkeleton) loadingSkeleton.style.display = 'none';
      state.loading = false;
      resultsArea.innerHTML = '<p class="error-msg">Search failed. Please try again.</p>';
      if (pagination) pagination.style.display = 'none';
    }
  }

  // ─── Render work card (HTML string) ─────────────────────────────
  function renderWorkCard(w) {
    const authorNames = (w.authors || []).map(a => a.name).join(', ');
    const fandoms = (w.tags || []).filter(t => t.type === 'fandom');
    const summary = w.summary
      ? (w.summary.length > 200 ? w.summary.slice(0, 200) + '…' : w.summary)
      : '';
    const words = (w.wordCount || 0).toLocaleString();
    const statusLabel = w.complete ? 'Complete' : 'WIP';
    const date = new Date(w.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    const chapters = w.chapterCount != null ? `<span>${w.chapterCount} ${w.chapterCount === 1 ? 'chapter' : 'chapters'}</span>` : '';
    const kudosDisplay = w.kudosCount > 0 ? `<span>❤ ${w.kudosCount}</span>` : '';

    const fandomPills = fandoms.slice(0, 3).map(t => `<span class="fandom-pill">${escapeHTML(t.name)}</span>`).join('');
    const moreFandoms = fandoms.length > 3 ? `<span class="fandom-pill fandom-more">+${fandoms.length - 3}</span>` : '';

    return `
      <a href="/works/${w.id}" class="work-card">
        <div class="work-card-header">
          <h3 class="work-card-title">${escapeHTML(w.title)}</h3>
          <span class="work-card-status" data-complete="${w.complete}">${statusLabel}</span>
        </div>
        <p class="work-card-author">by ${escapeHTML(authorNames)}</p>
        ${summary ? `<p class="work-card-summary">${escapeHTML(summary)}</p>` : ''}
        ${fandoms.length > 0 ? `<div class="work-card-fandoms">${fandomPills}${moreFandoms}</div>` : ''}
        <div class="work-card-meta">
          <span>${words} words</span>
          ${chapters}
          ${kudosDisplay}
          <span>Updated ${date}</span>
        </div>
      </a>
    `;
  }

  // ─── Pagination links ──────────────────────────────────────────
  function pageUrlJS(p) {
    const u = new URL(window.location.href);
    u.searchParams.set('q', state.query);
    u.searchParams.set('page', String(p));
    u.searchParams.set('sort', state.sort);
    if (state.fandom) u.searchParams.set('fandom', state.fandom);
    if (state.character) u.searchParams.set('character', state.character);
    if (state.relationship) u.searchParams.set('relationship', state.relationship);
    if (state.rating) u.searchParams.set('rating', state.rating);
    if (state.warning) u.searchParams.set('warning', state.warning);
    if (state.category) u.searchParams.set('category', state.category);
    if (state.complete) u.searchParams.set('complete', state.complete);
    return u.pathname + u.search;
  }

  function updateURL() {
    const u = new URL(window.location.href);
    u.searchParams.set('q', state.query);
    u.searchParams.set('page', String(state.page));
    u.searchParams.set('sort', state.sort);
    if (state.fandom) u.searchParams.set('fandom', state.fandom); else u.searchParams.delete('fandom');
    if (state.character) u.searchParams.set('character', state.character); else u.searchParams.delete('character');
    if (state.relationship) u.searchParams.set('relationship', state.relationship); else u.searchParams.delete('relationship');
    if (state.rating) u.searchParams.set('rating', state.rating); else u.searchParams.delete('rating');
    if (state.warning) u.searchParams.set('warning', state.warning); else u.searchParams.delete('warning');
    if (state.category) u.searchParams.set('category', state.category); else u.searchParams.delete('category');
    if (state.complete) u.searchParams.set('complete', state.complete); else u.searchParams.delete('complete');
    window.history.replaceState({}, '', u.toString());
  }

  function escapeHTML(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // ─── Pagination click handlers ──────────────────────────────────
  if (prevLink) {
    prevLink.addEventListener('click', (e) => {
      e.preventDefault();
      state.page = Math.max(1, state.page - 1);
      fetchResults();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
  if (nextLink) {
    nextLink.addEventListener('click', (e) => {
      e.preventDefault();
      state.page++;
      fetchResults();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<style is:global>
  .search-page {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  /* ── Search Bar ── */
  .search-bar {
    margin-bottom: var(--space-6);
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-6);
    transition: border-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
                box-shadow var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .search-input-wrapper:focus-within {
    border-color: var(--md-sys-color-primary);
    box-shadow: 0 0 0 1px var(--md-sys-color-primary);
  }

  .search-icon {
    color: var(--md-sys-color-on-surface-variant);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    font: var(--md-sys-typescale-headline-medium);
    font-size: 1.25rem;
    color: var(--md-sys-color-on-surface);
    background: transparent;
    border: none;
    outline: none;
    min-width: 0;
  }
  .search-input::placeholder {
    color: var(--md-sys-color-outline);
    font-weight: 400;
  }

  .clear-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--md-sys-color-on-surface-variant);
    padding: var(--space-1);
    border-radius: var(--md-sys-shape-corner-full);
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .clear-btn:hover {
    background: var(--md-sys-color-surface-container-highest);
  }

  /* ── Filter Chips ── */
  .filter-chips-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .filter-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .filter-row__label {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
    min-width: 80px;
    flex-shrink: 0;
  }

  .filter-row__chips {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 2px;
  }
  .filter-row__chips::-webkit-scrollbar { display: none; }

