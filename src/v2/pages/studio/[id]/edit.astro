---
/**
 * Studio: Edit Work — Edit title, summary, pseud, tags, draft/complete status.
 * Auth: required (enforced by middleware default).
 */
export const prerender = false;
import Base from '../../../layouts/Base.astro';

const workId = Number(Astro.params.id);
if (!workId || Number.isNaN(workId)) {
  return Astro.redirect('/studio');
}

// Fetch the work
let work: any = null;
let chapters: any[] = [];
let pseuds: any[] = [];
let errorMsg: string | null = null;

try {
  const [workRes, chaptersRes, pseudsRes] = await Promise.all([
    fetch(new URL(`/api/works/${workId}`, Astro.url), {
      headers: { cookie: Astro.request.headers.get('cookie') || '' },
    }),
    fetch(new URL(`/api/works/${workId}/chapters`, Astro.url), {
      headers: { cookie: Astro.request.headers.get('cookie') || '' },
    }),
    fetch(new URL(`/api/pseuds?limit=100&userId=${Astro.locals.user.id}`, Astro.url), {
      headers: { cookie: Astro.request.headers.get('cookie') || '' },
    }),
  ]);

  if (workRes.ok) {
    work = (await workRes.json()).data;
  } else {
    return Astro.redirect('/studio');
  }

  if (chaptersRes.ok) {
    chapters = (await chaptersRes.json()).data ?? [];
  }

  if (pseudsRes.ok) {
    pseuds = (await pseudsRes.json()).data ?? [];
  }
} catch {
  errorMsg = 'Failed to load work data.';
}

if (!work && !errorMsg) {
  return Astro.redirect('/studio');
}

// Organize tags by type
const tagGroups: Record<string, any[]> = {};
for (const t of work?.tags ?? []) {
  if (!tagGroups[t.type]) tagGroups[t.type] = [];
  tagGroups[t.type].push(t);
}

const isDraft = work?.draft;
const isComplete = work?.complete;
---

<Base title={`Edit: ${work?.title ?? 'Work'} — fanfiction.fyi`} description="Edit your work">
  <section class="studio-page">
    <div class="studio-header">
      <a href="/studio" class="back-link">← Back to My Works</a>
      <h1 class="studio-title">Edit Work</h1>
    </div>

    {errorMsg && <p class="error-msg">{errorMsg}</p>}

    {work && (
      <form id="edit-work-form" class="work-form">
        <div class="form-field">
          <label for="title">Title</label>
          <input type="text" id="title" name="title" required maxlength="500" value={work.title} />
        </div>

        <div class="form-field">
          <label for="summary">Summary</label>
          <textarea id="summary" name="summary" rows="4" maxlength="2000">{work.summary ?? ''}</textarea>
        </div>

        <div class="form-field">
          <label for="pseudId">Post As</label>
          <select id="pseudId" name="pseudId">
            {pseuds.map((p: any) => (
              <option value={p.id} selected={work.authors?.some((a: any) => a.pseudId === p.id)}>
                {p.name}
              </option>
            ))}
          </select>
        </div>

        <div class="form-field">
          <label>Tags</label>
          <div class="tags-input-wrapper">
            <div id="tags-container" class="tags-container">
              {work.tags?.map((t: any) => (
                <span class="tag-pill" data-id={t.id} data-name={t.name} data-type={t.type}>
                  <span class="tag-pill-label">{t.name}</span>
                  <span class="tag-pill-type">{t.type}</span>
                  <button type="button" class="tag-pill-remove">×</button>
                </span>
              ))}
            </div>
            <input type="text" id="tags-input" placeholder="Start typing to add tags..." />
            <div id="tags-suggestions" class="suggestions-dropdown" style="display:none;"></div>
          </div>
          <input type="hidden" id="tags-json" name="tags" value={JSON.stringify(work.tags ?? [])} />
          <p class="field-hint">Press Enter or comma to add a tag. Click × to remove.</p>
        </div>

        <!-- Status toggles -->
        <div class="form-row">
          <label class="toggle-label">
            <input type="checkbox" id="draft-toggle" checked={isDraft} />
            <span>Keep as Draft</span>
          </label>
          <label class="toggle-label">
            <input type="checkbox" id="complete-toggle" checked={isComplete} />
            <span>Mark as Complete</span>
          </label>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-filled" id="submit-btn">
            <span class="btn-text">Save Changes</span>
            <span class="btn-loading" style="display:none;">Saving...</span>
          </button>
          <a href="/studio" class="btn-outlined">Cancel</a>
          <button type="button" id="delete-btn" class="btn-danger-outline">Delete Work</button>
        </div>

        <div id="form-error" class="form-error" role="alert"></div>
      </form>
    )}

    <!-- Chapters list -->
    {work && (
      <div class="chapters-section">
        <div class="chapters-header">
          <h2 class="section-heading">Chapters <span class="count-badge">{chapters.length}</span></h2>
          <a href={`/studio/${workId}/chapters/new`} class="btn-outlined btn-sm">+ Add Chapter</a>
        </div>

        {chapters.length === 0 ? (
          <p class="empty-msg">No chapters yet. Add your first chapter!</p>
        ) : (
          <ol class="chapter-list">
            {chapters.map((c: any, i: number) => (
              <li class="chapter-item">
                <div class="chapter-item-info">
                  <span class="chapter-num">{i + 1}.</span>
                  <a href={`/studio/${workId}/chapters/${c.id}/edit`} class="chapter-title">{c.title || `Chapter ${c.position}`}</a>
                  {c.draft && <span class="draft-badge">Draft</span>}
                </div>
                <span class="chapter-meta">{c.wordCount?.toLocaleString() ?? 0} words</span>
              </li>
            ))}
          </ol>
        )}
      </div>
    )}

    <!-- Delete confirmation dialog -->
    <dialog id="delete-dialog" class="delete-dialog">
      <form method="dialog">
        <h3>Delete this work?</h3>
        <p>This will set the work back to draft status. It won't be permanently deleted.</p>
        <div class="dialog-actions">
          <button type="submit" class="btn-outlined" value="cancel">Cancel</button>
          <button type="submit" class="btn-danger-filled" id="confirm-delete-btn" value="confirm">Delete</button>
        </div>
      </form>
    </dialog>
  </section>
</Base>

<script define:vars={{ workId, isDraft, isComplete }}>
  // ─── Tag handling ──────────────────────────────────────────────────
  const tagsContainer = document.getElementById('tags-container') as HTMLDivElement;
  const tagsInput = document.getElementById('tags-input') as HTMLInputElement;
  const tagsJson = document.getElementById('tags-json') as HTMLInputElement;
  const suggestions = document.getElementById('tags-suggestions') as HTMLDivElement;

  function getSelectedTags() {
    try { return JSON.parse(tagsJson.value); } catch { return []; }
  }

  function setSelectedTags(tags: any[]) {
    tagsJson.value = JSON.stringify(tags);
    renderTags(tags);
  }

  function renderTags(tags: any[]) {
    tagsContainer.innerHTML = '';
    tags.forEach((tag, idx) => {
      const pill = document.createElement('span');
      pill.className = 'tag-pill';
      pill.dataset.id = tag.id ?? '';
      pill.dataset.name = tag.name;
      pill.dataset.type = tag.type;
      pill.innerHTML = `<span class="tag-pill-label">${tag.name}</span><span class="tag-pill-type">${tag.type}</span><button type="button" class="tag-pill-remove" data-idx="${idx}">×</button>`;
      tagsContainer.appendChild(pill);
    });

    tagsContainer.querySelectorAll('.tag-pill-remove').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-idx'));
        const current = getSelectedTags();
        current.splice(idx, 1);
        setSelectedTags(current);
      });
    });
  }

  // Initialize from server-rendered tags
  renderTags(getSelectedTags());

  let debounceTimer: ReturnType<typeof setTimeout>;
  tagsInput.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    const q = tagsInput.value.trim();
    if (q.length < 2) { suggestions.style.display = 'none'; return; }

    debounceTimer = setTimeout(async () => {
      try {
        const res = await fetch(`/api/tags?q=${encodeURIComponent(q)}&limit=10`);
        if (res.ok) {
          const json = await res.json();
          const items = json.data ?? [];
          if (items.length === 0) { suggestions.style.display = 'none'; return; }

          suggestions.innerHTML = items.map((t: any) =>
            `<div class="suggestion-item" data-id="${t.id}" data-name="${t.name}" data-type="${t.type}">
              <span class="suggestion-name">${t.name}</span>
              <span class="suggestion-type">${t.type}</span>
            </div>`
          ).join('');
          suggestions.style.display = 'block';

          suggestions.querySelectorAll('.suggestion-item').forEach(el => {
            el.addEventListener('click', () => {
              const id = Number(el.dataset.id);
              const name = el.dataset.name!;
              const type = el.dataset.type!;
              const current = getSelectedTags();
              if (!current.some((t: any) => t.id === id)) {
                current.push({ id, name, type });
                setSelectedTags(current);
              }
              tagsInput.value = '';
              suggestions.style.display = 'none';
            });
          });
        }
      } catch { /* non-fatal */ }
    }, 300);
  });

  tagsInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ',') {
      e.preventDefault();
      const name = tagsInput.value.trim().replace(/,+$/, '');
      if (name && !getSelectedTags().some((t: any) => t.name === name)) {
        const current = getSelectedTags();
        current.push({ name, type: 'freeform' });
        setSelectedTags(current);
      }
      tagsInput.value = '';
      suggestions.style.display = 'none';
    }
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.tags-input-wrapper')) {
      suggestions.style.display = 'none';
    }
  });

  // ─── Form submission ──────────────────────────────────────────────
  const form = document.getElementById('edit-work-form') as HTMLFormElement;
  const errorEl = document.getElementById('form-error') as HTMLElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.textContent = '';
    submitBtn.disabled = true;
    (submitBtn.querySelector('.btn-text') as HTMLElement).style.display = 'none';
    (submitBtn.querySelector('.btn-loading') as HTMLElement).style.display = 'inline';

    const title = (document.getElementById('title') as HTMLInputElement).value;
    const summary = (document.getElementById('summary') as HTMLTextAreaElement).value || null;
    const pseudId = Number((document.getElementById('pseudId') as HTMLSelectElement).value);
    const tags = getSelectedTags();
    const draft = (document.getElementById('draft-toggle') as HTMLInputElement).checked;
    const complete = (document.getElementById('complete-toggle') as HTMLInputElement).checked;

    try {
      const res = await fetch(`/api/works/${workId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, summary, pseudId, tags, draft, complete }),
      });

      const data = await res.json();
      if (!res.ok) {
        errorEl.textContent = data.error || data.fields?.map((f: any) => `${f.field}: ${f.message}`).join(', ') || 'Failed to update work.';
        submitBtn.disabled = false;
        (submitBtn.querySelector('.btn-text') as HTMLElement).style.display = 'inline';
        (submitBtn.querySelector('.btn-loading') as HTMLElement).style.display = 'none';
        return;
      }

      window.location.reload();
    } catch {
      errorEl.textContent = 'Network error. Please try again.';
      submitBtn.disabled = false;
      (submitBtn.querySelector('.btn-text') as HTMLElement).style.display = 'inline';
      (submitBtn.querySelector('.btn-loading') as HTMLElement).style.display = 'none';
    }
  });

  // ─── Delete work ──────────────────────────────────────────────────
  const deleteBtn = document.getElementById('delete-btn') as HTMLButtonElement;
  const deleteDialog = document.getElementById('delete-dialog') as HTMLDialogElement;
  const confirmDeleteBtn = document.getElementById('confirm-delete-btn') as HTMLButtonElement;

  deleteBtn.addEventListener('click', () => deleteDialog.showModal());
  confirmDeleteBtn.addEventListener('click', async () => {
    try {
      const res = await fetch(`/api/works/${workId}`, { method: 'DELETE' });
      if (res.ok) {
        window.location.href = '/studio';
      } else {
        errorEl.textContent = 'Failed to delete work.';
      }
    } catch {
      errorEl.textContent = 'Network error.';
    }
  });
</script>

<style is:global>
  .studio-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .studio-header {
    margin-bottom: var(--space-8);
  }

  .back-link {
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-primary);
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--space-2);
  }

  .studio-title {
    font: var(--md-sys-typescale-headline-medium);
    margin: 0 0 var(--space-4) 0;
  }

  .work-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .form-field label {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
  }
  .form-field input,
  .form-field select,
  .form-field textarea {
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small);
    padding: var(--space-3) var(--space-4);
    outline: none;
    transition: border-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    border-color: var(--md-sys-color-primary);
  }
  .form-field textarea {
    resize: vertical;
    min-height: 100px;
  }

  .field-hint {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-on-surface-variant);
    margin: var(--space-1) 0 0 0;
  }

  .form-row {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .toggle-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
    cursor: pointer;
  }
  .toggle-label input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: var(--md-sys-color-primary);
  }

  /* Tags input */
  .tags-input-wrapper {
    position: relative;
  }
  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
  }
  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    border-radius: var(--md-sys-shape-corner-full);
    padding: 2px 10px;
    font: var(--md-sys-typescale-body-small);
  }
  .tag-pill-type {
    opacity: 0.7;
    font-size: 0.7rem;
  }
  .tag-pill-remove {
    background: none;
    border: none;
    color: var(--md-sys-color-on-primary-container);
    cursor: pointer;
    padding: 0;
    font-size: 1rem;
    line-height: 1;
  }
  .suggestions-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small);
    max-height: 200px;
    overflow-y: auto;
    z-index: 50;
  }
  .suggestion-item {
    display: flex;
    justify-content: space-between;
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    font: var(--md-sys-typescale-body-medium);
  }
  .suggestion-item:hover {
    background: var(--md-sys-color-surface-container-high);
  }
  .suggestion-name { color: var(--md-sys-color-on-surface); }
  .suggestion-type { color: var(--md-sys-color-on-surface-variant); font-size: 0.8rem; }

  /* Actions */
  .form-actions {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-filled {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-primary);
    background: var(--md-sys-color-primary);
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-8);
    cursor: pointer;
    transition: opacity var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-filled:hover { opacity: 0.88; }
  .btn-filled:disabled { opacity: 0.5; cursor: not-allowed; }

  .btn-outlined {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-primary);
    background: transparent;
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-8);
    text-decoration: none;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-outlined:hover { background: var(--md-sys-color-primary-container); }
  .btn-sm {
    padding: var(--space-2) var(--space-4);
    font-size: 0.85rem;
  }

  .btn-danger-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-error);
    background: transparent;
    border: 1px solid var(--md-sys-color-error);
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-8);
    cursor: pointer;
    margin-left: auto;
    transition: background var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-danger-outline:hover { background: #fce4ec; }

  .btn-danger-filled {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-error);
    background: var(--md-sys-color-error);
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-6);
    cursor: pointer;
  }
  .btn-danger-filled:hover { opacity: 0.9; }

  .form-error {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-error);
    min-height: 1.2em;
  }

  /* Chapters section */
  .chapters-section {
    margin-top: var(--space-12);
  }

  .chapters-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .section-heading {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .count-badge {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    border-radius: var(--md-sys-shape-corner-full);
    padding: 2px 8px;
    font-size: 0.75rem;
  }

  .chapter-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .chapter-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
  }
  .chapter-item:last-child { border-bottom: none; }

  .chapter-item-info {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .chapter-num {
    color: var(--md-sys-color-on-surface-variant);
    font: var(--md-sys-typescale-body-medium);
  }

  .chapter-title {
    font: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-primary);
    text-decoration: none;
  }
  .chapter-title:hover { text-decoration: underline; }

  .draft-badge {
    background: var(--md-sys-color-surface-container-highest);
    color: var(--md-sys-color-on-surface-variant);
    border-radius: var(--md-sys-shape-corner-full);
    padding: 2px 8px;
    font: var(--md-sys-typescale-body-small);
  }

  .chapter-meta {
    font: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-on-surface-variant);
  }

  .empty-msg {
    color: var(--md-sys-color-on-surface-variant);
    font: var(--md-sys-typescale-body-large);
  }

  .error-msg {
    color: var(--md-sys-color-error);
    font: var(--md-sys-typescale-body-large);
  }

  /* Delete dialog */
  .delete-dialog {
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    padding: var(--space-6);
    background: var(--md-sys-color-surface);
    max-width: 400px;
  }
  .delete-dialog h3 {
    font: var(--md-sys-typescale-title-large);
    margin: 0 0 var(--space-4) 0;
  }
  .delete-dialog p {
    font: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
    margin: 0 0 var(--space-6) 0;
  }
  .dialog-actions {
    display: flex;
    gap: var(--space-4);
    justify-content: flex-end;
  }
</style>