---
/**
 * Studio Dashboard — Lists the logged-in user's works, grouped by drafts and published.
 * Auth: required (enforced by middleware default).
 */
export const prerender = false;
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

const user = Astro.locals.user;

// Fetch the user's pseuds to find their work IDs
let drafts: any[] = [];
let published: any[] = [];
let errorMsg: string | null = null;

try {
  // Fetch the user's works (including drafts) via internal API
  const res = await fetch(new URL('/api/works?mine=true&limit=100', Astro.url), {
    headers: { cookie: Astro.request.headers.get('cookie') || '' },
  });
  if (res.ok) {
    const json = await res.json();
    const allWorks = json.data ?? [];
    drafts = allWorks.filter((w: any) => w.draft);
    published = allWorks.filter((w: any) => !w.draft);
  } else {
    errorMsg = 'Failed to load your works.';
  }
} catch {
  errorMsg = 'Network error loading your works.';
}
---

<Base title="My Works — fanfiction.fyi" description="Manage your works on fanfiction.fyi">
  <section class="studio-page">
    <div class="studio-header">
      <h1 class="studio-title">My Works</h1>
      <a href="/studio/new" class="btn-filled">+ New Work</a>
    </div>

    {errorMsg && <p class="error-msg">{errorMsg}</p>}

    <!-- Drafts section -->
    <div class="studio-section">
      <h2 class="section-heading">Drafts {drafts.length > 0 && <span class="count-badge">{drafts.length}</span>}</h2>
      {drafts.length === 0 ? (
        <p class="empty-msg">No drafts. Start writing something new!</p>
      ) : (
        <div class="works-grid">
          {drafts.map((w: any) => (
            <WorkCard work={w} />
          ))}
        </div>
      )}
    </div>

    <!-- Published section -->
    <div class="studio-section">
      <h2 class="section-heading">Published {published.length > 0 && <span class="count-badge">{published.length}</span>}</h2>
      {published.length === 0 ? (
        <p class="empty-msg">No published works yet.</p>
      ) : (
        <div class="works-grid">
          {published.map((w: any) => (
            <WorkCard work={w} />
          ))}
        </div>
      )}
    </div>
  </section>
</Base>

<style is:global>
  .studio-page {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .studio-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .studio-title {
    font: var(--md-sys-typescale-headline-medium);
    margin: 0;
  }

  .btn-filled {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-primary);
    background: var(--md-sys-color-primary);
    border-radius: var(--md-sys-shape-corner-full);
    padding: var(--space-3) var(--space-8);
    text-decoration: none;
    transition: opacity var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }
  .btn-filled:hover { opacity: 0.88; }

  .studio-section {
    margin-bottom: var(--space-8);
  }

  .section-heading {
    font: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
    margin: 0 0 var(--space-4) 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .count-badge {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    border-radius: var(--md-sys-shape-corner-full);
    padding: 2px 8px;
    font-size: 0.75rem;
  }

  .works-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .works-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .empty-msg {
    color: var(--md-sys-color-on-surface-variant);
    font: var(--md-sys-typescale-body-large);
  }

  .error-msg {
    color: var(--md-sys-color-error);
    font: var(--md-sys-typescale-body-large);
  }
</style>