{
  "name": "fanfiction-fyi",
  "version": "0.1.0",
  "description": "Bespoke small-scale fanfiction archive — AO3-inspired, M3 design, Cloudflare Pages + D1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
